  function makeSvg(def) {
    if (!def || !def.art) return null;
    const rows = def.art.filter(r => r.length === SIZE);
    if (rows.length !== SIZE) return null;
    let rects = '';
    for (let y = 0; y < SIZE; y++) {
      for (let x = 0; x < SIZE; x++) {
        const c = rows[y][x];
        if (c === '_' || c === ' ') continue;
        const idx = c >= '0' && c <= '9' ? +c : c.charCodeAt(0) - 87;
        const fill = def.pal[idx];
        if (!fill) continue;
        rects += `<rect x="${x}" y="${y}" width="1" height="1" fill="${fill}"/>`;
      }
    }
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${SIZE} ${SIZE}" shape-rendering="crispEdges">${rects}</svg>`;
    return `url("data:image/svg+xml;utf8,${encodeURIComponent(svg)}")`;
  }

  const ALIASES = { grass:'tile-grass', dirt:'tile-dirt', stone:'tile-stone', cobble:'tile-cobble', planks:'tile-planks', sand:'tile-sand', log_side:'tile-log-side', leaves:'tile-leaves', diamond:'tile-diamond', gold:'tile-gold', iron:'tile-iron', coal:'tile-coal', redstone:'tile-redstone', lapis:'tile-lapis', emerald:'tile-emerald', obsidian:'tile-obsidian', netherrack:'tile-netherrack', tnt:'tile-tnt', water:'tile-water', lava:'tile-lava' };
  const MOB_ALIASES = { zombie:'tile-zombie', creeper:'tile-creeper', skeleton:'tile-skeleton', pig:'tile-pig', cow:'tile-cow', sheep:'tile-sheep', spider:'tile-spider', enderman:'tile-enderman', villager:'tile-villager', blaze:'tile-blaze', pillager:'tile-pillager', axolotl:'tile-axolotl' };

  let css = `
    .tile{ image-rendering: pixelated; image-rendering: crisp-edges; background-size: 100% 100% !important; background-repeat: no-repeat !important; }
    .tile::before, .tile::after{ display: none !important; }
    [data-tile-style="voxel"] .tile{ box-shadow: inset 2px 2px 0 rgba(255,255,255,.10), inset -2px -2px 0 rgba(0,0,0,.30), 0 1px 0 rgba(0,0,0,.4) !important; border-radius: 2px !important; }
    [data-tile-style="swatch"] .tile{ box-shadow: inset 0 0 0 1px rgba(0,0,0,.4) !important; border-radius: 4px !important; }
  `;
  for (const [key, cls] of Object.entries(ALIASES)) { const url = makeSvg(ART[key]); if (!url) continue; css += `.${cls}{ background-image: ${url} !important; background-color: transparent !important; }\n`; }
  for (const [key, cls] of Object.entries(MOB_ALIASES)) { const url = makeSvg(MOB_ART[key]); if (!url) continue; css += `.${cls}{ background-image: ${url} !important; background-color: transparent !important; }\n`; }

  const WOOLS = { 'tile-wool-white':'#e8e8e8','tile-wool-red':'#c33b2a','tile-wool-blue':'#3d6cc7','tile-wool-yellow':'#f7c948','tile-wool-green':'#4a8a3a','tile-wool-orange':'#e07a2a','tile-wool-purple':'#7a3a9a','tile-wool-black':'#2a2a2a' };
  for (const [cls, color] of Object.entries(WOOLS)) {
    let rects = '';
    for (let y=0;y<16;y++) for (let x=0;x<16;x++) {
      const noise = ((x*31 + y*17 + (x^y)*3) & 7);
      const f = (noise === 0 || noise === 7) ? color + 'cc' : color;
      rects += `<rect x="${x}" y="${y}" width="1" height="1" fill="${f}"/>`;
    }
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" shape-rendering="crispEdges"><rect width="16" height="16" fill="${color}"/>${rects}</svg>`;
    css += `.${cls}{ background-image: url("data:image/svg+xml;utf8,${encodeURIComponent(svg)}") !important; background-color: transparent !important; }\n`;
  }

  const style = document.createElement('style');
  style.id = 'pixel-tile-overrides';
  style.textContent = css;
  document.head.appendChild(style);
})();
