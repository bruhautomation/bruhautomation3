const { useState: useState_x } = React;

function SchemaField({ p, value, onChange }) {
  switch (p.type) {
    case 'target': return <SelectorBuilder value={value} onChange={onChange} />;
    case 'coords': return <CoordPicker value={value || ['~','~','~']} onChange={onChange} />;
    case 'block':  return <ItemSlot kind="block" value={value} onChange={onChange} placeholder="Pick a block…" />;
    case 'item':   return <ItemSlot kind="item" value={value} onChange={onChange} placeholder="Pick an item…" />;
    case 'mob':    return <ItemSlot kind="mob" value={value} onChange={onChange} placeholder="Pick a mob…" />;
    case 'seg':    return <Seg value={value} options={p.options} onChange={onChange} />;
    case 'number': return <Stepper value={value ?? p.default ?? 0} onChange={onChange} min={p.min ?? 0} max={p.max ?? 9999} step={p.step ?? 1} />;
    case 'multiline': return <textarea className="textarea" placeholder={p.placeholder} value={value || ''} onChange={(e) => onChange(e.target.value)} />;
    case 'effect': {
      const [q, setQ] = useState_x('');
      const filtered = EFFECTS.filter(e => e.name.toLowerCase().includes(q.toLowerCase()));
      return (
        <>
          <input className="input" placeholder="Filter effects…" value={q} onChange={(e) => setQ(e.target.value)} style={{ marginBottom: 10 }} />
          <div className="effect-grid">
            {filtered.map(e => (
              <div key={e.id} className={`effect-item ${value === e.id ? 'active' : ''}`} onClick={() => onChange(e.id)}>
                <span className="swatch" style={{ '--c': e.c }} /> {e.name}
              </div>
            ))}
          </div>
        </>
      );
    }
    default:
      return <input className="input" placeholder={p.placeholder || ''} value={value || ''} onChange={(e) => onChange(e.target.value)} />;
  }
}

function SchemaBuilder({ state, set, def }) {
  return (
    <div className="form">
      {def.params.map(p => (
        <Field key={p.id} label={p.label} opt={p.opt} hint={p.hint}>
          <SchemaField p={p} value={state[p.id]} onChange={(v) => set({ [p.id]: v })} />
        </Field>
      ))}
      {def.params.length === 0 && (
        <div style={{ color: 'var(--ink-3)', fontSize: 13, padding: 12, background: 'var(--panel)', borderRadius: 8 }}>This command takes no parameters.</div>
      )}
    </div>
  );
}
SchemaBuilder.defaultsFor = (def) => {
  const d = {};
  def.params.forEach(p => {
    if (p.default !== undefined) d[p.id] = p.default;
    else if (p.type === 'target') d[p.id] = '@p';
    else if (p.type === 'coords') d[p.id] = ['~','~','~'];
    else if (p.type === 'number') d[p.id] = p.min ?? 0;
    else if (p.type === 'seg') d[p.id] = p.options[0]?.v ?? p.options[0];
    else d[p.id] = '';
  });
  return d;
};
SchemaBuilder.buildFor = (s, def) => {
  let parts = [def.name];
  for (const p of def.params) {
    let v = s[p.id];
    if (v === undefined || v === null || v === '') {
      if (p.optional) continue;
      v = p.placeholder || '';
    }
    if (p.type === 'coords') v = v.join(' ');
    if (p.prefix && v) v = p.prefix + v;
    if (p.type === 'item' || p.type === 'block' || p.type === 'mob') v = `minecraft:${v}`;
    if (p.type === 'effect') v = `minecraft:${v}`;
    if (v !== '') parts.push(v);
  }
  return parts.join(' ');
};

