const UNLOCK_PRESETS = [
  { plugin:'EssentialsX', nodes:['essentials.*'] },
  { plugin:'WorldEdit',   nodes:['worldedit.*','fawe.*'] },
  { plugin:'WorldGuard',  nodes:['worldguard.*'] },
  { plugin:'LuckPerms',   nodes:['luckperms.*','group.admin'] },
  { plugin:'Multiverse',  nodes:['multiverse.*'] },
  { plugin:'mcMMO',       nodes:['mcmmo.*'] },
  { plugin:'CoreProtect', nodes:['coreprotect.*'] },
  { plugin:'Vanilla op',  nodes:['minecraft.command.*','bukkit.command.*'] },
];

function UnlockBuilder({ state, set }) {
  const player = state.player || 'Steve';
  const selected = state.plugins || UNLOCK_PRESETS.map(p => p.plugin);
  const togglePlugin = (p) => set({ plugins: selected.includes(p) ? selected.filter(x => x !== p) : [...selected, p] });
  return (
    <div className="form">
      <Field label="Player" opt="who gets the grants — typed exactly as their Minecraft username">
        <input className="input" placeholder="Steve" value={state.player || ''} onChange={(e) => set({ player: e.target.value })} />
      </Field>
      <Field label="Plugins" opt="grants are generated for each selected plugin">
        <div className="chips">
          {UNLOCK_PRESETS.map(p => (
            <button key={p.plugin} className={`chip ${selected.includes(p.plugin) ? 'active' : ''}`} onClick={() => togglePlugin(p.plugin)}>{p.plugin}</button>
          ))}
        </div>
      </Field>
      <div className="where-card">
        <b>How it works:</b> the preview pane below contains <b>every</b> command needed to fully unlock the selected plugins for <code>{player || 'Steve'}</code>. Run them all in order in the BRUH panel <b>Console</b> tab.
      </div>
    </div>
  );
}
UnlockBuilder.defaults = { player: 'Steve', plugins: UNLOCK_PRESETS.map(p => p.plugin) };
UnlockBuilder.build = (s) => {
  const player = s.player || 'Steve';
  const selected = s.plugins || UNLOCK_PRESETS.map(p => p.plugin);
  const lines = [];
  lines.push(`# Unlock everything for ${player}`);
  for (const preset of UNLOCK_PRESETS) {
    if (!selected.includes(preset.plugin)) continue;
    lines.push(`# ── ${preset.plugin} ──`);
    for (const node of preset.nodes) {
      if (node.startsWith('group.')) lines.push(`/lp user ${player} parent add ${node.slice(6)}`);
      else lines.push(`/lp user ${player} permission set ${node} true`);
    }
  }
  lines.push(`/op ${player}`);
  return lines.join('\n');
};

window.EXTRA_COMMANDS = EXTRA_COMMANDS;
window.SchemaBuilder = SchemaBuilder;
window.UnlockBuilder = UnlockBuilder;

if (!window.__cmds_merged) {
  window.COMMANDS = [...window.COMMANDS, ...EXTRA_COMMANDS];
  window.__cmds_merged = true;
  PLUGINS.forEach(p => { p.count = COMMANDS.filter(c => c.plugin === p.id).length; });
}
