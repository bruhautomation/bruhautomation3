  let cmd = def.tmpl;
  Object.keys(s).forEach(k => { cmd = cmd.replace(`{${k}}`, s[k] || ''); });
  return cmd.replace(/\{[^}]+\}/g, '').trim();
};

const BUILDERS = {
  give: GiveBuilder, summon: SummonBuilder, tp: TpBuilder, effect: EffectBuilder,
  weather: WeatherBuilder, time: TimeBuilder, tellraw: TellrawBuilder,
  we_set: WeSetBuilder, we_replace: WeReplaceBuilder,
  gamemode: GamemodeBuilder, kill: KillBuilder, fill: FillBuilder,
};

function getBuilder(cmd) { return BUILDERS[cmd.kind] || null; }
function getDefaults(cmd) {
  const B = getBuilder(cmd);
  if (B) return { ...B.defaults };
  if (cmd.kind === 'simple') return SimpleBuilder.defaultsFor(cmd);
  if (cmd.kind === 'schema' && window.SchemaBuilder) return window.SchemaBuilder.defaultsFor(cmd);
  if (cmd.kind === 'unlock' && window.UnlockBuilder) return { ...window.UnlockBuilder.defaults };
  return {};
}
