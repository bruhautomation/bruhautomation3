    <main>
      <section class="hero">
        <span class="hero-eyebrow"><span class="dot"></span>Click to build · Visual picker · Copy to clipboard</span>
        <h1>Minecraft Command Generator</h1>
        <p>
          Build any console command for your BRUH Minecraft Server. Vanilla Java Edition plus
          every plugin the add-on ships with — a visual block / item / entity picker, rich-text
          builders, and one-click LuckPerms unlocks.
        </p>
        <div class="hero-meta">
          <span><strong>{totalCommands}</strong> commands</span>
          <span><strong>{totalCategories}</strong> plugins</span>
          <span><strong>{totalRegistry}</strong> blocks · items · mobs</span>
          <span><strong>14</strong> plugins covered</span>
        </div>
      </section>

      <section class="tip">
        <div class="tip-inner">
          <div class="tip-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </div>
          <div class="tip-content">
            <strong>Where to run these:</strong>
            paste into the BRUH panel <strong>Console</strong> tab,
            run via RCON (<code>bruh_minecraft.rcon_command</code> service), drop into a command block,
            or type in-game (you must be op — flip <code>allow_cheats: true</code> and add your name to
            <code>initial_ops:</code> in the add-on configuration). Server-only commands like
            <code>/op</code> or <code>/whitelist</code> need to run from the console or RCON, not in-game.
          </div>
        </div>
      </section>

      <section class="layout">
        <aside class="rail" aria-label="Categories">
          <div class="rail-section-label">Plugin / category</div>
          <div class="rail-cats" id="rail-cats"></div>
        </aside>

        <section class="commands" aria-label="Commands">
          <div class="search-wrap">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              class="search"
              type="search"
              id="search"
              placeholder="Search commands…"
              autocomplete="off"
              spellcheck="false"
            />
          </div>
          <div class="cmd-list" id="cmd-list"></div>
        </section>

        <section class="builder" id="builder" aria-label="Command builder"></section>
      </section>

      <section class="presets-section">
        <div class="presets-header">
          <h2>Unlock everything</h2>
          <p>
            One-click LuckPerms grants that fully unlock each plugin for a player. Type a username
            below and the commands fill in automatically. Run them in the BRUH panel <strong>Console</strong> tab.
          </p>
          <div class="presets-username">
            <label for="preset-user">Player to grant:</label>
            <input id="preset-user" type="text" value="YourUsername" autocomplete="off" spellcheck="false" />
          </div>
        </div>
        <div class="presets-grid" id="presets-grid"></div>
      </section>
    </main>

    <footer>
      &copy; 2015–2026 BRUH Automation &middot; Open Source &middot;
      <a href="https://github.com/bruhautomation" target="_blank" rel="noopener">GitHub</a>
      &middot;
      <a href="/bruh-minecraft/">Back to add-on</a>
    </footer>

    <!-- Modal picker -->
    <div class="modal-overlay" id="modal" role="dialog" aria-modal="true" aria-hidden="true">
      <div class="modal" role="document">
        <header class="modal-head">
          <div class="modal-title-row">
            <div class="modal-title" id="modal-title">Pick a block</div>
            <div class="modal-sub" id="modal-sub">Click a tile to insert it.</div>
          </div>
          <button class="modal-close" id="modal-close" aria-label="Close picker">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>
        <div class="modal-body">
          <aside class="modal-cats" id="modal-cats"></aside>
          <div class="modal-main">
            <div class="modal-search-wrap">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input class="modal-search" id="modal-search" type="search" placeholder="Search by name or ID…" autocomplete="off" spellcheck="false" />
            </div>
            <div class="modal-grid" id="modal-grid"></div>
            <div class="modal-foot">
              <span id="modal-count">0 results</span>
              <span class="modal-foot-kbd"><kbd>Esc</kbd> close</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script is:inline>
      // ───────── Theme toggle ─────────
      (function () {
        var toggle = document.getElementById('theme-toggle');
        var pill = document.getElementById('toggle-pill');
        if (!toggle || !pill) return;
        var stored = localStorage.getItem('starlight-theme');
        var current = stored === 'light' || stored === 'dark' ? stored : 'auto';
        setUI(current);
        toggle.addEventListener('click', function (e) {
          var btn = e.target.closest('button[data-value]');
          if (!btn) return;
          apply(btn.getAttribute('data-value'));
        });
        function setUI(theme) {
          var posMap = { light: '0', auto: '1', dark: '2' };
          pill.setAttribute('data-pos', posMap[theme] || '1');
          toggle.querySelectorAll('button').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-value') === theme ? 'true' : 'false');
          });
        }
        function apply(theme) {
          setUI(theme);
          var resolved = theme;
          if (theme === 'auto') {
            resolved = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.dataset.theme = resolved;
          localStorage.setItem('starlight-theme', theme);
        }
      })();
    </script>

    <script is:inline>
      // ───────── Command generator ─────────
      (function () {
        const payload = JSON.parse(document.body.getAttribute('data-payload'));
        const {
          CATEGORIES, COMMANDS, UNLOCK_PRESETS,
          BLOCKS, ITEMS, ENTITIES, EFFECTS, ENCHANTS,
          BLOCK_CATEGORIES, ITEM_CATEGORIES, ENTITY_CATEGORIES,
          CHAT_COLORS, GAMERULES,
        } = payload;

        // Maps from registries
        const REGISTRIES = {
          block: { entries: BLOCKS, categories: BLOCK_CATEGORIES, title: 'Pick a block', sub: 'Vanilla Minecraft 1.20+ block registry.' },
          item:  { entries: ITEMS, categories: ITEM_CATEGORIES, title: 'Pick an item', sub: 'Every vanilla item, including all blocks.' },
          entity:{ entries: ENTITIES, categories: ENTITY_CATEGORIES, title: 'Pick an entity', sub: 'Spawnable mobs, vehicles, and projectiles.' },
          effect:{ entries: EFFECTS, categories: [{ id: 'all', name: 'All effects', iconPath: '' }], title: 'Pick an effect', sub: 'Status effects.' },
          enchantment:{ entries: ENCHANTS, categories: [{ id: 'all', name: 'All enchantments', iconPath: '' }], title: 'Pick an enchantment', sub: 'Available enchantments.' },
        };

        // ─── State ───
        const state = {
          activeCategory: 'all',
          activeCommandId: COMMANDS[0]?.id ?? null,
          search: '',
          values: {},
          modes: {}, // commandId -> 'json' | 'rich' | 'pattern' | 'single' (specialized mode toggle)
          richSegments: {}, // commandId-argKey -> [{ text, color, bold, italic, underlined, strikethrough, obfuscated }]
          patternRows: {},  // commandId-argKey -> [{ block, weight }]
          lpUser: 'PlayerName',
          presetUser: 'YourUsername',
        };

        // ─── DOM refs ───
        const railEl = document.getElementById('rail-cats');
        const cmdListEl = document.getElementById('cmd-list');
        const builderEl = document.getElementById('builder');
        const searchEl = document.getElementById('search');
        const toastEl = document.getElementById('toast');
        const presetsGridEl = document.getElementById('presets-grid');
        const presetUserEl = document.getElementById('preset-user');
        const modalEl = document.getElementById('modal');
        const modalTitleEl = document.getElementById('modal-title');
        const modalSubEl = document.getElementById('modal-sub');
        const modalCatsEl = document.getElementById('modal-cats');
        const modalGridEl = document.getElementById('modal-grid');
        const modalSearchEl = document.getElementById('modal-search');
        const modalCountEl = document.getElementById('modal-count');
        const modalCloseEl = document.getElementById('modal-close');

        // ─── Categories rail ───
        function commandCount(catId) { return COMMANDS.filter((c) => c.category === catId).length; }
        function totalCount() { return COMMANDS.length; }

        function renderRail() {
          railEl.innerHTML = '';
          railEl.appendChild(makeCatBtn(
            { id: 'all', name: 'All commands', iconPath: 'M4 6h16M4 12h16M4 18h12' },
            totalCount(),
            state.activeCategory === 'all'
          ));
          CATEGORIES.forEach((cat) => {
            railEl.appendChild(makeCatBtn(cat, commandCount(cat.id), state.activeCategory === cat.id));
          });
        }
        function makeCatBtn(cat, count, active) {
          const btn = document.createElement('button');
          btn.className = 'cat-btn';
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          btn.dataset.id = cat.id;
          btn.innerHTML =
            `<span class="cat-btn-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="${cat.iconPath}"></path>
              </svg>
            </span>
            <span class="cat-btn-name">${escapeHtml(cat.name)}</span>
            <span class="cat-btn-count">${count}</span>`;
          btn.addEventListener('click', () => {
            state.activeCategory = cat.id;
            renderRail();
            renderCommandList();
          });
          return btn;
        }

        // ─── Command list ───
        function renderCommandList() {
          const search = state.search.trim().toLowerCase();
          let filtered = COMMANDS;
          if (state.activeCategory !== 'all') {
            filtered = filtered.filter((c) => c.category === state.activeCategory);
          }
          if (search) {
            filtered = filtered.filter((c) =>
              c.name.toLowerCase().includes(search) ||
              c.description.toLowerCase().includes(search) ||
              (c.permission || '').toLowerCase().includes(search)
            );
          }

          cmdListEl.innerHTML = '';
          if (filtered.length === 0) {
            cmdListEl.innerHTML = `<div class="empty-state">No commands match. Try a different search.</div>`;
            return;
          }

          if (state.activeCategory === 'all') {
            const byCat = {};
            filtered.forEach((c) => { (byCat[c.category] = byCat[c.category] || []).push(c); });
            CATEGORIES.forEach((cat) => {
              const group = byCat[cat.id];
              if (!group) return;
              const label = document.createElement('div');
              label.className = 'cmd-section-label';
              label.textContent = cat.name + ' · ' + group.length;
              cmdListEl.appendChild(label);
              group.forEach((c) => cmdListEl.appendChild(makeCmdItem(c)));
            });
          } else {
            filtered.forEach((c) => cmdListEl.appendChild(makeCmdItem(c)));
          }
        }
        function makeCmdItem(cmd) {
          const btn = document.createElement('button');
          btn.className = 'cmd-item';
          btn.setAttribute('aria-pressed', state.activeCommandId === cmd.id ? 'true' : 'false');
          btn.dataset.id = cmd.id;
          btn.innerHTML =
            `<div class="cmd-item-name">${escapeHtml(cmd.name)}</div>
             <div class="cmd-item-desc">${escapeHtml(cmd.description)}</div>`;
          btn.addEventListener('click', () => {
            state.activeCommandId = cmd.id;
            renderCommandList();
            renderBuilder();
          });
          return btn;
        }

        // ─── Modal picker ───
        let modalState = { kind: 'block', category: 'all', search: '', onPick: null };

        function openPicker(kind, currentValue, onPick) {
          modalState.kind = kind;
          modalState.category = 'all';
          modalState.search = '';
          modalState.onPick = onPick;
          modalState.currentValue = currentValue || '';
          const reg = REGISTRIES[kind];
          if (!reg) return;
          modalTitleEl.textContent = reg.title;
          modalSubEl.textContent = reg.sub;
          modalSearchEl.value = '';
          renderModalCats();
          renderModalGrid();
          modalEl.classList.add('open');
          modalEl.setAttribute('aria-hidden', 'false');
          setTimeout(() => modalSearchEl.focus(), 60);
        }
        function closePicker() {
          modalEl.classList.remove('open');
          modalEl.setAttribute('aria-hidden', 'true');
        }
        modalCloseEl.addEventListener('click', closePicker);
        modalEl.addEventListener('click', (e) => { if (e.target === modalEl) closePicker(); });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modalEl.classList.contains('open')) closePicker();
        });

        function renderModalCats() {
          const reg = REGISTRIES[modalState.kind];
          modalCatsEl.innerHTML = '';
          reg.categories.forEach((cat) => {
            const total = cat.id === 'all'
              ? reg.entries.length
              : reg.entries.filter((e) => e.category === cat.id).length;
            if (total === 0) return;
            const btn = document.createElement('button');
            btn.className = 'cat-btn';
            btn.setAttribute('aria-pressed', modalState.category === cat.id ? 'true' : 'false');
            btn.innerHTML =
              `<span class="cat-btn-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${cat.iconPath || 'M4 6h16M4 12h16M4 18h12'}"></path></svg>
              </span>
              <span class="cat-btn-name">${escapeHtml(cat.name)}</span>
              <span class="cat-btn-count">${total}</span>`;
            btn.addEventListener('click', () => {
              modalState.category = cat.id;
              renderModalCats();
              renderModalGrid();
            });
            modalCatsEl.appendChild(btn);
          });
        }
        function renderModalGrid() {
          const reg = REGISTRIES[modalState.kind];
          const search = modalState.search.trim().toLowerCase();
          let filtered = reg.entries;
          if (modalState.category !== 'all') {
            filtered = filtered.filter((e) => e.category === modalState.category);
          }
          if (search) {
            filtered = filtered.filter((e) =>
              e.label.toLowerCase().includes(search) ||
              e.id.toLowerCase().includes(search) ||
              (e.tags || []).some((t) => t.toLowerCase().includes(search))
            );
          }
          // Cap grid to first 600 results for perf; show count of total.
          const cap = 600;
          const shown = filtered.slice(0, cap);
          modalGridEl.innerHTML = '';
          if (shown.length === 0) {
            modalGridEl.innerHTML = `<div class="modal-empty">No matches.</div>`;
          } else {
            shown.forEach((entry) => {
              const tile = document.createElement('button');
              tile.className = 'modal-tile' + (entry.id === modalState.currentValue ? ' selected' : '');
              tile.style.setProperty('--swatch-color', entry.color);
              tile.innerHTML = `
                <div class="modal-swatch"></div>
                <div class="modal-meta">
                  <div class="modal-meta-label">${escapeHtml(entry.label)}</div>
                  <div class="modal-meta-id">${escapeHtml(entry.id)}</div>
                </div>
              `;
              tile.addEventListener('click', () => {
                if (modalState.onPick) modalState.onPick(entry.id);
                closePicker();
              });
              modalGridEl.appendChild(tile);
            });
          }
          modalCountEl.textContent =
            filtered.length > cap ? `${cap}+ of ${filtered.length} (refine search)` : `${filtered.length} result${filtered.length === 1 ? '' : 's'}`;
        }
        modalSearchEl.addEventListener('input', () => {
          modalState.search = modalSearchEl.value;
          renderModalGrid();
        });

        // ─── Builder ───
        function renderBuilder() {
          const cmd = COMMANDS.find((c) => c.id === state.activeCommandId);
          if (!cmd) {
            builderEl.innerHTML = `
              <div class="builder-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                <h3>Pick a command</h3>
                <p>Choose a category on the left, then a command in the middle column.</p>
              </div>`;
            return;
          }

          if (!state.values[cmd.id]) {
            state.values[cmd.id] = {};
            cmd.args.forEach((a) => { if (a.default != null) state.values[cmd.id][a.key] = a.default; });
          }
          const vals = state.values[cmd.id];
          const cat = CATEGORIES.find((c) => c.id === cmd.category);

          builderEl.innerHTML = '';
          const header = document.createElement('div');
          header.className = 'builder-header';
          header.innerHTML = `
            <div class="builder-eyebrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="${cat ? cat.iconPath : ''}"></path>
              </svg>
              ${cat ? escapeHtml(cat.name) : 'Vanilla'}
            </div>
            <div class="builder-title">${escapeHtml(cmd.name)}</div>
            <div class="builder-desc">${escapeHtml(cmd.description)}</div>
            ${cmd.permission ? `
              <div class="builder-meta">
                <span>Permission <code>${escapeHtml(cmd.permission)}</code></span>
                ${cat && cat.wiki ? `<span><a href="${cat.wiki}" target="_blank" rel="noopener" style="color:var(--accent)">Plugin docs ↗</a></span>` : ''}
              </div>` : ''}
            ${cmd.notes ? `<div class="builder-notes">${escapeHtml(cmd.notes)}</div>` : ''}
          `;
          builderEl.appendChild(header);

          // Args
          const argsEl = document.createElement('div');
          argsEl.className = 'args';
          if (cmd.args.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'args-empty';
            empty.textContent = 'No arguments — this command runs as-is.';
            argsEl.appendChild(empty);
          } else {
            cmd.args.forEach((arg) => argsEl.appendChild(makeArgField(cmd, arg, vals)));
          }
          builderEl.appendChild(argsEl);

          // Preview
          const previewWrap = document.createElement('div');
          previewWrap.className = 'preview';
          previewWrap.innerHTML = `
            <div class="preview-label">Preview</div>
            <div class="preview-window">
              <div class="preview-titlebar">
                <span class="preview-dot r"></span>
                <span class="preview-dot y"></span>
                <span class="preview-dot g"></span>
                <span class="preview-titlebar-text">BRUH Minecraft Console</span>
              </div>
              <div class="preview-box" id="preview-box"></div>
            </div>
          `;

          if (cmd.permission) {
            const lp = document.createElement('div');
            lp.className = 'lp-helper';
            lp.innerHTML = `
              <div class="lp-helper-label">Grant this permission via LuckPerms</div>
              <div class="lp-helper-row">
                <input type="text" class="lp-helper-input" id="lp-user" value="${escapeAttr(state.lpUser)}" placeholder="username" autocomplete="off" spellcheck="false" />
                <button class="btn-secondary" id="lp-copy-btn" type="button">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  Copy grant
                </button>
              </div>
              <div class="lp-helper-cmd" id="lp-cmd"></div>
            `;
            previewWrap.appendChild(lp);
            setTimeout(() => {
              const userInput = lp.querySelector('#lp-user');
              const cmdEl = lp.querySelector('#lp-cmd');
              const copyBtn = lp.querySelector('#lp-copy-btn');
              const updateLp = () => {
                state.lpUser = userInput.value;
                const u = (userInput.value || 'PlayerName').trim() || 'PlayerName';
                cmdEl.textContent = `/lp user ${u} permission set ${cmd.permission} true`;
              };
              userInput.addEventListener('input', updateLp);
              copyBtn.addEventListener('click', () => copyToClipboard(cmdEl.textContent, copyBtn, 'LuckPerms grant copied'));
              updateLp();
            }, 0);
          }
          builderEl.appendChild(previewWrap);
          updatePreview(cmd, vals);
        }

        function makeArgField(cmd, arg, vals) {
          const wrap = document.createElement('div');
          wrap.className = 'arg-field';

          const label = document.createElement('label');
          label.className = 'arg-label';
          label.innerHTML = `
            <span>${escapeHtml(arg.label)}</span>
            ${arg.required ? '<span class="arg-required" title="Required">●</span>' : ''}
            <span class="arg-type">${escapeHtml(arg.type)}</span>
          `;
          wrap.appendChild(label);

          // ── Specialized: rich-text builder for tellraw / title JSON args ──
          const isRichTarget = arg.type === 'json' && (cmd.id === 'tellraw' || cmd.id === 'title');
          if (isRichTarget) {
            wrap.appendChild(buildRichTextField(cmd, arg, vals));
            if (arg.hint) {
              const hint = document.createElement('div');
              hint.className = 'arg-hint';
              hint.textContent = arg.hint;
              wrap.appendChild(hint);
            }
            return wrap;
          }

          // ── Specialized: WorldEdit pattern builder for {pattern} args ──
          const isPatternTarget = arg.type === 'block' && cmd.category === 'worldedit' && arg.key === 'pattern';
          if (isPatternTarget) {
            wrap.appendChild(buildPatternField(cmd, arg, vals));
            if (arg.hint) {
              const hint = document.createElement('div');
              hint.className = 'arg-hint';
              hint.textContent = arg.hint;
              wrap.appendChild(hint);
            }
            return wrap;
          }

          // ── Visual picker for block / item / entity / effect / enchantment ──
          const pickerKinds = ['block', 'item', 'entity', 'effect', 'enchantment'];
          if (pickerKinds.includes(arg.type)) {
            wrap.appendChild(buildPickerField(cmd, arg, vals));
            if (arg.hint) {
              const hint = document.createElement('div');
              hint.className = 'arg-hint';
              hint.textContent = arg.hint;
              wrap.appendChild(hint);
            }
            return wrap;
          }

          // ── Fallback: standard inputs ──
          let input;
          const currentVal = vals[arg.key] ?? arg.default ?? '';
          if (arg.type === 'select') {
            input = document.createElement('select');
            input.className = 'arg-select';
            (arg.options || []).forEach((opt) => {
              const o = document.createElement('option');
              o.value = opt;
              o.textContent = opt === '' ? '— none —' : opt;
              if (opt === currentVal) o.selected = true;
              input.appendChild(o);
            });
          } else if (arg.type === 'gamerule') {
            input = document.createElement('select');
            input.className = 'arg-select';
            GAMERULES.forEach((opt) => {
              const o = document.createElement('option');
              o.value = opt;
              o.textContent = opt;
              if (opt === currentVal) o.selected = true;
              input.appendChild(o);
            });
          } else if (arg.type === 'longtext' || arg.type === 'json') {
            input = document.createElement('textarea');
            input.className = 'arg-textarea';
            input.rows = arg.type === 'json' ? 3 : 2;
            input.value = currentVal;
            if (arg.placeholder) input.placeholder = arg.placeholder;
          } else {
            input = document.createElement('input');
            input.className = 'arg-input';
            input.type = arg.type === 'number' ? 'number' : 'text';
            input.value = currentVal;
            if (arg.placeholder) input.placeholder = arg.placeholder;
            if (arg.min != null) input.min = String(arg.min);
            if (arg.max != null) input.max = String(arg.max);
            if (arg.step != null) input.step = String(arg.step);
            if (arg.type === 'target' || arg.type === 'player') {
              const listId = 'datalist-' + cmd.id + '-' + arg.key;
              input.setAttribute('list', listId);
              const list = document.createElement('datalist');
              list.id = listId;
              ['@s', '@p', '@a', '@r', '@e'].forEach((opt) => {
                const o = document.createElement('option');
                o.value = opt;
                list.appendChild(o);
              });
              wrap.appendChild(list);
              input.classList.add('arg-mono');
            }
          }
          input.addEventListener('input', () => { vals[arg.key] = input.value; updatePreview(cmd, vals); });
          input.addEventListener('change', () => { vals[arg.key] = input.value; updatePreview(cmd, vals); });
          wrap.appendChild(input);

          if (arg.hint) {
            const hint = document.createElement('div');
            hint.className = 'arg-hint';
            hint.textContent = arg.hint;
            wrap.appendChild(hint);
          }
          vals[arg.key] = currentVal;
          return wrap;
        }

        // ─── Visual picker field ───
        function buildPickerField(cmd, arg, vals) {
          const currentVal = vals[arg.key] ?? arg.default ?? '';
          vals[arg.key] = currentVal;
          const reg = REGISTRIES[arg.type];
          const found = reg ? reg.entries.find((e) => e.id === currentVal) : null;

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'picker-btn';
          renderPickerBtn(btn, currentVal, found);
          btn.addEventListener('click', () => {
            openPicker(arg.type, vals[arg.key] || '', (newId) => {
              vals[arg.key] = newId;
              const e = reg.entries.find((x) => x.id === newId);
              renderPickerBtn(btn, newId, e);
              updatePreview(cmd, vals);
            });
          });

          // Allow direct paste/clear with a keyboard text field as backup
          const small = document.createElement('input');
          small.type = 'text';
          small.className = 'arg-input arg-mono';
          small.value = currentVal;
          small.placeholder = arg.placeholder || `minecraft:…`;
          small.style.marginTop = '0.35rem';
          small.style.fontSize = '0.78rem';
          small.style.padding = '0.35rem 0.55rem';
          small.addEventListener('input', () => {
            vals[arg.key] = small.value;
            const e = reg.entries.find((x) => x.id === small.value);
            renderPickerBtn(btn, small.value, e);
            updatePreview(cmd, vals);
          });

          const wrap = document.createElement('div');
          wrap.appendChild(btn);
          wrap.appendChild(small);
          return wrap;
        }
        function renderPickerBtn(btn, value, entry) {
          const empty = !value;
          const swatchColor = entry ? entry.color : 'var(--bg-card-solid)';
          btn.style.setProperty('--swatch-color', swatchColor);
          btn.innerHTML = `
            <div class="picker-swatch ${empty ? 'empty' : ''}"></div>
            <div class="picker-text">
              <div class="picker-label">${escapeHtml(entry ? entry.label : (empty ? 'Click to browse…' : 'Custom ID'))}</div>
              <div class="picker-id">${escapeHtml(value || 'minecraft:…')}</div>
            </div>
            <svg class="picker-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          `;
        }

        // ─── WorldEdit pattern builder ───
        function buildPatternField(cmd, arg, vals) {
          const wrap = document.createElement('div');
          const key = cmd.id + '-' + arg.key;
          const modeKey = cmd.id;
          if (!state.modes[modeKey]) state.modes[modeKey] = 'single';

          // Tabs
          const tabs = document.createElement('div');
          tabs.className = 'builder-tabs';
          ['single', 'pattern'].forEach((m) => {
            const t = document.createElement('button');
            t.type = 'button'; t.className = 'builder-tab';
            t.textContent = m === 'single' ? 'Single block' : 'Mixed pattern';
            t.setAttribute('aria-pressed', state.modes[modeKey] === m ? 'true' : 'false');
            t.addEventListener('click', () => {
              state.modes[modeKey] = m;
              renderBuilder();
            });
            tabs.appendChild(t);
          });
          wrap.appendChild(tabs);

          if (state.modes[modeKey] === 'single') {
            const fld = buildPickerField(cmd, { ...arg, type: 'block' }, vals);
            wrap.appendChild(fld);
            return wrap;
          }

          // Pattern mode
          if (!state.patternRows[key]) {
            // Seed with the current value if it looks like a pattern, else default to 2 rows.
            const cur = vals[arg.key] || '';
            if (cur.includes(',') || /\d+%/.test(cur)) {
              state.patternRows[key] = cur.split(',').map((seg) => {
                const m = seg.trim().match(/^(\d+)%(.+)$/);
                if (m) return { block: m[2].trim(), weight: parseInt(m[1], 10) };
                return { block: seg.trim(), weight: 50 };
              });
            } else {
              state.patternRows[key] = [
                { block: cur || 'minecraft:stone', weight: 50 },
                { block: 'minecraft:cobblestone', weight: 50 },
              ];
            }
          }
          const rebuild = () => {
            const rows = state.patternRows[key];
            const total = rows.reduce((a, r) => a + (parseInt(r.weight, 10) || 0), 0) || 1;
            const segs = rows
              .filter((r) => r.block && r.block.trim())
              .map((r) => `${Math.round(((parseInt(r.weight, 10) || 0) / total) * 100)}%${r.block.trim()}`);
            vals[arg.key] = segs.join(',');
            updatePreview(cmd, vals);
          };

          const list = document.createElement('div');
          state.patternRows[key].forEach((row, idx) => {
            const r = document.createElement('div');
            r.className = 'pattern-row';

            const pickBtn = document.createElement('button');
            pickBtn.type = 'button';
            pickBtn.className = 'picker-btn';
            const reg = REGISTRIES.block;
            const e = reg.entries.find((x) => x.id === row.block);
            renderPickerBtn(pickBtn, row.block, e);
            pickBtn.addEventListener('click', () => {
              openPicker('block', row.block, (newId) => {
                row.block = newId;
                const e2 = reg.entries.find((x) => x.id === newId);
                renderPickerBtn(pickBtn, newId, e2);
                rebuild();
              });
            });
            r.appendChild(pickBtn);

            const w = document.createElement('input');
            w.type = 'number';
            w.className = 'pattern-weight';
            w.min = '0'; w.max = '1000'; w.value = String(row.weight);
            w.addEventListener('input', () => { row.weight = parseInt(w.value, 10) || 0; rebuild(); });
            r.appendChild(w);

            const rm = document.createElement('button');
            rm.type = 'button';
            rm.className = 'rt-rm-btn';
            rm.title = 'Remove';
            rm.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`;
            rm.addEventListener('click', () => {
              state.patternRows[key].splice(idx, 1);
              if (state.patternRows[key].length === 0) {
                state.patternRows[key].push({ block: 'minecraft:stone', weight: 50 });
              }
              renderBuilder();
            });
            r.appendChild(rm);

            list.appendChild(r);
          });
          wrap.appendChild(list);

          const add = document.createElement('button');
          add.type = 'button';
          add.className = 'rt-add-btn';
          add.style.marginTop = '0.5rem';
          add.innerHTML = `
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add block to mix
          `;
          add.addEventListener('click', () => {
            state.patternRows[key].push({ block: 'minecraft:stone', weight: 25 });
            renderBuilder();
          });
          wrap.appendChild(add);

          const hint = document.createElement('div');
          hint.className = 'arg-hint';
          hint.style.marginTop = '0.5rem';
          hint.textContent = 'Weights are normalized to 100% automatically. WorldEdit syntax: 30%minecraft:stone,70%minecraft:cobblestone';
          wrap.appendChild(hint);

          rebuild();
          return wrap;
        }

        // ─── Rich text builder (tellraw / title) ───
        function buildRichTextField(cmd, arg, vals) {
          const wrap = document.createElement('div');
          const key = cmd.id + '-' + arg.key;
          const modeKey = cmd.id + '-' + arg.key + '-mode';
          if (!state.modes[modeKey]) state.modes[modeKey] = 'rich';

          const tabs = document.createElement('div');
          tabs.className = 'builder-tabs';
          [['rich', 'Rich text'], ['json', 'Raw JSON']].forEach(([m, label]) => {
            const t = document.createElement('button');
            t.type = 'button'; t.className = 'builder-tab';
            t.textContent = label;
            t.setAttribute('aria-pressed', state.modes[modeKey] === m ? 'true' : 'false');
            t.addEventListener('click', () => {
              state.modes[modeKey] = m;
              renderBuilder();
            });
            tabs.appendChild(t);
          });
          wrap.appendChild(tabs);

          if (state.modes[modeKey] === 'json') {
            const ta = document.createElement('textarea');
            ta.className = 'arg-textarea'; ta.rows = 4;
            ta.value = vals[arg.key] || arg.default || '';
            ta.placeholder = arg.placeholder || '{"text":"Hello","color":"aqua"}';
            ta.addEventListener('input', () => { vals[arg.key] = ta.value; updatePreview(cmd, vals); });
            wrap.appendChild(ta);
            return wrap;
          }

          // Rich mode
          if (!state.richSegments[key]) {
            // Try to seed from existing value
            state.richSegments[key] = parseRichSegments(vals[arg.key] || arg.default || '');
            if (state.richSegments[key].length === 0) {
              state.richSegments[key] = [{ text: 'Hello, world!', color: 'aqua', bold: false, italic: false, underlined: false, strikethrough: false, obfuscated: false }];
            }
          }
          const segments = state.richSegments[key];

          const rebuild = () => {
            vals[arg.key] = serializeRichSegments(segments);
            updatePreview(cmd, vals);
          };

          segments.forEach((seg, idx) => {
            wrap.appendChild(buildRichSegmentEditor(seg, idx, segments, rebuild));
          });

          const add = document.createElement('button');
          add.type = 'button';
          add.className = 'rt-add-btn';
          add.style.marginTop = '0.5rem';
          add.innerHTML = `
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add segment
          `;
          add.addEventListener('click', () => {
            segments.push({ text: 'More text', color: 'white', bold: false, italic: false, underlined: false, strikethrough: false, obfuscated: false });
            renderBuilder();
          });
          wrap.appendChild(add);

          // Live preview of rendered chat
          const livePrev = document.createElement('div');
          livePrev.className = 'rt-preview';
          livePrev.style.marginTop = '0.5rem';
          livePrev.id = key + '-preview';
          wrap.appendChild(livePrev);

          rebuild();
          updateRichLivePreview(key, segments);
          return wrap;
        }

        function buildRichSegmentEditor(seg, idx, all, rebuild) {
          const ed = document.createElement('div');
          ed.className = 'rt-segment';

          // text + remove
          const row1 = document.createElement('div');
          row1.className = 'rt-segment-row';
          const txt = document.createElement('input');
          txt.type = 'text'; txt.className = 'rt-segment-text';
          txt.value = seg.text; txt.placeholder = 'Text';
          txt.addEventListener('input', () => {
            seg.text = txt.value; rebuild();
            updateRichLivePreview(currentRichKey(), all);
          });
          row1.appendChild(txt);
          if (all.length > 1) {
            const rm = document.createElement('button');
            rm.type = 'button'; rm.className = 'rt-rm-btn';
            rm.textContent = 'Remove';
            rm.addEventListener('click', () => {
              all.splice(idx, 1);
              renderBuilder();
            });
            row1.appendChild(rm);
          }
          ed.appendChild(row1);

          // colors
          const colors = document.createElement('div');
          colors.className = 'rt-color-grid';
          CHAT_COLORS.forEach((c) => {
            const cb = document.createElement('button');
            cb.type = 'button'; cb.className = 'rt-color-btn';
            cb.style.background = c.hex;
            cb.title = c.label;
            cb.setAttribute('aria-pressed', seg.color === c.id ? 'true' : 'false');
            cb.addEventListener('click', () => {
              seg.color = c.id;
              colors.querySelectorAll('.rt-color-btn').forEach((b) => b.setAttribute('aria-pressed', 'false'));
              cb.setAttribute('aria-pressed', 'true');
              rebuild();
              updateRichLivePreview(currentRichKey(), all);
            });
            colors.appendChild(cb);
          });
          ed.appendChild(colors);

          // formatting
          const fmts = document.createElement('div');
          fmts.className = 'rt-format-row';
          [
            { key: 'bold', label: 'B', style: 'font-weight:700' },
            { key: 'italic', label: 'I', style: 'font-style:italic' },
            { key: 'underlined', label: 'U', style: 'text-decoration:underline' },
            { key: 'strikethrough', label: 'S', style: 'text-decoration:line-through' },
            { key: 'obfuscated', label: '?', style: 'letter-spacing:0.05em' },
          ].forEach((f) => {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'rt-format-btn';
            b.textContent = f.label;
            b.style = f.style;
            b.title = f.key.charAt(0).toUpperCase() + f.key.slice(1);
            b.setAttribute('aria-pressed', seg[f.key] ? 'true' : 'false');
            b.addEventListener('click', () => {
              seg[f.key] = !seg[f.key];
              b.setAttribute('aria-pressed', seg[f.key] ? 'true' : 'false');
              rebuild();
              updateRichLivePreview(currentRichKey(), all);
            });
            fmts.appendChild(b);
          });
          ed.appendChild(fmts);

          return ed;
        }

        function currentRichKey() {
          // Find any key with a -preview element currently in DOM
          const cmd = COMMANDS.find((c) => c.id === state.activeCommandId);
          if (!cmd) return '';
          const arg = cmd.args.find((a) => a.type === 'json');
          return arg ? cmd.id + '-' + arg.key : '';
        }

        function updateRichLivePreview(key, segments) {
          const el = document.getElementById(key + '-preview');
          if (!el) return;
          const html = segments.map((s) => {
            const colorMap = {};
            CHAT_COLORS.forEach((c) => { colorMap[c.id] = c.hex; });
            const style = [
              s.color && `color:${colorMap[s.color] || '#fff'}`,
              s.bold && 'font-weight:700',
              s.italic && 'font-style:italic',
              s.underlined && 'text-decoration:underline',
              s.strikethrough && 'text-decoration:line-through',
              s.obfuscated && 'letter-spacing:0.05em;filter:blur(0.5px)',
            ].filter(Boolean).join(';');
            return `<span style="${style}">${escapeHtml(s.text)}</span>`;
          }).join('');
          el.innerHTML = html || '<span class="preview-mute">(empty)</span>';
        }

        function serializeRichSegments(segments) {
          if (segments.length === 0) return '""';
          if (segments.length === 1) return JSON.stringify(toJsonComponent(segments[0]));
          return JSON.stringify(segments.map(toJsonComponent));
        }
        function toJsonComponent(seg) {
          const obj = { text: seg.text };
          if (seg.color && seg.color !== 'white') obj.color = seg.color;
          if (seg.bold) obj.bold = true;
          if (seg.italic) obj.italic = true;
          if (seg.underlined) obj.underlined = true;
          if (seg.strikethrough) obj.strikethrough = true;
          if (seg.obfuscated) obj.obfuscated = true;
          return obj;
        }
        function parseRichSegments(s) {
          try {
            const parsed = JSON.parse(s);
            const arr = Array.isArray(parsed) ? parsed : [parsed];
            return arr.map((c) => ({
              text: typeof c === 'string' ? c : (c.text || ''),
              color: (c && c.color) || 'white',
              bold: !!(c && c.bold),
              italic: !!(c && c.italic),
              underlined: !!(c && c.underlined),
              strikethrough: !!(c && c.strikethrough),
              obfuscated: !!(c && c.obfuscated),
            }));
          } catch {
            return [];
          }
        }

        // ─── Build the command string ───
        function buildCommand(cmd, vals) {
          const tpl = cmd.template;
          const re = /\{(\w+)\}/g;
          let lastIndex = 0;
          let m;
          const segs = [];
          while ((m = re.exec(tpl)) !== null) {
            if (m.index > lastIndex) segs.push({ type: 'static', text: tpl.slice(lastIndex, m.index) });
            segs.push({ type: 'arg', key: m[1] });
            lastIndex = m.index + m[0].length;
          }
          if (lastIndex < tpl.length) segs.push({ type: 'static', text: tpl.slice(lastIndex) });

          const argSegs = segs.filter((s) => s.type === 'arg');
          let lastFilledArgIdx = -1;
          argSegs.forEach((s, i) => {
            const v = (vals[s.key] ?? '').toString().trim();
            if (v !== '') lastFilledArgIdx = i;
          });
          let argIdx = -1;

          let plain = '';
          let html = '';
          let missingRequired = false;
          let pendingSpace = '';
          const esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);
          let cmdNameDone = false;

          segs.forEach((seg) => {
            if (seg.type === 'static') {
              const s = seg.text;
              if (/^\s+$/.test(s)) { pendingSpace += s; return; }
              if (pendingSpace) { plain += pendingSpace; html += esc(pendingSpace); pendingSpace = ''; }
              if (!cmdNameDone) {
                const wsIdx = s.search(/\s/);
                const name = wsIdx === -1 ? s : s.slice(0, wsIdx);
                const rest = wsIdx === -1 ? '' : s.slice(wsIdx);
                plain += s;
                html += `<span class="preview-cmd">${esc(name)}</span>${esc(rest)}`;
                cmdNameDone = true;
              } else {
                plain += s; html += esc(s);
              }
            } else {
              argIdx++;
              const arg = cmd.args.find((a) => a.key === seg.key);
              const raw = (vals[seg.key] ?? '').toString();
              const val = raw.trim();
              const positionallyNeeded = argIdx < lastFilledArgIdx;
              if (val === '') {
                if ((arg && arg.required) || positionallyNeeded) {
                  if (pendingSpace) { plain += pendingSpace; html += esc(pendingSpace); pendingSpace = ''; }
                  plain += `<${arg.label}>`;
                  html += `<span class="preview-arg-required">&lt;${esc(arg.label)}&gt;</span>`;
                  missingRequired = true;
                } else {
                  pendingSpace = '';
                }
              } else {
                if (pendingSpace) { plain += pendingSpace; html += esc(pendingSpace); pendingSpace = ''; }
                plain += val; html += `<span class="preview-arg-filled">${esc(val)}</span>`;
              }
            }
          });
          plain = plain.replace(/\s{2,}/g, ' ').trim();
          return { plain, html, missingRequired };
        }

        function updatePreview(cmd, vals) {
          const box = document.getElementById('preview-box');
          if (!box) return;
          const built = buildCommand(cmd, vals);
          box.innerHTML = `<span class="preview-content">${built.html || '<span class="preview-mute">(empty)</span>'}</span>`;
          const copy = document.createElement('button');
          copy.className = 'copy-btn';
          copy.type = 'button';
          copy.innerHTML = `
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>Copy</span>
          `;
          copy.addEventListener('click', () => {
            if (built.missingRequired) {
              flashCopyBtn(copy, 'Fill required', false);
              showToast('Fill required fields first', 'error');
              return;
            }
            copyToClipboard(built.plain, copy, 'Command copied');
          });
          box.appendChild(copy);
        }

        // ─── Presets ───
        function renderPresets() {
          presetsGridEl.innerHTML = '';
          UNLOCK_PRESETS.forEach((p) => {
            const card = document.createElement('div');
            card.className = 'preset-card';
            card.innerHTML = `
              <h3>${escapeHtml(p.name)}</h3>
              <p>${escapeHtml(p.description)}</p>
              <div class="preset-cmds"></div>
              <div class="copy-row">
                <button class="preset-copy" type="button">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Copy</span>
                </button>
              </div>
            `;
            const cmdsEl = card.querySelector('.preset-cmds');
            const updateCmds = () => {
              const u = (presetUserEl.value || 'YourUsername').trim() || 'YourUsername';
              cmdsEl.innerHTML = p.commands.map((c) => escapeHtml(c.replace(/\{USER\}/g, u))).join('<br>');
              cmdsEl.dataset.template = p.commands.map((c) => c.replace(/\{USER\}/g, u)).join('\n');
            };
            const btn = card.querySelector('.preset-copy');
            btn.addEventListener('click', () => copyToClipboard(cmdsEl.dataset.template, btn, 'Unlock commands copied'));
            card._update = updateCmds;
            updateCmds();
            presetsGridEl.appendChild(card);
          });
        }

        // ─── Helpers ───
        function copyToClipboard(text, btn, successMsg) {
          const fallback = () => {
            try {
              const ta = document.createElement('textarea');
              ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
              document.body.appendChild(ta); ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
              flashCopyBtn(btn, 'Copied!', true);
              showToast(successMsg || 'Copied', 'success');
            } catch (e) {
              flashCopyBtn(btn, 'Copy failed', false);
              showToast('Copy failed — please copy manually', 'error');
            }
          };
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(
              () => { flashCopyBtn(btn, 'Copied!', true); showToast(successMsg || 'Copied', 'success'); },
              fallback
            );
          } else {
            fallback();
          }
        }

        function flashCopyBtn(btn, message, ok) {
          const span = btn.querySelector('span');
          const originalText = span ? span.textContent : btn.textContent;
          if (span) span.textContent = message;
          else btn.textContent = message;
          btn.classList.toggle('success', !!ok);
          btn.classList.toggle('error', !ok);
          setTimeout(() => {
            if (span) span.textContent = originalText;
            else btn.textContent = originalText;
            btn.classList.remove('success', 'error');
          }, 1600);
        }

        function showToast(message, kind) {
          toastEl.className = 'toast show ' + (kind || '');
          const icon = kind === 'success'
            ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>'
            : kind === 'error'
              ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>'
              : '';
          toastEl.innerHTML = icon + '<span>' + escapeHtml(message) + '</span>';
          clearTimeout(showToast._t);
          showToast._t = setTimeout(() => toastEl.classList.remove('show'), 2200);
        }

        function escapeHtml(s) {
          return String(s).replace(/[&<>"']/g, (c) =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]
          );
        }
        function escapeAttr(s) { return escapeHtml(s); }

        // ─── Wire up ───
        searchEl.addEventListener('input', () => {
          state.search = searchEl.value;
          renderCommandList();
        });

        presetUserEl.addEventListener('input', () => {
          presetsGridEl.querySelectorAll('.preset-card').forEach((card) => {
            if (card._update) card._update();
          });
        });

        // Initial render
        renderRail();
        renderCommandList();
        renderBuilder();
        renderPresets();
      })();
    </script>
  </body>
</html>
