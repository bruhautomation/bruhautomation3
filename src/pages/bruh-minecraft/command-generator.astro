---
// Minecraft Command Builder — implementation of the Claude Design handoff bundle
// (h/goqkMKSX60Ksz7hkjCcQ8Q). Pixel-perfect port of the React/Babel prototype:
// 3-pane layout, plugin sidebar, per-command builders, syntax-highlighted live
// preview, faux-pixel block/mob picker, /tellraw rich-text builder, multi-block
// /set pattern builder, and an "★ Unlock Everything" LuckPerms generator.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Minecraft Command Builder — BRUH Automation</title>
  <meta name="description" content="Visual Minecraft command builder for the BRUH Minecraft Server add-on — pick a plugin, fill the form, copy the command. Vanilla, EssentialsX, WorldEdit, WorldGuard, LuckPerms, Multiverse, mcMMO, CoreProtect — plus a one-click ★ Unlock Everything LuckPerms generator." />
  <meta name="theme-color" content="#0d1216" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style is:inline>
    :root {
      --bg: #0d1216;
      --bg-2: #11171c;
      --panel: #161d24;
      --panel-2: #1b242c;
      --panel-3: #222d36;
      --line: #2a3540;
      --line-soft: #1f2830;
      --ink: #e6edf3;
      --ink-2: #aab7c2;
      --ink-3: #6b7986;
      --ink-4: #4a5662;
      --accent: #6cc24a;
      --accent-soft: rgba(108, 194, 74, 0.14);
      --accent-line: rgba(108, 194, 74, 0.42);
      --accent-ink: #b6e8a0;
      --redstone: #e0463c;
      --diamond: #4ad9d9;
      --gold: #f7c948;
      --lapis: #3d6cc7;
      --netherite: #b194c9;
      --shadow: 0 1px 0 rgba(255,255,255,.04) inset, 0 12px 28px -12px rgba(0,0,0,.6), 0 2px 0 rgba(0,0,0,.25);
      --pad: 16px;
      --pad-sm: 10px;
      --font-sans: "Space Grotesk", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    }
    [data-density="compact"]{ --pad: 12px; --pad-sm: 8px; }
    [data-density="comfy"]  { --pad: 22px; --pad-sm: 14px; }

    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body{
      margin: 0;
      font-family: var(--font-sans);
      font-feature-settings: "ss01", "ss02", "cv11";
      color: var(--ink);
      background:
        radial-gradient(1200px 800px at 70% -10%, rgba(108,194,74,.05), transparent 60%),
        radial-gradient(900px 700px at -10% 110%, rgba(61,108,199,.05), transparent 60%),
        var(--bg);
      background-image:
        linear-gradient(rgba(255,255,255,.012) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.012) 1px, transparent 1px),
        radial-gradient(1200px 800px at 70% -10%, rgba(108,194,74,.05), transparent 60%),
        radial-gradient(900px 700px at -10% 110%, rgba(61,108,199,.05), transparent 60%);
      background-size: 32px 32px, 32px 32px, auto, auto;
      background-color: var(--bg);
      overflow: hidden;
    }
    button { font-family: inherit; }
    input, textarea, select {
      font-family: inherit; color: inherit; background: transparent; border: 0; outline: 0;
    }
    ::selection { background: var(--accent-soft); color: #fff; }

    .app{ display:grid; grid-template-rows: 56px 1fr; height: 100vh; }
    .topbar{
      display:flex; align-items:center; gap: 20px; padding: 0 22px;
      border-bottom: 1px solid var(--line-soft);
      background: linear-gradient(180deg, rgba(255,255,255,.02), transparent 70%), var(--bg-2);
      position: relative; z-index: 5;
    }
    .brand{ display:flex; align-items:center; gap: 10px; font-weight: 600; letter-spacing: .02em; }
    .brand-mark{
      width: 26px; height: 26px; display: grid; place-items: center;
      background: var(--accent); color: #0a0d10;
      font-weight: 700; font-family: var(--font-mono); font-size: 13px;
      box-shadow: inset 1.5px 1.5px 0 rgba(255,255,255,.35), inset -1.5px -1.5px 0 rgba(0,0,0,.32);
    }
    .brand-name{ font-size: 14px; }
    .brand-name b{ font-weight: 700; }
    .brand-sep{ width:1px; height:18px; background: var(--line); margin: 0 4px; }
    .brand-sub{ font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); letter-spacing: .02em; }

    .topnav{ display:flex; gap: 4px; margin-left: auto; }
    .topnav a{ padding: 7px 12px; font-size: 13px; color: var(--ink-2); text-decoration:none; border-radius: 6px; }
    .topnav a:hover{ color: var(--ink); background: var(--panel); }
    .topnav a.active{ color: var(--ink); }

    .stats{
      display:flex; align-items:center; gap: 14px; padding-left: 16px; margin-left: 8px;
      border-left: 1px solid var(--line-soft);
      font-size: 11px; color: var(--ink-3); letter-spacing: .04em; text-transform: uppercase;
    }
    .stats b{ color: var(--ink); font-family: var(--font-mono); font-weight: 600; }

    .main{
      display:grid; grid-template-columns: 280px minmax(0, 1fr) 400px;
      min-height: 0; overflow: hidden;
    }
    @media (max-width: 1280px){ .main{ grid-template-columns: 240px minmax(0,1fr) 340px; } }
    @media (max-width: 1080px){
      .main{ grid-template-columns: 220px minmax(0,1fr) 320px; }
      .builder{ padding: 18px 18px 60px !important; }
      .field-row{ grid-template-columns: 110px 1fr !important; gap: 10px !important; }
    }
    .pane{ display:flex; flex-direction: column; min-height: 0; min-width: 0; overflow: hidden; }
    .pane + .pane{ border-left: 1px solid var(--line-soft); }
    .pane-hd{
      display:flex; align-items:center; gap: 8px; padding: 14px 18px;
      font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
      color: var(--ink-3); border-bottom: 1px solid var(--line-soft); flex-shrink: 0;
    }
    .pane-hd .count{ color: var(--ink-4); font-family: var(--font-mono); letter-spacing: 0; font-weight: 500; margin-left: auto; text-transform: none; }
    .pane-body{ flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
    .pane-body::-webkit-scrollbar{ width: 10px; }
    .pane-body::-webkit-scrollbar-thumb{ background: var(--line); border: 3px solid transparent; background-clip: content-box; border-radius: 6px; }

    .sidebar-search{ position: relative; padding: 10px 14px; border-bottom: 1px solid var(--line-soft); }
    .sidebar-search input{
      width: 100%; background: var(--panel); border: 1px solid var(--line-soft);
      border-radius: 8px; padding: 8px 10px 8px 30px; font-size: 13px; color: var(--ink);
    }
    .sidebar-search input::placeholder{ color: var(--ink-4); }
    .sidebar-search input:focus{ border-color: var(--accent-line); box-shadow: 0 0 0 3px var(--accent-soft); }
    .sidebar-search svg{ position: absolute; left: 22px; top: 50%; transform: translateY(-50%); color: var(--ink-3); }

    .plugin-group{ padding: 12px 8px 6px; }
    .plugin-group + .plugin-group{ border-top: 1px solid var(--line-soft); margin-top: 6px; padding-top: 14px; }
    .plugin-group h4{
      margin: 0 10px 6px; font-size: 10px; font-weight: 600; letter-spacing: .14em;
      text-transform: uppercase; color: var(--ink-4);
    }
    .plugin{
      display:flex; align-items:center; gap: 10px; padding: 8px 10px;
      border-radius: 8px; cursor: default; font-size: 13px; color: var(--ink-2); position: relative;
    }
    .plugin:hover{ background: var(--panel); color: var(--ink); }
    .plugin.active{ background: var(--accent-soft); color: var(--accent-ink); box-shadow: inset 0 0 0 1px var(--accent-line); }
    .plugin .dot{
      width: 8px; height: 8px; background: var(--plugin-color, var(--accent));
      box-shadow: inset 1px 1px 0 rgba(255,255,255,.35), inset -1px -1px 0 rgba(0,0,0,.32);
    }
    .plugin .pname{ flex: 1; }
    .plugin .pcount{ font-family: var(--font-mono); font-size: 11px; color: var(--ink-4); }
    .plugin.active .pcount{ color: var(--accent-ink); opacity: .7; }

    .cmd-list{ padding: 8px 8px 24px; }
    .cmd{ display:flex; align-items:center; gap: 10px; padding: 7px 10px; border-radius: 8px; cursor: default; }
    .cmd:hover{ background: var(--panel); }
    .cmd.active{ background: var(--panel-2); box-shadow: inset 0 0 0 1px var(--line); }
    .cmd-name{ font-family: var(--font-mono); font-size: 12.5px; color: var(--ink); letter-spacing: -0.01em; }
    .cmd-name .slash{ color: var(--accent); }
    .cmd-name .ess{ color: var(--lapis); }
    .cmd-name .we{ color: var(--gold); }
    .cmd-desc{ font-size: 11px; color: var(--ink-4); margin-top: 2px; line-height: 1.35; }
    .cmd .col{ flex: 1; min-width: 0; overflow: hidden; }
    .cmd-tag{ font-family: var(--font-mono); font-size: 10px; color: var(--ink-4); padding: 2px 5px; border: 1px solid var(--line-soft); border-radius: 4px; }

    .builder{ padding: 24px 28px 60px; }
    .cmd-title{
      display:flex; align-items: flex-start; gap: 14px;
      padding-bottom: 18px; border-bottom: 1px solid var(--line-soft); flex-wrap: wrap;
    }
    .cmd-title > div:nth-child(2){ min-width: 0; flex: 1 1 240px; }
    .cmd-title .icon{
      width: 44px; height: 44px; display:grid; place-items:center; background: var(--panel);
      box-shadow: inset 2px 2px 0 rgba(255,255,255,.04), inset -2px -2px 0 rgba(0,0,0,.4), 0 0 0 1px var(--line);
      font-family: var(--font-mono); font-size: 18px; color: var(--accent);
    }
    .cmd-title h1{
      margin: 0; font-family: var(--font-mono); font-size: 22px;
      letter-spacing: -0.01em; font-weight: 600; word-break: break-word;
    }
    .cmd-title h1 .slash{ color: var(--accent); }
    .cmd-title p{
      margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px; line-height: 1.5;
      max-width: 56ch; text-wrap: pretty;
    }
    .cmd-meta{ margin-left: auto; display:flex; gap: 8px; flex-shrink: 0; flex-wrap: wrap; }
    .tag{
      display:inline-flex; align-items:center; gap: 6px; padding: 4px 8px;
      font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase;
      color: var(--ink-3); border: 1px solid var(--line-soft); border-radius: 4px; font-weight: 500;
    }
    .tag.op{ color: var(--gold); border-color: rgba(247,201,72,.28); background: rgba(247,201,72,.05); }
    .tag.we{ color: var(--gold); border-color: rgba(247,201,72,.28); }
    .tag.ess{ color: var(--lapis); border-color: rgba(61,108,199,.28); }

    .form{ padding-top: 22px; display: grid; gap: 18px; }
    .field{ display:grid; gap: 8px; }
    .field-row{ display:grid; grid-template-columns: 130px 1fr; gap: 16px; align-items: start; }
    .field-label{
      font-size: 11.5px; color: var(--ink-3); letter-spacing: .04em;
      text-transform: uppercase; padding-top: 11px; font-weight: 600;
    }
    .field-label .req{ color: var(--accent); }
    .field-label .opt{
      display:block; text-transform: none; letter-spacing: 0; font-size: 11px;
      color: var(--ink-4); font-weight: 400; margin-top: 3px;
    }
    .input, .select, .textarea{
      width: 100%; background: var(--panel); border: 1px solid var(--line-soft);
      border-radius: 8px; padding: 10px 12px; font-size: 13.5px;
      font-family: var(--font-mono); color: var(--ink);
      transition: border-color .12s, box-shadow .12s;
    }
    .input:hover, .select:hover, .textarea:hover{ border-color: var(--line); }
    .input:focus, .select:focus, .textarea:focus{ border-color: var(--accent-line); box-shadow: 0 0 0 3px var(--accent-soft); }
    .input::placeholder, .textarea::placeholder{ color: var(--ink-4); }
    .textarea{ min-height: 80px; resize: vertical; }
    .input-row{ display:flex; gap: 8px; align-items: stretch; }
    .input-row > .input, .input-row > .select{ flex:1; min-width: 0; }

    .seg{ display:inline-flex; background: var(--panel); border: 1px solid var(--line-soft); border-radius: 8px; padding: 3px; gap: 2px; align-self: start; }
    .seg button{ appearance:none; border: 0; background: transparent; color: var(--ink-2); padding: 6px 12px; font-size: 12.5px; border-radius: 5px; font-family: var(--font-mono); letter-spacing: -0.005em; }
    .seg button:hover{ color: var(--ink); }
    .seg button.active{ background: var(--panel-3); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }

    .stepper{ display:inline-flex; background: var(--panel); border: 1px solid var(--line-soft); border-radius: 8px; align-self: start; align-items: center; overflow: hidden; }
    .stepper button{ appearance:none; border:0; background: transparent; color: var(--ink-2); width: 34px; height: 36px; font-size: 16px; cursor: default; }
    .stepper button:hover{ background: var(--panel-2); color: var(--ink); }
    .stepper input{ width: 60px; text-align:center; font-family: var(--font-mono); font-size: 13.5px; height: 36px; background: transparent; }

    .coords{ display:grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .coord{ display:flex; align-items: center; background: var(--panel); border: 1px solid var(--line-soft); border-radius: 8px; overflow: hidden; }
    .coord:focus-within{ border-color: var(--accent-line); box-shadow: 0 0 0 3px var(--accent-soft); }
    .coord-axis{
      width: 32px; display:grid; place-items:center; font-family: var(--font-mono);
      font-size: 12px; color: var(--ink-3); background: var(--panel-2);
      border-right: 1px solid var(--line-soft); height: 38px; font-weight: 600;
    }
    .coord-axis.x{ color: #e57373; }
    .coord-axis.y{ color: #aed581; }
    .coord-axis.z{ color: #64b5f6; }
    .coord input{ flex:1; min-width: 0; padding: 0 10px; font-family: var(--font-mono); font-size: 13px; color: var(--ink); }
    .coord-mode{ display:flex; gap: 0; border-left: 1px solid var(--line-soft); }
    .coord-mode button{ appearance:none; border:0; width: 28px; height: 38px; background: transparent; color: var(--ink-4); font-family: var(--font-mono); font-size: 13px; cursor: default; }
    .coord-mode button.active{ color: var(--accent); background: var(--accent-soft); }

    .itemslot{
      display:flex; align-items:center; gap: 12px; padding: 10px;
      background: var(--panel); border: 1px solid var(--line-soft);
      border-radius: 8px; cursor: default; width: 100%; text-align: left;
    }
    .itemslot:hover{ border-color: var(--line); background: var(--panel-2); }
    .itemslot:focus-visible{ border-color: var(--accent-line); box-shadow: 0 0 0 3px var(--accent-soft); }
    .itemslot .frame{
      width: 44px; height: 44px; background: #0a0d10; display:grid; place-items:center;
      box-shadow: inset 1.5px 1.5px 0 rgba(0,0,0,.4), inset -1.5px -1.5px 0 rgba(255,255,255,.04), 0 0 0 1px var(--line-soft);
      flex-shrink: 0;
    }
    .itemslot .name{ font-family: var(--font-mono); font-size: 13px; color: var(--ink); }
    .itemslot .ns{ color: var(--ink-4); }
    .itemslot .ph{ color: var(--ink-4); font-family: var(--font-mono); font-size: 13px; }
    .itemslot .arrow{ margin-left:auto; color: var(--ink-4); }

    .chips{ display:flex; flex-wrap:wrap; gap: 6px; }
    .chip{
      display:inline-flex; align-items:center; gap: 6px; padding: 5px 9px;
      font-family: var(--font-mono); font-size: 12px; background: var(--panel);
      border: 1px solid var(--line-soft); border-radius: 6px; color: var(--ink-2); cursor: default;
    }
    .chip:hover{ color: var(--ink); border-color: var(--line); }
    .chip.active{ color: var(--accent-ink); background: var(--accent-soft); border-color: var(--accent-line); }
    .chip .x{ color: var(--ink-4); width: 14px; height: 14px; display:grid; place-items:center; border-radius: 3px; }
    .chip .x:hover{ color: var(--ink); background: rgba(255,255,255,.06); }

    .tr-builder{ background: var(--panel); border: 1px solid var(--line-soft); border-radius: 10px; padding: 14px; display: grid; gap: 12px; }
    .tr-segment{ display:grid; grid-template-columns: auto 1fr auto; gap: 8px; align-items:center; padding: 8px; background: var(--panel-2); border: 1px solid var(--line-soft); border-radius: 8px; }
    .tr-segment input{ font-family: var(--font-mono); font-size: 13px; padding: 6px 8px; background: transparent; }
    .tr-color-swatch{ width: 28px; height: 28px; border-radius: 4px; cursor: default; box-shadow: inset 1.5px 1.5px 0 rgba(255,255,255,.18), inset -1.5px -1.5px 0 rgba(0,0,0,.4); }
    .tr-format{ display:flex; gap: 4px; }
    .tr-format button{ appearance:none; border:0; width: 28px; height: 28px; background: var(--panel-3); color: var(--ink-3); border-radius: 4px; font-family: var(--font-mono); font-size: 13px; cursor: default; }
    .tr-format button.on{ color: var(--accent); background: var(--accent-soft); }
    .tr-format button:hover{ color: var(--ink); }
    .tr-preview{
      background: #1a1a1a;
      background-image: repeating-linear-gradient(0deg, rgba(0,0,0,.15) 0 2px, transparent 2px 4px);
      border: 1px solid #000; border-radius: 4px; padding: 12px 14px;
      font-family: var(--font-mono); font-size: 14px; line-height: 1.45;
      color: #fff; text-shadow: 2px 2px 0 #2a2a2a;
    }
    .tr-color-grid{ display:grid; grid-template-columns: repeat(8, 1fr); gap: 4px; padding: 4px; }
    .tr-color-grid button{ appearance:none; border:0; height: 28px; border-radius: 3px; cursor: default; position: relative; box-shadow: inset 1.5px 1.5px 0 rgba(255,255,255,.18), inset -1.5px -1.5px 0 rgba(0,0,0,.4); }
    .tr-color-grid button.on::after{ content:""; position:absolute; inset: 4px; border: 2px solid #fff; border-radius: 2px; }

    .btn{
      appearance:none; border:0; display:inline-flex; align-items:center; gap: 8px;
      padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 500;
      cursor: default; font-family: var(--font-sans);
      background: var(--panel); color: var(--ink); border: 1px solid var(--line-soft);
    }
    .btn:hover{ background: var(--panel-2); border-color: var(--line); }
    .btn-primary{
      background: var(--accent); color: #0a0d10; border: 0; font-weight: 600;
      box-shadow: inset 1px 1px 0 rgba(255,255,255,.28), inset -1px -1px 0 rgba(0,0,0,.18), 0 0 0 1px rgba(0,0,0,.2), 0 8px 22px -8px var(--accent-line);
    }
    .btn-primary:hover{ filter: brightness(1.06); }
    .btn-ghost{ background: transparent; border-color: transparent; color: var(--ink-3); }
    .btn-ghost:hover{ background: var(--panel); color: var(--ink); border-color: var(--line-soft); }

    .preview-pane{ display:flex; flex-direction:column; background: linear-gradient(180deg, var(--bg-2), var(--bg)); }
    .preview-body{ padding: 18px; flex: 1; overflow-y: auto; }
    .preview-card{ background: var(--panel); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); }
    .preview-card-hd{
      display:flex; align-items:center; gap: 8px; padding: 10px 14px;
      border-bottom: 1px solid var(--line-soft); background: var(--panel-2);
      font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
      color: var(--ink-3); font-weight: 600;
    }
    .preview-card-hd .lights{ display:flex; gap: 4px; }
    .preview-card-hd .lights span{ width: 6px; height: 6px; border-radius: 50%; background: var(--ink-4); }
    .preview-card-hd .lights span:nth-child(1){ background: #e0463c; }
    .preview-card-hd .lights span:nth-child(2){ background: var(--gold); }
    .preview-card-hd .lights span:nth-child(3){ background: var(--accent); }
    .preview-cmd{
      padding: 18px 18px; font-family: var(--font-mono); font-size: 14px; line-height: 1.6;
      color: var(--ink); word-break: break-all; white-space: pre-wrap;
      min-height: 140px; letter-spacing: -0.005em;
    }
    .tk-slash{ color: var(--accent); }
    .tk-cmd{ color: #e0e6ec; font-weight: 600; }
    .tk-sel{ color: var(--diamond); }
    .tk-ns{ color: #8aa3b8; }
    .tk-id{ color: #d6e2ee; }
    .tk-num{ color: #f7c948; }
    .tk-str{ color: #aed581; }
    .tk-coord{ color: #ffa07a; }
    .tk-tilde{ color: var(--ink-3); }
    .tk-nbt{ color: #b39ddb; }
    .tk-key{ color: #b39ddb; }
    .tk-punc{ color: var(--ink-3); }
    .tk-ph{ color: var(--ink-4); font-style: italic; }

    .preview-actions{ display:flex; gap: 8px; padding: 12px 18px; border-top: 1px solid var(--line-soft); background: var(--panel-2); }
    .preview-actions .btn-primary{ flex: 1; justify-content: center; }
    .preview-section{ margin-top: 22px; }
    .preview-section h3{ margin: 0 0 10px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); display:flex; align-items:center; justify-content: space-between; }
    .preview-section h3 .clear{ font-size: 11px; letter-spacing: 0; text-transform:none; color: var(--ink-4); cursor: default; }
    .preview-section h3 .clear:hover{ color: var(--ink-2); }
    .history-item{
      display:grid; grid-template-columns: 1fr auto; gap: 8px;
      padding: 10px 12px; background: var(--panel); border: 1px solid var(--line-soft);
      border-radius: 8px; margin-bottom: 6px; font-family: var(--font-mono);
      font-size: 12px; color: var(--ink-2); align-items:center;
    }
    .history-item:hover{ background: var(--panel-2); border-color: var(--line); }
    .history-item .ago{ color: var(--ink-4); font-size: 11px; }
