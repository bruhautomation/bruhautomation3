    .picker-fd .selected-name{ color: var(--ink); }
    .picker-fd .right{ margin-left: auto; display:flex; gap: 12px; align-items:center; }

    .toast{
      position: fixed; bottom: 24px; left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--panel-3); border: 1px solid var(--line); border-radius: 999px;
      padding: 10px 18px 10px 14px; display:flex; align-items:center; gap: 10px;
