function WeSetBuilder({ state, set }) {
  const updateRow = (i, patch) => set({ pattern: state.pattern.map((r, idx) => idx === i ? { ...r, ...patch } : r) });
  const removeRow = (i) => set({ pattern: state.pattern.filter((_, idx) => idx !== i) });
  const addRow = () => set({ pattern: [...state.pattern, { block: 'stone', weight: 25 }] });
