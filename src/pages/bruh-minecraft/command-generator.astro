    .pattern-rows{ display:grid; gap: 8px; }
    .pattern-row{ display:grid; grid-template-columns: 70px 1fr 60px auto; gap: 8px; align-items: center; padding: 8px; background: var(--panel); border: 1px solid var(--line-soft); border-radius: 8px; }
