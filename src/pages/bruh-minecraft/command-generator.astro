    .picker-shroud{ position: fixed; inset: 0; background: rgba(5, 8, 11, 0.75); backdrop-filter: blur(8px); z-index: 100; display: grid; place-items: center; padding: 40px; }
    .picker{ width: min(900px, 96vw); height: min(680px, 90vh); background: var(--panel); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 30px 80px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.02); display: flex; flex-direction: column; overflow: hidden; }
    .picker-hd{ display:flex; align-items:center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line-soft); }
    .picker-hd h2{ margin: 0; font-size: 16px; font-weight: 600; }
    .picker-hd .esc{ margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); border: 1px solid var(--line); padding: 3px 7px; border-radius: 4px; }
    .picker-search{ position: relative; padding: 10px 18px; border-bottom: 1px solid var(--line-soft); }
    .picker-search input{ width: 100%; background: var(--bg); border: 1px solid var(--line-soft); border-radius: 8px; padding: 10px 12px 10px 36px; font-size: 14px; font-family: var(--font-mono); color: var(--ink); }
    .picker-search input:focus{ border-color: var(--accent-line); box-shadow: 0 0 0 3px var(--accent-soft); }
    .picker-search svg{ position: absolute; left: 30px; top: 50%; transform: translateY(-50%); color: var(--ink-3); }
    .picker-cats{ display:flex; gap: 4px; padding: 10px 18px; border-bottom: 1px solid var(--line-soft); overflow-x: auto; scrollbar-width: none; }
    .picker-cats::-webkit-scrollbar{ display: none; }
    .picker-cats button{ appearance:none; border:0; padding: 6px 12px; background: transparent; color: var(--ink-3); font-size: 12px; border-radius: 6px; white-space: nowrap; cursor: default; font-weight: 500; letter-spacing: .02em; }
    .picker-cats button:hover{ color: var(--ink); background: var(--panel-2); }
    .picker-cats button.active{ color: var(--ink); background: var(--panel-3); }
    .picker-grid{ flex: 1; padding: 16px 18px; display: grid; grid-template-columns: repeat(auto-fill, minmax(76px, 1fr)); gap: 8px; align-content: start; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
    .picker-tile{ appearance:none; border:0; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 10px 4px 8px; background: transparent; border-radius: 8px; cursor: default; font-size: 10.5px; color: var(--ink-3); text-align: center; line-height: 1.2; }
    .picker-tile .tile{ width: 44px; height: 44px; }
