  <script is:inline type="text/babel" data-presets="react">
// ── App ─────────────────────────────────────────────────────────────
const { useState, useEffect, useMemo, useRef } = React;

function App() {
  const [activePlugin, setActivePlugin] = useState('vanilla');
  const [activeCmdId, setActiveCmdId] = useState('give');
  const [search, setSearch] = useState('');

  const visibleCmds = useMemo(() =>
    COMMANDS.filter(c => {
      if (activePlugin && c.plugin !== activePlugin) return false;
      if (search && !c.name.toLowerCase().includes(search.toLowerCase()) && !c.desc.toLowerCase().includes(search.toLowerCase())) return false;
      return true;
    }), [activePlugin, search]);

  const activeCmd = COMMANDS.find(c => c.id === activeCmdId) || COMMANDS[0];
  const plugin = PLUGINS.find(p => p.id === activeCmd.plugin);

  const [stateCache, setStateCache] = useState({});
  const cmdState = stateCache[activeCmd.id] || getDefaults(activeCmd);
  const setCmdState = (patch) => setStateCache({ ...stateCache, [activeCmd.id]: { ...cmdState, ...patch } });

  const built = buildCommand(activeCmd, cmdState);

  const [toast, setToast] = useState({ on: false, msg: '' });
  const [history, setHistory] = useState([
    { cmd: '/give @p minecraft:diamond_sword 1', when: '2m ago' },
    { cmd: '/effect give @a minecraft:speed 30 1', when: '5m ago' },
    { cmd: '/weather clear', when: '12m ago' },
  ]);
  const toastTimer = useRef(null);

  const flashToast = (msg) => {
    setToast({ on: true, msg });
    clearTimeout(toastTimer.current);
    toastTimer.current = setTimeout(() => setToast({ on: false, msg }), 1800);
  };

  const copyCommand = async () => {
    try { await navigator.clipboard.writeText(built); } catch (e) {}
    setHistory([{ cmd: built, when: 'just now' }, ...history.slice(0, 6)]);
    flashToast('Copied to clipboard');
  };

  const Builder = useMemo(() => {
    const B = getBuilder(activeCmd);
    if (B) return (props) => <B {...props} />;
    if (activeCmd.kind === 'simple') return (props) => <SimpleBuilder {...props} def={activeCmd} />;
    if (activeCmd.kind === 'schema') return (props) => <SchemaBuilder {...props} def={activeCmd} />;
    if (activeCmd.kind === 'unlock') return (props) => <UnlockBuilder {...props} />;
    return () => <div style={{ color: 'var(--ink-3)' }}>No builder yet.</div>;
  }, [activeCmd]);

  const totalCmds = COMMANDS.length;
  const totalRegistry = BLOCKS.length + ITEMS.length + MOBS.length;

  return (
    <div className="app">
      <TopBar totalCmds={totalCmds} totalPlugins={PLUGINS.length} totalRegistry={totalRegistry} />
      <div className="main">
        <Sidebar
          activePlugin={activePlugin}
          setActivePlugin={(id) => { setActivePlugin(id); const first = COMMANDS.find(c => c.plugin === id); if (first) setActiveCmdId(first.id); }}
          activeCmdId={activeCmdId}
          setActiveCmdId={setActiveCmdId}
          visibleCmds={visibleCmds}
          search={search}
          setSearch={setSearch}
        />
        <div className="pane">
          <div className="builder">
            <CommandHeader cmd={activeCmd} plugin={plugin} />
            <Builder state={cmdState} set={setCmdState} />
          </div>
        </div>
        <PreviewPane built={built} history={history} setHistory={setHistory} onCopy={copyCommand} />
      </div>
      <Toast on={toast.on} msg={toast.msg} />
    </div>
  );
}

function TopBar({ totalCmds, totalPlugins, totalRegistry }) {
  return (
    <div className="topbar">
      <div className="brand">
        <div className="brand-mark">B</div>
        <div className="brand-name"><b>BRUH</b> Automation</div>
        <div className="brand-sep" />
        <div className="brand-sub">Command Builder</div>
      </div>
      <nav className="topnav">
        <a href="/bruh-minecraft/">Add-on</a>
        <a href="/bruh-minecraft/reference/">Reference</a>
        <a href="#" className="active">Commands</a>
        <a href="https://github.com/bruhautomation/BRUH-HA-Apps" target="_blank" rel="noopener">GitHub</a>
      </nav>
      <div className="stats">
        <span><b>{totalCmds}</b> commands</span>
        <span><b>{totalPlugins}</b> plugins</span>
        <span><b>{totalRegistry}</b> registry</span>
      </div>
    </div>
  );
}

function Sidebar({ activePlugin, setActivePlugin, activeCmdId, setActiveCmdId, visibleCmds, search, setSearch }) {
  return (
    <div className="pane">
      <div className="pane-hd">Plugins <span className="count">{PLUGINS.length}</span></div>
      <div className="sidebar-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
        <input placeholder="Search commands…" value={search} onChange={(e) => setSearch(e.target.value)} />
      </div>
      <div className="pane-body">
        <div className="plugin-group">
          {PLUGINS.map(p => (
            <div key={p.id} className={`plugin ${activePlugin === p.id ? 'active' : ''}`} onClick={() => setActivePlugin(p.id)} style={{ '--plugin-color': p.color }}>
              <span className="dot" />
              <span className="pname">{p.name}</span>
              <span className="pcount">{p.count}</span>
            </div>
          ))}
        </div>
        <div className="plugin-group">
          <h4>Commands · {PLUGINS.find(p => p.id === activePlugin)?.name}</h4>
          <div className="cmd-list">
            {visibleCmds.map(c => {
              const slashClass = c.name.startsWith('//') ? 'we' : c.plugin === 'essentials' ? 'ess' : 'slash';
              const slashLen = c.name.startsWith('//') ? 2 : 1;
              return (
                <div key={c.id} className={`cmd ${activeCmdId === c.id ? 'active' : ''}`} onClick={() => setActiveCmdId(c.id)}>
                  <div className="col">
                    <div className="cmd-name">
                      <span className={slashClass}>{c.name.slice(0, slashLen)}</span>
                      {c.name.slice(slashLen)}
                    </div>
                    <div className="cmd-desc">{c.desc}</div>
                  </div>
                  <span className="cmd-tag">{c.tag}</span>
                </div>
              );
            })}
            {visibleCmds.length === 0 && (
              <div style={{ padding: 16, fontSize: 12, color: 'var(--ink-4)' }}>No commands match.</div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

function CommandHeader({ cmd, plugin }) {
  const slashLen = cmd.name.startsWith('//') ? 2 : 1;
  return (
    <div className="cmd-title">
      <div className="icon">{cmd.name.slice(0, slashLen)}</div>
      <div style={{ flex: 1, minWidth: 0 }}>
        <h1>
          <span className="slash">{cmd.name.slice(0, slashLen)}</span>
          {cmd.name.slice(slashLen)}
        </h1>
        <p>{cmd.desc}. {longDesc(cmd.id)}</p>
      </div>
      <div className="cmd-meta">
        <span className={`tag ${cmd.tag === 'OP' ? 'op' : cmd.tag === 'WE' ? 'we' : cmd.tag === 'ESS' ? 'ess' : ''}`}>{plugin?.name}</span>
        <span className="tag op">Requires OP</span>
      </div>
    </div>
  );
}

function longDesc(id) {
  const m = {
    give: 'Grants the target player a stack of items, optionally with custom NBT for enchantments, lore, or display name.',
    summon: 'Spawns an entity at the chosen position with optional NBT for naming, scaling, or attributes.',
    tp: 'Teleports one or more entities to a position or another entity. Use ~ for relative or ^ for local axes.',
    effect: 'Applies or clears a status effect. Duration is in seconds; amplifier 0 = level I.',
    weather: 'Sets the weather for the current dimension. Duration is optional.',
    time: 'Sets, adds to, or queries the world time. 24,000 ticks make one in-game day.',
    tellraw: 'Sends formatted JSON text to a player or every player. Build colored, bold, italic segments below.',
    we_set: 'Fills your selection cuboid with a single block or weighted multi-block pattern.',
    we_replace: 'Replaces matching blocks within your selection with the destination pattern.',
    gamemode: 'Switches a player between Survival, Creative, Adventure, or Spectator mode.',
    kill: 'Kills entities matching the selector. Use predicates to target carefully.',
    fill: 'Fills a cuboid between two corners with a block, with several modes for handling existing blocks.',
  };
  return m[id] || '';
}

function PreviewPane({ built, history, setHistory, onCopy }) {
  return (
    <div className="pane preview-pane">
      <div className="pane-hd">Live Preview <span className="count">RCON · Console · Block</span></div>
      <div className="preview-body">
        <div className="preview-card">
          <div className="preview-card-hd">
            <div className="lights"><span /><span /><span /></div>
            <span>console</span>
            <span style={{ marginLeft: 'auto', color: 'var(--ink-4)', fontFamily: 'var(--font-mono)' }}>{built.length} chars</span>
          </div>
          <div className="preview-cmd">
            {built.includes('\n')
              ? built.split('\n').map((line, i) => (
                  <div key={i} style={line.startsWith('#') ? { color: 'var(--ink-4)', fontStyle: 'italic' } : {}}>
                    {line.startsWith('#') ? line : tokenize(line)}
                  </div>
                ))
              : tokenize(built)}
          </div>
          <div className="preview-actions">
            <button className="btn btn-primary" onClick={onCopy}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy command
            </button>
            <button className="btn" title="Run via BRUH RCON">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Run
            </button>
          </div>
        </div>
        <div className="preview-section">
          <h3>Recent {history.length > 0 && <span className="clear" onClick={() => setHistory([])}>Clear</span>}</h3>
          {history.length === 0 ? (
            <div style={{ fontSize: 12, color: 'var(--ink-4)', padding: 12, textAlign: 'center', border: '1px dashed var(--line-soft)', borderRadius: 8 }}>Copied commands appear here.</div>
          ) : history.map((h, i) => (
            <div key={i} className="history-item">
              <div className="row1">{h.cmd}</div>
              <div className="ago">{h.when}</div>
            </div>
          ))}
        </div>
        <div className="preview-section">
          <h3>Where to run</h3>
          <div className="where-card">
            <ul>
              <li>BRUH panel <b>Console</b> tab</li>
              <li>RCON via <code>bruh_minecraft.rcon_command</code></li>
              <li>Command block (paste without leading <code>/</code>)</li>
              <li>In-game (you must be op — set <code>allow_cheats: true</code>)</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
