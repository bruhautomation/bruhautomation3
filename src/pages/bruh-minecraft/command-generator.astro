  const B = getBuilder(cmd);
  if (B) return B.build(state);
  if (cmd.kind === 'simple') return SimpleBuilder.buildFor(state, cmd);
  if (cmd.kind === 'schema' && window.SchemaBuilder) return window.SchemaBuilder.buildFor(state, cmd);
  if (cmd.kind === 'unlock' && window.UnlockBuilder) return window.UnlockBuilder.build(state);
  return cmd.name;
}
