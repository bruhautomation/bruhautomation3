  <script is:inline type="text/babel" data-presets="react">
// ── components ──────────────────────────────────────────────────────
const { useState, useEffect, useRef, useMemo, useCallback } = React;

function Tile({ cls, size, style }) {
  const sz = size === 'sm' ? 'sm' : size === 'lg' ? 'lg' : '';
  return <div className={`tile ${cls || ''} ${sz}`} style={style} />;
}

function Toast({ msg, on }) {
  return (
    <div className={`toast ${on ? 'on' : ''}`}>
      <span className="check">✓</span>
      <span>{msg}</span>
    </div>
  );
}

function Picker({ kind, value, onPick, onClose }) {
  const dataset = kind === 'mob' ? MOBS : kind === 'item' ? [...BLOCKS, ...ITEMS] : BLOCKS;
  const cats = useMemo(() => {
    const set = new Set();
    dataset.forEach(d => set.add(d.cat));
    return ['all', ...set];
  }, [dataset]);

  const [q, setQ] = useState('');
  const [cat, setCat] = useState('all');
  const inputRef = useRef(null);

  useEffect(() => { inputRef.current?.focus(); }, []);
  useEffect(() => {
    const onKey = (e) => { if (e.key === 'Escape') onClose(); };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [onClose]);

  const filtered = dataset.filter(d => {
    if (cat !== 'all' && d.cat !== cat) return false;
    if (q && !d.name.toLowerCase().includes(q.toLowerCase()) && !d.id.includes(q.toLowerCase())) return false;
    return true;
  });

  const title = kind === 'mob' ? 'Pick an entity' : kind === 'item' ? 'Pick an item' : 'Pick a block';

  return (
    <div className="picker-shroud" onClick={(e) => { if (e.target === e.currentTarget) onClose(); }}>
      <div className="picker">
        <div className="picker-hd">
          <h2>{title}</h2>
          <span style={{ color: 'var(--ink-3)', fontSize: 12 }}>Click a tile to select</span>
          <span className="esc">Esc</span>
        </div>
        <div className="picker-search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
          <input ref={inputRef} value={q} onChange={(e) => setQ(e.target.value)} placeholder={`Search ${dataset.length} ${kind === 'mob' ? 'entities' : kind === 'item' ? 'items' : 'blocks'}…`} />
        </div>
        <div className="picker-cats">
          {cats.map(c => (
            <button key={c} className={cat === c ? 'active' : ''} onClick={() => setCat(c)}>
              {c === 'all' ? 'All' : c.charAt(0).toUpperCase() + c.slice(1)}
            </button>
          ))}
        </div>
        <div className="picker-grid">
          {filtered.map(d => (
            <button key={d.id} className={`picker-tile ${value === d.id ? 'selected' : ''}`} onClick={() => { onPick(d); onClose(); }}>
              <Tile cls={d.cls} />
              <span>{d.name}</span>
            </button>
          ))}
          {filtered.length === 0 && (
            <div style={{ gridColumn: '1/-1', textAlign: 'center', padding: 40, color: 'var(--ink-4)' }}>No matches.</div>
          )}
        </div>
        <div className="picker-fd">
          <span>{filtered.length} of {dataset.length}</span>
          <div className="right">
            <span><span className="kbd">↵</span> select</span>
            <span><span className="kbd">Esc</span> close</span>
          </div>
        </div>
      </div>
    </div>
  );
}

function Field({ label, opt, hint, children }) {
  return (
    <div className="field-row">
      <div className="field-label">
        {label}
        {opt && <span className="opt">{opt}</span>}
      </div>
      <div>
        {children}
        {hint && <div className="hint">{hint}</div>}
      </div>
    </div>
  );
}

function Seg({ value, options, onChange }) {
  return (
    <div className="seg">
      {options.map(o => {
        const v = typeof o === 'string' ? o : o.v;
        const l = typeof o === 'string' ? o : o.l;
        return (
          <button key={v} className={value === v ? 'active' : ''} onClick={() => onChange(v)}>{l}</button>
        );
      })}
    </div>
  );
}

function Stepper({ value, onChange, min = 0, max = 64, step = 1 }) {
  return (
    <div className="stepper">
      <button onClick={() => onChange(Math.max(min, value - step))}>−</button>
      <input
        value={value}
        onChange={(e) => {
          const n = parseInt(e.target.value, 10);
          if (!isNaN(n)) onChange(Math.min(max, Math.max(min, n)));
          else if (e.target.value === '') onChange(min);
        }}
      />
      <button onClick={() => onChange(Math.min(max, value + step))}>+</button>
    </div>
  );
}

function Coord({ axis, value, onChange }) {
  const mode = value.startsWith('^') ? '^' : value.startsWith('~') ? '~' : '';
  const num = value.replace(/^[~^]/, '');
  const setMode = (m) => onChange(m + num);
  const setNum = (n) => onChange(mode + n);
  return (
    <div className="coord">
      <div className={`coord-axis ${axis.toLowerCase()}`}>{axis}</div>
      <input value={num} placeholder="0" onChange={(e) => setNum(e.target.value.replace(/[^-0-9.]/g, ''))} />
      <div className="coord-mode">
        <button className={mode === '' ? 'active' : ''} onClick={() => setMode('')} title="Absolute">·</button>
        <button className={mode === '~' ? 'active' : ''} onClick={() => setMode('~')} title="Relative">~</button>
        <button className={mode === '^' ? 'active' : ''} onClick={() => setMode('^')} title="Local">^</button>
      </div>
    </div>
  );
}

function CoordPicker({ value, onChange }) {
  const [x, y, z] = value;
  return (
    <div className="coords">
      <Coord axis="X" value={x} onChange={(v) => onChange([v, y, z])} />
      <Coord axis="Y" value={y} onChange={(v) => onChange([x, v, z])} />
      <Coord axis="Z" value={z} onChange={(v) => onChange([x, y, v])} />
    </div>
  );
}

function SelectorBuilder({ value, onChange }) {
  const [open, setOpen] = useState(false);
  const [base, setBase] = useState('@p');
  const [predicates, setPredicates] = useState([]);

  const PRED_OPTIONS = [
    { id: 'distance', label: 'distance', placeholder: '..10' },
    { id: 'limit',    label: 'limit',    placeholder: '1' },
    { id: 'gamemode', label: 'gamemode', placeholder: 'survival' },
    { id: 'team',     label: 'team',     placeholder: 'red' },
    { id: 'tag',      label: 'tag',      placeholder: 'admin' },
    { id: 'name',     label: 'name',     placeholder: 'Steve' },
    { id: 'type',     label: 'type',     placeholder: 'player' },
    { id: 'level',    label: 'level',    placeholder: '5..' },
  ];

  useEffect(() => {
    if (predicates.length === 0) onChange(base);
    else onChange(`${base}[${predicates.map(p => `${p.id}=${p.value}`).join(',')}]`);
  }, [base, predicates]);

  const addPredicate = (id) => { setPredicates([...predicates, { id, value: '' }]); setOpen(false); };
  const updatePredicate = (i, v) => { const next = [...predicates]; next[i] = { ...next[i], value: v }; setPredicates(next); };
  const removePredicate = (i) => setPredicates(predicates.filter((_, idx) => idx !== i));

  return (
    <div style={{ display: 'grid', gap: 10 }}>
      <div className="chips">
        {SELECTORS.map(s => (
          <button key={s.v} className={`chip ${base === s.v ? 'active' : ''}`} onClick={() => setBase(s.v)} title={s.d}>
            {s.v} <span style={{ color: 'var(--ink-4)', fontFamily: 'var(--font-sans)', fontSize: 11 }}>{s.d}</span>
          </button>
        ))}
        <input className="input" style={{ flex: '1 0 160px', padding: '5px 9px', fontSize: 12 }} placeholder="…or @custom or username"
          value={base.startsWith('@') ? '' : base} onChange={(e) => setBase(e.target.value || '@p')} />
      </div>
      {predicates.length > 0 && (
        <div style={{ display: 'grid', gap: 6 }}>
          {predicates.map((p, i) => (
            <div key={i} style={{ display: 'grid', gridTemplateColumns: '110px 1fr auto', gap: 8, alignItems: 'center' }}>
              <div style={{ fontFamily: 'var(--font-mono)', fontSize: 12.5, color: 'var(--ink-2)', padding: '0 8px' }}>{p.id} =</div>
              <input className="input" style={{ padding: '6px 10px', fontSize: 12.5 }}
                placeholder={PRED_OPTIONS.find(o => o.id === p.id)?.placeholder}
                value={p.value} onChange={(e) => updatePredicate(i, e.target.value)} />
              <button className="btn btn-ghost" style={{ padding: '4px 8px' }} onClick={() => removePredicate(i)}>×</button>
            </div>
          ))}
        </div>
      )}
      <div style={{ position: 'relative' }}>
        <button className="btn btn-ghost" style={{ padding: '6px 10px', fontSize: 12 }} onClick={() => setOpen(!open)}>+ Add predicate</button>
        {open && (
          <div style={{ position: 'absolute', top: '100%', left: 0, marginTop: 4, zIndex: 10, background: 'var(--panel-2)', border: '1px solid var(--line)', borderRadius: 8, padding: 4, display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: 2, minWidth: 220, boxShadow: '0 12px 30px rgba(0,0,0,.4)' }}>
            {PRED_OPTIONS.filter(o => !predicates.some(p => p.id === o.id)).map(o => (
              <button key={o.id} className="btn btn-ghost" style={{ justifyContent: 'flex-start', fontFamily: 'var(--font-mono)', fontSize: 12 }} onClick={() => addPredicate(o.id)}>{o.label}</button>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

function ItemSlot({ kind, value, onChange, placeholder }) {
  const [open, setOpen] = useState(false);
  let item = null;
  if (value) {
    const ds = kind === 'mob' ? MOBS : kind === 'item' ? [...BLOCKS, ...ITEMS] : BLOCKS;
    item = ds.find(d => d.id === value);
  }
  return (
    <>
      <button className="itemslot" onClick={() => setOpen(true)}>
        <div className="frame">{item && <Tile cls={item.cls} />}</div>
        <div style={{ flex: 1 }}>
          {item ? (
            <div className="name"><span className="ns">minecraft:</span>{item.id}</div>
          ) : (
            <div className="ph">{placeholder || 'Click to pick…'}</div>
          )}
          {item && <div style={{ fontSize: 11.5, color: 'var(--ink-3)', marginTop: 2 }}>{item.name}</div>}
        </div>
        <div className="arrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="m6 9 6 6 6-6"/></svg>
        </div>
      </button>
      {open && (
        <Picker kind={kind} value={value} onPick={(d) => onChange(d.id)} onClose={() => setOpen(false)} />
      )}
    </>
  );
}

Object.assign(window, { Tile, Toast, Picker, Field, Seg, Stepper, Coord, CoordPicker, SelectorBuilder, ItemSlot });
  </script>

  <script is:inline type="text/babel" data-presets="react">
// ── builders + tokenizer ────────────────────────────────────────────
const { useState, useEffect, useMemo } = React;

function tokenize(cmd) {
  if (!cmd) return [<span key="ph" className="tk-ph">{`// build a command above`}</span>];
  const out = [];
  let i = 0; let key = 0;
  const consume = (re) => { re.lastIndex = i; const m = re.exec(cmd); if (m && m.index === i) { i += m[0].length; return m[0]; } return null; };

  if (cmd.startsWith('//')) { out.push(<span key={key++} className="tk-slash">//</span>); i = 2; }
  else if (cmd.startsWith('/')) { out.push(<span key={key++} className="tk-slash">/</span>); i = 1; }
  const cmdWord = consume(/[a-zA-Z_][a-zA-Z0-9_]*/g);
  if (cmdWord) out.push(<span key={key++} className="tk-cmd">{cmdWord}</span>);

  while (i < cmd.length) {
    const c = cmd[i];
    if (c === ' ') { out.push(' '); i++; continue; }
    if (c === '@') {
      let j = i + 1;
      while (j < cmd.length && /[a-zA-Z_]/.test(cmd[j])) j++;
      if (cmd[j] === '[') {
        let depth = 1; j++;
        while (j < cmd.length && depth > 0) { if (cmd[j] === '[') depth++; else if (cmd[j] === ']') depth--; j++; }
      }
      out.push(<span key={key++} className="tk-sel">{cmd.slice(i, j)}</span>);
      i = j; continue;
    }
    if (/[a-z_]/.test(c)) {
      let j = i;
      while (j < cmd.length && /[a-z0-9_]/.test(cmd[j])) j++;
      if (cmd[j] === ':') {
        const ns = cmd.slice(i, j);
        out.push(<span key={key++} className="tk-ns">{ns + ':'}</span>);
        i = j + 1;
        let k = i;
        while (k < cmd.length && /[a-z0-9_]/.test(cmd[k])) k++;
        out.push(<span key={key++} className="tk-id">{cmd.slice(i, k)}</span>);
        i = k;
        if (cmd[i] === '[') {
          let depth = 1; let m = i + 1;
          while (m < cmd.length && depth > 0) { if (cmd[m] === '[') depth++; else if (cmd[m] === ']') depth--; m++; }
          out.push(<span key={key++} className="tk-punc">{cmd.slice(i, m)}</span>);
          i = m;
        }
        continue;
      }
      out.push(<span key={key++} className="tk-id">{cmd.slice(i, j)}</span>);
      i = j; continue;
    }
    if (c === '~' || c === '^') {
      let j = i + 1;
      while (j < cmd.length && /[-0-9.]/.test(cmd[j])) j++;
      out.push(<span key={key++} className="tk-coord">{cmd.slice(i, j)}</span>);
      i = j; continue;
    }
    if (/[-0-9]/.test(c)) {
      let j = i; if (c === '-') j++;
      while (j < cmd.length && /[0-9.]/.test(cmd[j])) j++;
      out.push(<span key={key++} className="tk-num">{cmd.slice(i, j)}</span>);
      i = j; continue;
    }
    if (c === '"') {
      let j = i + 1;
      while (j < cmd.length && cmd[j] !== '"') { if (cmd[j] === '\\') j++; j++; }
      j = Math.min(cmd.length, j + 1);
      out.push(<span key={key++} className="tk-str">{cmd.slice(i, j)}</span>);
      i = j; continue;
    }
    if (c === '{') {
      let depth = 1; let j = i + 1;
      while (j < cmd.length && depth > 0) { if (cmd[j] === '{') depth++; else if (cmd[j] === '}') depth--; j++; }
      out.push(<span key={key++} className="tk-nbt">{cmd.slice(i, j)}</span>);
      i = j; continue;
    }
    out.push(<span key={key++} className="tk-punc">{c}</span>);
    i++;
  }
  return out;
}

function GiveBuilder({ state, set }) {
  const item = state.item || 'diamond_sword';
  return (
    <div className="form">
      <Field label="Target" opt="who receives the item">
        <SelectorBuilder value={state.selector} onChange={(v) => set({ selector: v })} />
      </Field>
      <Field label="Item" opt="block or item to give">
        <ItemSlot kind="item" value={item} onChange={(v) => set({ item: v })} placeholder="Pick a block or item…" />
      </Field>
      <Field label="Count" opt="1 – 64 (stack)">
        <Stepper value={state.count} onChange={(v) => set({ count: v })} min={1} max={64} />
      </Field>
      <Field label="NBT" opt="Optional · enchantments, display name, lore…">
        <textarea className="textarea"
          placeholder={`{display:{Name:'{"text":"Excalibur","color":"gold"}'},Enchantments:[{id:"sharpness",lvl:5}]}`}
          value={state.nbt || ''} onChange={(e) => set({ nbt: e.target.value })} />
      </Field>
    </div>
  );
}
GiveBuilder.defaults = { selector: '@p', item: 'diamond_sword', count: 1, nbt: '' };
GiveBuilder.build = (s) => {
  const item = s.item || 'diamond_sword';
  let cmd = `/give ${s.selector || '@p'} minecraft:${item} ${s.count || 1}`;
  if (s.nbt && s.nbt.trim()) cmd += ` ${s.nbt.trim()}`;
  return cmd;
};

function SummonBuilder({ state, set }) {
  return (
    <div className="form">
      <Field label="Entity" opt="mob to summon">
        <ItemSlot kind="mob" value={state.mob} onChange={(v) => set({ mob: v })} placeholder="Pick a mob…" />
      </Field>
      <Field label="Position" opt="~ relative · ^ local · plain absolute">
        <CoordPicker value={state.pos} onChange={(v) => set({ pos: v })} />
      </Field>
      <Field label="NBT" opt="Optional">
        <textarea className="textarea" placeholder={`{CustomName:'{"text":"Boss","color":"red"}',IsBaby:1b}`}
          value={state.nbt || ''} onChange={(e) => set({ nbt: e.target.value })} />
      </Field>
    </div>
  );
}
SummonBuilder.defaults = { mob: 'zombie', pos: ['~', '~', '~'], nbt: '' };
SummonBuilder.build = (s) => {
  const mob = s.mob || 'zombie';
  let cmd = `/summon minecraft:${mob} ${s.pos.join(' ')}`;
  if (s.nbt && s.nbt.trim()) cmd += ` ${s.nbt.trim()}`;
  return cmd;
};

function TpBuilder({ state, set }) {
  return (
    <div className="form">
      <Field label="Target" opt="entity(s) to teleport">
        <SelectorBuilder value={state.target} onChange={(v) => set({ target: v })} />
      </Field>
      <Field label="Mode">
        <Seg value={state.mode} options={[{ v: 'coords', l: 'To coordinates' }, { v: 'entity', l: 'To entity' }]} onChange={(v) => set({ mode: v })} />
      </Field>
      {state.mode === 'coords' ? (
        <Field label="Destination" opt="where to teleport">
          <CoordPicker value={state.pos} onChange={(v) => set({ pos: v })} />
        </Field>
      ) : (
        <Field label="Destination" opt="entity to teleport to">
          <input className="input" placeholder="@p / @r / username" value={state.dest} onChange={(e) => set({ dest: e.target.value })} />
        </Field>
      )}
    </div>
  );
}
TpBuilder.defaults = { target: '@p', mode: 'coords', pos: ['~', '~', '~'], dest: '@s' };
TpBuilder.build = (s) => {
  if (s.mode === 'coords') return `/tp ${s.target || '@p'} ${s.pos.join(' ')}`;
  return `/tp ${s.target || '@p'} ${s.dest || '@s'}`;
};

function EffectBuilder({ state, set }) {
  const [search, setSearch] = useState('');
  const filtered = EFFECTS.filter(e => e.name.toLowerCase().includes(search.toLowerCase()));
  return (
    <div className="form">
      <Field label="Action">
        <Seg value={state.action} options={[{ v: 'give', l: 'Give' }, { v: 'clear', l: 'Clear' }]} onChange={(v) => set({ action: v })} />
      </Field>
      <Field label="Target">
        <SelectorBuilder value={state.target} onChange={(v) => set({ target: v })} />
      </Field>
      <Field label="Effect">
        <input className="input" placeholder="Filter effects…" value={search} onChange={(e) => setSearch(e.target.value)} style={{ marginBottom: 10 }} />
        <div className="effect-grid">
          {filtered.map(e => (
            <div key={e.id} className={`effect-item ${state.effect === e.id ? 'active' : ''}`} onClick={() => set({ effect: e.id })}>
              <span className="swatch" style={{ '--c': e.c }}></span>{e.name}
            </div>
          ))}
        </div>
      </Field>
      {state.action === 'give' && (
        <>
          <Field label="Duration" opt="seconds (max 1,000,000)">
            <Stepper value={state.duration} onChange={(v) => set({ duration: v })} min={1} max={1000000} step={30} />
          </Field>
          <Field label="Amplifier" opt="0 = level I · 4 = level V">
            <Stepper value={state.amp} onChange={(v) => set({ amp: v })} min={0} max={255} />
          </Field>
          <Field label="Hide particles" opt="Optional">
            <Seg value={state.hide ? 'true' : 'false'} options={[{ v: 'false', l: 'Show' }, { v: 'true', l: 'Hide' }]} onChange={(v) => set({ hide: v === 'true' })} />
          </Field>
        </>
      )}
    </div>
  );
}
EffectBuilder.defaults = { action: 'give', target: '@p', effect: 'speed', duration: 30, amp: 0, hide: false };
EffectBuilder.build = (s) => {
  if (s.action === 'clear') return `/effect clear ${s.target || '@p'} minecraft:${s.effect}`;
  let cmd = `/effect give ${s.target || '@p'} minecraft:${s.effect} ${s.duration || 30} ${s.amp || 0}`;
  if (s.hide) cmd += ' true';
  return cmd;
};

function WeatherBuilder({ state, set }) {
  return (
    <div className="form">
      <Field label="Weather">
        <Seg value={state.kind} options={[{ v: 'clear', l: '☀ Clear' }, { v: 'rain', l: '☂ Rain' }, { v: 'thunder', l: '⚡ Thunder' }]} onChange={(v) => set({ kind: v })} />
      </Field>
      <Field label="Duration" opt="Optional · seconds">
        <input className="input" type="number" placeholder="leave empty for default" value={state.duration} onChange={(e) => set({ duration: e.target.value })} />
      </Field>
    </div>
  );
}
WeatherBuilder.defaults = { kind: 'clear', duration: '' };
WeatherBuilder.build = (s) => `/weather ${s.kind || 'clear'}${s.duration ? ' ' + s.duration : ''}`;

function TimeBuilder({ state, set }) {
  const presets = [
    { v: 'day', l: '🌅 Day', ticks: 1000 },
    { v: 'noon', l: '☀ Noon', ticks: 6000 },
    { v: 'night', l: '🌙 Night', ticks: 13000 },
    { v: 'midnight', l: '✦ Midnight', ticks: 18000 },
  ];
  return (
    <div className="form">
      <Field label="Action">
        <Seg value={state.action} options={[{ v: 'set', l: 'Set' }, { v: 'add', l: 'Add' }, { v: 'query', l: 'Query' }]} onChange={(v) => set({ action: v })} />
      </Field>
      {state.action !== 'query' && (
        <>
          <Field label="Preset" opt="quick values">
            <div className="chips">
              {presets.map(p => (
                <button key={p.v} className={`chip ${state.preset === p.v ? 'active' : ''}`} onClick={() => set({ preset: p.v, ticks: p.ticks })}>{p.l}</button>
              ))}
              <button className={`chip ${state.preset === 'custom' ? 'active' : ''}`} onClick={() => set({ preset: 'custom' })}>Custom</button>
            </div>
          </Field>
          <Field label="Ticks" opt="20 ticks per second · 24,000 = full day">
            <Stepper value={state.ticks} onChange={(v) => set({ ticks: v, preset: 'custom' })} min={0} max={24000} step={500} />
          </Field>
        </>
      )}
      {state.action === 'query' && (
        <Field label="Query type">
          <Seg value={state.query} options={['daytime', 'gametime', 'day']} onChange={(v) => set({ query: v })} />
        </Field>
      )}
    </div>
  );
}
TimeBuilder.defaults = { action: 'set', preset: 'day', ticks: 1000, query: 'daytime' };
TimeBuilder.build = (s) => {
  if (s.action === 'query') return `/time query ${s.query || 'daytime'}`;
  if (s.preset && s.preset !== 'custom') return `/time ${s.action} ${s.preset}`;
  return `/time ${s.action} ${s.ticks || 0}`;
};

function TellrawSegment({ seg, onChange, onRemove }) {
