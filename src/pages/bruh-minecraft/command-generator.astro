---
import {
  CATEGORIES,
  COMMANDS,
  UNLOCK_PRESETS,
  COMMON_BLOCKS,
  COMMON_ITEMS,
  COMMON_ENTITIES,
  COMMON_EFFECTS,
  COMMON_ENCHANTS,
  GAMERULES,
} from '../../data/minecraft-commands';
import logoLight from '../../assets/bruh-logo-light.svg';
import logoDark from '../../assets/bruh-logo-dark.svg';

const dataPayload = JSON.stringify({
  CATEGORIES,
  COMMANDS,
  UNLOCK_PRESETS,
  COMMON_BLOCKS,
  COMMON_ITEMS,
  COMMON_ENTITIES,
  COMMON_EFFECTS,
  COMMON_ENCHANTS,
  GAMERULES,
});

const totalCommands = COMMANDS.length;
const totalCategories = CATEGORIES.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Minecraft Command Generator — BRUH Automation</title>
    <meta
      name="description"
      content="Build any Minecraft console command for the BRUH Minecraft Server add-on. Vanilla + EssentialsX, LuckPerms, WorldEdit, WorldGuard, CoreProtect, Multiverse, GriefPrevention, mcMMO, ChestSort, VeinMiner, Spark, and ViaVersion — point, click, copy."
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BRUH Automation" />
    <meta property="og:title" content="Minecraft Command Generator" />
    <meta
      property="og:description"
      content="Click-to-build console commands for the BRUH Minecraft add-on. Every supported plugin, every permission, copy to clipboard."
    />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1e90ff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      (function () {
        var s = localStorage.getItem('starlight-theme');
        var t =
          s === 'light'
            ? 'light'
            : s === 'dark'
              ? 'dark'
              : matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>

    <style>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

      :root {
        --bg: #0b0d14;
        --bg-elev: #11141d;
        --bg-card: rgba(255, 255, 255, 0.04);
        --bg-card-solid: #14161e;
        --bg-input: rgba(255, 255, 255, 0.05);
        --bg-input-focus: rgba(30, 144, 255, 0.08);
        --border: rgba(255, 255, 255, 0.08);
        --border-strong: rgba(255, 255, 255, 0.16);
        --text: #e4e4e7;
        --text-muted: #8b8b97;
        --text-faint: #5a5a66;
        --accent: #1e90ff;
        --accent-2: #00d4ff;
        --accent-glow: rgba(30, 144, 255, 0.18);
        --success: #22c55e;
        --warning: #f59e0b;
        --danger: #ef4444;
        --code-bg: #0a0c12;
        --code-border: rgba(30, 144, 255, 0.18);
        --code-text: #e6e9ef;
        --code-cmd: #ffd166;
        --code-arg-required: #ef4444;
        --code-arg-filled: #5eead4;
        --radius: 14px;
        --radius-sm: 8px;
        --shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
      }

      [data-theme='light'] {
        --bg: #fafafa;
        --bg-elev: #ffffff;
        --bg-card: rgba(0, 0, 0, 0.025);
        --bg-card-solid: #f4f4f5;
        --bg-input: rgba(0, 0, 0, 0.03);
        --bg-input-focus: rgba(30, 144, 255, 0.08);
        --border: rgba(0, 0, 0, 0.08);
        --border-strong: rgba(0, 0, 0, 0.18);
        --text: #18181b;
        --text-muted: #6b6b72;
        --text-faint: #a1a1aa;
        --accent-glow: rgba(30, 144, 255, 0.1);
        --code-bg: #1a1d27;
        --code-text: #e6e9ef;
        --shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
      }

      html { background: var(--bg); color: var(--text); font-family: var(--font); scroll-behavior: smooth; }
      body { min-height: 100vh; display: flex; flex-direction: column; }
      a { color: inherit; text-decoration: none; }
      button { font-family: inherit; cursor: pointer; }
      input, select, textarea { font-family: inherit; color: inherit; font-size: inherit; }

      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 99px; border: 2px solid transparent; background-clip: padding-box; }
      ::-webkit-scrollbar-thumb:hover { background: var(--accent); background-clip: padding-box; border: 2px solid transparent; }

      /* ── Top nav ── */
      nav {
        position: sticky; top: 0; z-index: 100;
        display: flex; align-items: center; justify-content: space-between;
        max-width: 1400px; width: 100%; margin: 0 auto;
        padding: 1rem 1.5rem;
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      }
      .nav-left { display: flex; align-items: center; gap: 1rem; }
      .nav-back {
        display: inline-flex; align-items: center; gap: 0.4rem;
        font-size: 0.9rem; color: var(--text-muted);
        padding: 0.4rem 0.7rem; border-radius: 9999px;
        transition: background 0.15s, color 0.15s;
      }
      .nav-back:hover { color: var(--text); background: var(--bg-card); }
      .nav-logo { height: 22px; width: auto; }
      .logo-for-dark { display: block; }
      .logo-for-light { display: none; }
      [data-theme='light'] .logo-for-dark { display: none; }
      [data-theme='light'] .logo-for-light { display: block; }

      .nav-right { display: flex; align-items: center; gap: 1.5rem; }
      .nav-link { font-size: 0.9rem; font-weight: 500; color: var(--text-muted); transition: color 0.2s; }
      .nav-link:hover { color: var(--text); }

      .theme-toggle {
        position: relative; display: inline-flex; align-items: center;
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: 9999px; padding: 3px;
      }
      .theme-toggle button {
        position: relative; z-index: 1;
        display: flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border: none; border-radius: 50%;
        background: transparent; color: var(--text-muted); cursor: pointer; transition: color 0.2s;
      }
      .theme-toggle button:hover { color: var(--text); }
      .theme-toggle button[aria-pressed='true'] { color: #fff; }
      .auto-label { font-size: 14px; font-weight: 700; line-height: 1; }
      .toggle-pill {
        position: absolute; top: 3px; left: 3px; width: 30px; height: 30px;
        border-radius: 50%; background: var(--accent);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .toggle-pill[data-pos='1'] { transform: translateX(30px); }
      .toggle-pill[data-pos='2'] { transform: translateX(60px); }

      /* ── Hero ── */
      .hero {
        position: relative;
        max-width: 1400px; width: 100%; margin: 0 auto;
        padding: 2.5rem 1.5rem 1.5rem;
        text-align: center;
      }
      .hero::before {
        content: '';
        position: absolute; top: -10%; left: 50%; transform: translateX(-50%);
        width: min(700px, 100vw); height: 400px;
        background: radial-gradient(ellipse, var(--accent-glow), transparent 70%);
        pointer-events: none; z-index: -1;
      }
      .hero-eyebrow {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.35rem 0.85rem; border-radius: 9999px;
        background: var(--bg-card); border: 1px solid var(--border);
        font-size: 0.78rem; color: var(--text-muted); font-weight: 500;
        margin-bottom: 1rem;
      }
      .hero-eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
      .hero h1 {
        font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 700; line-height: 1.1;
        letter-spacing: -0.03em; padding-bottom: 0.1em;
        background: linear-gradient(135deg, var(--text) 0%, var(--accent) 100%);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      }
      .hero p {
        margin: 1rem auto 0; max-width: 60ch;
        color: var(--text-muted); line-height: 1.6; font-size: 1rem;
      }
      .hero-meta {
        display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.5rem;
        margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted);
      }
      .hero-meta strong { color: var(--accent); font-weight: 600; }

      /* ── Tip card ── */
      .tip {
        max-width: 1400px; width: 100%; margin: 0 auto 1.5rem;
        padding: 0 1.5rem;
      }
      .tip-inner {
        display: flex; gap: 0.85rem; align-items: flex-start;
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1rem 1.25rem;
      }
      .tip-icon {
        flex-shrink: 0; width: 32px; height: 32px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 8px; background: var(--accent-glow); color: var(--accent);
      }
      .tip-content { font-size: 0.9rem; line-height: 1.55; color: var(--text-muted); }
      .tip-content strong { color: var(--text); font-weight: 600; }
      .tip-content code {
        font-family: var(--font-mono); font-size: 0.85em;
        background: var(--bg-card-solid); padding: 0.1em 0.4em;
        border-radius: 4px; border: 1px solid var(--border);
      }

      /* ── Layout ── */
      .layout {
        max-width: 1400px; width: 100%; margin: 0 auto;
        padding: 0 1.5rem 4rem;
        display: grid;
        grid-template-columns: 220px 320px 1fr;
        gap: 1.25rem;
        min-height: 70vh;
      }

      /* ── Categories rail ── */
      .rail {
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 0.6rem;
        position: sticky; top: 5rem;
        max-height: calc(100vh - 6rem); overflow-y: auto;
      }
      .rail-section-label {
        font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em;
        color: var(--text-faint); text-transform: uppercase;
        padding: 0.65rem 0.65rem 0.35rem;
      }
      .cat-btn {
        display: flex; align-items: center; gap: 0.65rem; width: 100%;
        padding: 0.55rem 0.65rem; border: none; background: transparent;
        border-radius: var(--radius-sm); color: var(--text-muted);
        font-size: 0.88rem; font-weight: 500; text-align: left;
        transition: background 0.15s, color 0.15s;
      }
      .cat-btn:hover { background: var(--bg-card); color: var(--text); }
      .cat-btn[aria-pressed='true'] {
        background: var(--accent-glow); color: var(--accent);
      }
      .cat-btn[aria-pressed='true'] .cat-btn-count { color: var(--accent); }
      .cat-btn-icon {
        flex-shrink: 0; width: 22px; height: 22px;
        display: flex; align-items: center; justify-content: center;
        color: currentColor;
      }
      .cat-btn-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .cat-btn-count {
        flex-shrink: 0; font-size: 0.72rem; font-weight: 600;
        color: var(--text-faint); padding: 0.1em 0.5em;
        border-radius: 9999px; background: var(--bg-card-solid);
      }
      .cat-btn[aria-pressed='true'] .cat-btn-count { background: rgba(30, 144, 255, 0.2); }

      /* ── Command list ── */
      .commands {
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius); display: flex; flex-direction: column;
        overflow: hidden; min-height: 0;
      }
      .search-wrap {
        position: relative; padding: 0.85rem;
        border-bottom: 1px solid var(--border);
      }
      .search-wrap svg {
        position: absolute; left: 1.5rem; top: 50%; transform: translateY(-50%);
        color: var(--text-faint); pointer-events: none;
      }
      .search {
        width: 100%; padding: 0.65rem 0.85rem 0.65rem 2.4rem;
        background: var(--bg-input); border: 1px solid var(--border);
        border-radius: var(--radius-sm); color: var(--text);
        font-size: 0.9rem; transition: border-color 0.15s, background 0.15s;
      }
      .search:focus { outline: none; border-color: var(--accent); background: var(--bg-input-focus); }
      .search::placeholder { color: var(--text-faint); }

      .cmd-list { flex: 1; overflow-y: auto; padding: 0.4rem; }
      .cmd-section-label {
        font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em;
        color: var(--text-faint); text-transform: uppercase;
        padding: 0.85rem 0.65rem 0.45rem;
      }
      .cmd-item {
        display: block; width: 100%; padding: 0.65rem 0.75rem;
        border: 1px solid transparent; background: transparent;
        border-radius: var(--radius-sm); color: var(--text);
        text-align: left; transition: background 0.15s, border-color 0.15s, transform 0.1s;
      }
      .cmd-item:hover { background: var(--bg-card); }
      .cmd-item[aria-pressed='true'] {
        background: var(--accent-glow); border-color: rgba(30, 144, 255, 0.3);
      }
      .cmd-item-name {
        font-family: var(--font-mono); font-size: 0.86rem;
        font-weight: 600; color: var(--text);
      }
      .cmd-item[aria-pressed='true'] .cmd-item-name { color: var(--accent); }
      .cmd-item-desc {
        font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem;
        line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2;
        -webkit-box-orient: vertical; overflow: hidden;
      }
      .empty-state {
        padding: 2rem 1rem; text-align: center;
        color: var(--text-muted); font-size: 0.9rem;
      }

      /* ── Builder ── */
      .builder {
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.5rem;
        display: flex; flex-direction: column; gap: 1.25rem;
        min-height: 0;
      }
      .builder-header {
        display: flex; flex-direction: column; gap: 0.4rem;
        padding-bottom: 1.1rem; border-bottom: 1px solid var(--border);
      }
      .builder-eyebrow {
        display: inline-flex; align-items: center; gap: 0.55rem;
        font-size: 0.75rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--accent);
      }
      .builder-eyebrow svg { width: 14px; height: 14px; }
      .builder-title {
        font-family: var(--font-mono); font-size: 1.5rem;
        font-weight: 700; line-height: 1.2; color: var(--text);
        word-break: break-word;
      }
      .builder-desc { color: var(--text-muted); font-size: 0.95rem; line-height: 1.55; }
      .builder-meta {
        display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin-top: 0.4rem;
        font-size: 0.8rem; color: var(--text-muted);
      }
      .builder-meta code {
        font-family: var(--font-mono);
        background: var(--bg-card-solid); padding: 0.1em 0.4em;
        border-radius: 4px; border: 1px solid var(--border);
      }

      /* ── Args form ── */
      .args { display: flex; flex-direction: column; gap: 0.95rem; }
      .args-empty {
        padding: 0.85rem 1rem; background: var(--bg-card-solid);
        border: 1px dashed var(--border); border-radius: var(--radius-sm);
        color: var(--text-muted); font-size: 0.88rem; line-height: 1.5;
      }
      .arg-field { display: flex; flex-direction: column; gap: 0.35rem; }
      .arg-label {
        display: flex; align-items: center; gap: 0.5rem;
        font-size: 0.82rem; font-weight: 600; color: var(--text);
      }
      .arg-required { color: var(--danger); font-weight: 700; }
      .arg-type {
        font-family: var(--font-mono); font-size: 0.7rem;
        color: var(--text-faint); padding: 0.1em 0.5em;
        border-radius: 4px; background: var(--bg-card-solid);
        border: 1px solid var(--border);
      }
      .arg-input, .arg-select, .arg-textarea {
        padding: 0.6rem 0.75rem; background: var(--bg-input);
        border: 1px solid var(--border); border-radius: var(--radius-sm);
        color: var(--text); font-size: 0.9rem;
        transition: border-color 0.15s, background 0.15s;
        width: 100%;
      }
      .arg-input:focus, .arg-select:focus, .arg-textarea:focus {
        outline: none; border-color: var(--accent); background: var(--bg-input-focus);
      }
      .arg-textarea { resize: vertical; min-height: 70px; font-family: var(--font-mono); font-size: 0.85rem; }
      .arg-input::placeholder, .arg-textarea::placeholder { color: var(--text-faint); }
      .arg-hint { font-size: 0.78rem; color: var(--text-muted); line-height: 1.45; }
      .arg-mono { font-family: var(--font-mono); font-size: 0.85rem; }

      /* datalist suggestion select hybrids */
      .arg-input[list] { background-image: linear-gradient(45deg, transparent 50%, var(--text-muted) 50%, var(--text-muted) 60%, transparent 60%, transparent 70%, var(--text-muted) 70%, var(--text-muted) 80%, transparent 80%); background-position: calc(100% - 12px) center; background-size: 10px 10px; background-repeat: no-repeat; padding-right: 2rem; }

      /* ── Preview ── */
      .preview {
        margin-top: auto; display: flex; flex-direction: column; gap: 0.85rem;
        padding-top: 1rem; border-top: 1px solid var(--border);
      }
      .preview-label {
        font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em;
        color: var(--text-faint); text-transform: uppercase;
      }
      .preview-box {
        position: relative; padding: 1.1rem 3.5rem 1.1rem 1.1rem;
        background: var(--code-bg); border: 1px solid var(--code-border);
        border-radius: var(--radius); color: var(--code-text);
        font-family: var(--font-mono); font-size: 0.95rem; line-height: 1.5;
        word-break: break-word; white-space: pre-wrap;
        box-shadow: var(--shadow);
      }
      .preview-cmd { color: var(--code-cmd); font-weight: 700; }
      .preview-arg-required {
        color: var(--code-arg-required); font-weight: 600;
        background: rgba(239, 68, 68, 0.1); padding: 0.05em 0.35em;
        border-radius: 4px;
      }
      .preview-arg-filled { color: var(--code-arg-filled); }
      .preview-mute { color: #6b7280; }
      .copy-btn {
        position: absolute; top: 0.75rem; right: 0.75rem;
        display: inline-flex; align-items: center; gap: 0.35rem;
        padding: 0.45rem 0.75rem; background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: var(--radius-sm); color: #fff;
        font-size: 0.8rem; font-weight: 600; font-family: var(--font);
        transition: background 0.15s, transform 0.1s;
      }
      .copy-btn:hover { background: rgba(30, 144, 255, 0.25); border-color: rgba(30, 144, 255, 0.4); }
      .copy-btn:active { transform: scale(0.96); }
      .copy-btn.success { background: rgba(34, 197, 94, 0.25); border-color: rgba(34, 197, 94, 0.5); color: #86efac; }
      .copy-btn.error { background: rgba(239, 68, 68, 0.25); border-color: rgba(239, 68, 68, 0.5); color: #fca5a5; }

      .preview-warning {
        font-size: 0.8rem; color: var(--warning);
        display: flex; align-items: center; gap: 0.4rem;
      }

      .actions {
        display: flex; flex-wrap: wrap; gap: 0.5rem;
      }
      .btn-secondary {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.45rem 0.85rem; background: var(--bg-card-solid);
        border: 1px solid var(--border); border-radius: var(--radius-sm);
        color: var(--text-muted); font-size: 0.82rem; font-weight: 500;
        transition: color 0.15s, border-color 0.15s;
      }
      .btn-secondary:hover { color: var(--text); border-color: var(--border-strong); }
      .btn-secondary svg { flex-shrink: 0; }

      .lp-helper {
        background: var(--bg-card-solid); border: 1px solid var(--border);
        border-radius: var(--radius-sm); padding: 0.85rem 1rem;
        display: flex; flex-direction: column; gap: 0.5rem;
      }
      .lp-helper-row {
        display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;
      }
      .lp-helper-label { font-size: 0.78rem; color: var(--text-muted); font-weight: 600; }
      .lp-helper-input {
        flex: 1; min-width: 120px;
        padding: 0.4rem 0.6rem; background: var(--bg-input);
        border: 1px solid var(--border); border-radius: 6px;
        font-size: 0.85rem; color: var(--text);
      }
      .lp-helper-input:focus { outline: none; border-color: var(--accent); }
      .lp-helper-cmd {
        font-family: var(--font-mono); font-size: 0.82rem;
        padding: 0.5rem 0.7rem; background: var(--code-bg);
        border-radius: 6px; color: var(--code-text);
        word-break: break-all;
      }

      /* ── Empty builder ── */
      .builder-empty {
        text-align: center; padding: 4rem 2rem; color: var(--text-muted);
      }
      .builder-empty svg {
        width: 64px; height: 64px; color: var(--text-faint); margin-bottom: 1rem;
      }
      .builder-empty h3 { color: var(--text); font-size: 1.15rem; font-weight: 600; margin-bottom: 0.5rem; }
      .builder-empty p { font-size: 0.9rem; line-height: 1.55; }

      /* ── Unlock presets section ── */
      .presets-section {
        max-width: 1400px; width: 100%; margin: 0 auto;
        padding: 1rem 1.5rem 4rem;
      }
      .presets-header { margin-bottom: 1.25rem; }
      .presets-header h2 {
        font-size: 1.5rem; font-weight: 700; line-height: 1.2;
        background: linear-gradient(135deg, var(--text) 0%, var(--accent) 100%);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      }
      .presets-header p { color: var(--text-muted); margin-top: 0.4rem; max-width: 70ch; }
      .presets-username {
        display: flex; gap: 0.6rem; align-items: center; margin-top: 1rem;
        flex-wrap: wrap;
      }
      .presets-username label { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; }
      .presets-username input {
        padding: 0.55rem 0.85rem; background: var(--bg-input);
        border: 1px solid var(--border); border-radius: var(--radius-sm);
        color: var(--text); font-size: 0.9rem; min-width: 220px;
        font-family: var(--font-mono);
      }
      .presets-username input:focus { outline: none; border-color: var(--accent); background: var(--bg-input-focus); }
      .presets-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 1rem;
      }
      .preset-card {
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.25rem; display: flex;
        flex-direction: column; gap: 0.6rem;
        transition: border-color 0.15s, box-shadow 0.15s, transform 0.1s;
      }
      .preset-card:hover {
        border-color: var(--accent); box-shadow: 0 4px 24px var(--accent-glow);
        transform: translateY(-1px);
      }
      .preset-card h3 { font-size: 1rem; font-weight: 600; }
      .preset-card p { font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; }
      .preset-cmds { background: var(--code-bg); color: var(--code-text); font-family: var(--font-mono); font-size: 0.78rem; padding: 0.65rem 0.8rem; border-radius: var(--radius-sm); line-height: 1.55; word-break: break-all; }
      .preset-cmds .preset-arg { color: var(--code-arg-filled); }
      .preset-card .copy-row { display: flex; gap: 0.4rem; align-items: center; margin-top: auto; }
      .preset-copy {
        display: inline-flex; align-items: center; gap: 0.35rem;
        padding: 0.4rem 0.75rem; background: var(--accent-glow);
        border: 1px solid rgba(30, 144, 255, 0.25); border-radius: 6px;
        color: var(--accent); font-size: 0.82rem; font-weight: 600;
        transition: background 0.15s;
      }
      .preset-copy:hover { background: rgba(30, 144, 255, 0.2); }
      .preset-copy.success { background: rgba(34, 197, 94, 0.2); border-color: rgba(34, 197, 94, 0.4); color: var(--success); }

      /* ── Footer ── */
      footer {
        margin-top: auto; padding: 2rem 1.5rem; text-align: center;
        font-size: 0.8rem; color: var(--text-muted); border-top: 1px solid var(--border);
      }
      footer a { color: var(--accent); }
      footer a:hover { text-decoration: underline; }

      /* ── Toast ── */
      .toast {
        position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%) translateY(100px);
        padding: 0.7rem 1.1rem; background: var(--bg-elev); border: 1px solid var(--border-strong);
        border-radius: 9999px; font-size: 0.88rem; color: var(--text);
        box-shadow: var(--shadow); z-index: 1000;
        display: flex; align-items: center; gap: 0.45rem;
        opacity: 0; pointer-events: none;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s;
      }
      .toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
      .toast.success { border-color: rgba(34, 197, 94, 0.4); }
      .toast.success svg { color: var(--success); }
      .toast.error { border-color: rgba(239, 68, 68, 0.4); }
      .toast.error svg { color: var(--danger); }

      /* ── Mobile ── */
      @media (max-width: 1024px) {
        .layout {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
        .rail {
          position: static; max-height: none; padding: 0.5rem;
          display: flex; flex-direction: column;
        }
        .rail-section-label { display: none; }
        .rail-cats {
          display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
          gap: 0.4rem;
        }
        .commands { max-height: 50vh; }
      }
      @media (max-width: 640px) {
        .hero { padding: 2rem 1rem 1rem; }
        .layout { padding: 0 1rem 3rem; }
        .tip { padding: 0 1rem; }
        .presets-section { padding: 1rem 1rem 3rem; }
        .builder { padding: 1.1rem; }
        .nav-right { gap: 0.85rem; }
        .nav-link { display: none; }
      }
    </style>
  </head>

