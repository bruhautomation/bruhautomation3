    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script is:inline>
      // ───────── Theme toggle (mirrors index.astro) ─────────
      (function () {
        var toggle = document.getElementById('theme-toggle');
        var pill = document.getElementById('toggle-pill');
        if (!toggle || !pill) return;
        var stored = localStorage.getItem('starlight-theme');
        var current = stored === 'light' || stored === 'dark' ? stored : 'auto';
        setUI(current);
        toggle.addEventListener('click', function (e) {
          var btn = e.target.closest('button[data-value]');
          if (!btn) return;
          apply(btn.getAttribute('data-value'));
        });
        function setUI(theme) {
          var posMap = { light: '0', auto: '1', dark: '2' };
          pill.setAttribute('data-pos', posMap[theme] || '1');
          toggle.querySelectorAll('button').forEach(function (b) {
            b.setAttribute(
              'aria-pressed',
              b.getAttribute('data-value') === theme ? 'true' : 'false'
            );
          });
        }
        function apply(theme) {
          setUI(theme);
          var resolved = theme;
          if (theme === 'auto') {
            resolved = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.dataset.theme = resolved;
          localStorage.setItem('starlight-theme', theme);
        }
      })();
    </script>

    <script is:inline>
      // ───────── Command generator ─────────
      (function () {
        const payload = JSON.parse(document.body.getAttribute('data-payload'));
        const {
          CATEGORIES,
          COMMANDS,
          UNLOCK_PRESETS,
          COMMON_BLOCKS,
          COMMON_ITEMS,
          COMMON_ENTITIES,
          COMMON_EFFECTS,
          COMMON_ENCHANTS,
          GAMERULES,
        } = payload;

        const SUGGESTION_LISTS = {
          block: COMMON_BLOCKS,
          item: COMMON_ITEMS,
          entity: COMMON_ENTITIES,
          effect: COMMON_EFFECTS,
          enchantment: COMMON_ENCHANTS,
          gamerule: GAMERULES,
          target: ['@s', '@p', '@a', '@r', '@e'],
          player: [],
        };

        const SVG_NS = 'http://www.w3.org/2000/svg';

        // ─── State ───
        const state = {
          activeCategory: 'all',
          activeCommandId: COMMANDS[0]?.id ?? null,
          search: '',
          values: {},          // commandId -> { argKey: value }
          lpUser: 'PlayerName',
          presetUser: 'YourUsername',
        };

        // ─── DOM refs ───
        const railEl = document.getElementById('rail-cats');
        const cmdListEl = document.getElementById('cmd-list');
        const builderEl = document.getElementById('builder');
        const searchEl = document.getElementById('search');
        const toastEl = document.getElementById('toast');
        const presetsGridEl = document.getElementById('presets-grid');
        const presetUserEl = document.getElementById('preset-user');

        // Categories with command counts
        function commandCount(catId) {
          return COMMANDS.filter((c) => c.category === catId).length;
        }
        function totalCount() { return COMMANDS.length; }

        // ─── Render the categories rail ───
        function renderRail() {
          railEl.innerHTML = '';
          const all = makeCatBtn({
            id: 'all',
            name: 'All commands',
            iconPath: 'M4 6h16M4 12h16M4 18h12',
          }, totalCount(), state.activeCategory === 'all');
          railEl.appendChild(all);

          CATEGORIES.forEach((cat) => {
            const btn = makeCatBtn(cat, commandCount(cat.id), state.activeCategory === cat.id);
            railEl.appendChild(btn);
          });
        }
        function makeCatBtn(cat, count, active) {
          const btn = document.createElement('button');
          btn.className = 'cat-btn';
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          btn.dataset.id = cat.id;
          btn.innerHTML =
            `<span class="cat-btn-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="${cat.iconPath}"></path>
              </svg>
            </span>
            <span class="cat-btn-name">${escapeHtml(cat.name)}</span>
            <span class="cat-btn-count">${count}</span>`;
          btn.addEventListener('click', () => {
            state.activeCategory = cat.id;
            renderRail();
            renderCommandList();
          });
          return btn;
        }

        // ─── Render command list ───
        function renderCommandList() {
          const search = state.search.trim().toLowerCase();
          let filtered = COMMANDS;
          if (state.activeCategory !== 'all') {
            filtered = filtered.filter((c) => c.category === state.activeCategory);
          }
          if (search) {
            filtered = filtered.filter((c) =>
              c.name.toLowerCase().includes(search) ||
              c.description.toLowerCase().includes(search) ||
              (c.permission || '').toLowerCase().includes(search)
            );
          }

          cmdListEl.innerHTML = '';
          if (filtered.length === 0) {
            cmdListEl.innerHTML = `<div class="empty-state">No commands match. Try a different search.</div>`;
            return;
          }

          // group by category if showing all
          if (state.activeCategory === 'all') {
            const byCat = {};
            filtered.forEach((c) => {
              (byCat[c.category] = byCat[c.category] || []).push(c);
            });
            CATEGORIES.forEach((cat) => {
              const group = byCat[cat.id];
              if (!group) return;
              const label = document.createElement('div');
              label.className = 'cmd-section-label';
              label.textContent = cat.name + ' · ' + group.length;
              cmdListEl.appendChild(label);
              group.forEach((c) => cmdListEl.appendChild(makeCmdItem(c)));
            });
          } else {
            filtered.forEach((c) => cmdListEl.appendChild(makeCmdItem(c)));
          }
        }
        function makeCmdItem(cmd) {
          const btn = document.createElement('button');
          btn.className = 'cmd-item';
          btn.setAttribute('aria-pressed', state.activeCommandId === cmd.id ? 'true' : 'false');
          btn.dataset.id = cmd.id;
          btn.innerHTML =
            `<div class="cmd-item-name">${escapeHtml(cmd.name)}</div>
             <div class="cmd-item-desc">${escapeHtml(cmd.description)}</div>`;
          btn.addEventListener('click', () => {
            state.activeCommandId = cmd.id;
            renderCommandList();
            renderBuilder();
          });
          return btn;
        }

        // ─── Render builder ───
        function renderBuilder() {
          const cmd = COMMANDS.find((c) => c.id === state.activeCommandId);
          if (!cmd) {
            builderEl.innerHTML = `
              <div class="builder-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                <h3>Pick a command</h3>
                <p>Choose a category on the left, then a command in the middle column.</p>
              </div>`;
            return;
          }

          // ensure a value bag exists for this command
          if (!state.values[cmd.id]) {
            state.values[cmd.id] = {};
            cmd.args.forEach((a) => {
              if (a.default != null) state.values[cmd.id][a.key] = a.default;
            });
          }
          const vals = state.values[cmd.id];
          const cat = CATEGORIES.find((c) => c.id === cmd.category);

          builderEl.innerHTML = '';
          const header = document.createElement('div');
          header.className = 'builder-header';
          header.innerHTML = `
            <div class="builder-eyebrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="${cat ? cat.iconPath : ''}"></path>
              </svg>
              ${cat ? escapeHtml(cat.name) : 'Vanilla'}
            </div>
            <div class="builder-title">${escapeHtml(cmd.name)}</div>
            <div class="builder-desc">${escapeHtml(cmd.description)}</div>
            ${cmd.permission || cmd.notes ? `
              <div class="builder-meta">
                ${cmd.permission ? `<span>Permission <code>${escapeHtml(cmd.permission)}</code></span>` : ''}
                ${cat && cat.wiki ? `<span><a href="${cat.wiki}" target="_blank" rel="noopener" style="color:var(--accent)">Plugin docs ↗</a></span>` : ''}
              </div>` : ''}
            ${cmd.notes ? `<div class="builder-meta" style="color:var(--text-muted);margin-top:0.5rem;font-style:italic">${escapeHtml(cmd.notes)}</div>` : ''}
          `;
          builderEl.appendChild(header);

          // Args
          const argsEl = document.createElement('div');
          argsEl.className = 'args';
          if (cmd.args.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'args-empty';
            empty.textContent = 'No arguments — this command runs as-is.';
            argsEl.appendChild(empty);
          } else {
            cmd.args.forEach((arg) => {
              argsEl.appendChild(makeArgField(cmd, arg, vals));
            });
          }
          builderEl.appendChild(argsEl);

          // Live preview + actions
          const previewWrap = document.createElement('div');
          previewWrap.className = 'preview';
          const previewLabel = document.createElement('div');
          previewLabel.className = 'preview-label';
          previewLabel.textContent = 'Preview';
          previewWrap.appendChild(previewLabel);

          const previewBox = document.createElement('div');
          previewBox.className = 'preview-box';
          previewBox.id = 'preview-box';
          previewWrap.appendChild(previewBox);

          // Permission helper (LuckPerms grant)
          if (cmd.permission) {
            const lp = document.createElement('div');
            lp.className = 'lp-helper';
            lp.innerHTML = `
              <div class="lp-helper-label">Grant this permission via LuckPerms</div>
              <div class="lp-helper-row">
                <input type="text" class="lp-helper-input" id="lp-user" value="${escapeAttr(state.lpUser)}" placeholder="username" autocomplete="off" spellcheck="false" />
                <button class="btn-secondary" id="lp-copy-btn" type="button">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  Copy grant
                </button>
              </div>
              <div class="lp-helper-cmd" id="lp-cmd"></div>
            `;
            previewWrap.appendChild(lp);
            // wire it up after appending
            setTimeout(() => {
              const userInput = lp.querySelector('#lp-user');
              const cmdEl = lp.querySelector('#lp-cmd');
              const copyBtn = lp.querySelector('#lp-copy-btn');
              const updateLp = () => {
                state.lpUser = userInput.value;
                const u = (userInput.value || 'PlayerName').trim() || 'PlayerName';
                cmdEl.textContent = `/lp user ${u} permission set ${cmd.permission} true`;
              };
              userInput.addEventListener('input', updateLp);
              copyBtn.addEventListener('click', () => {
                copyToClipboard(cmdEl.textContent, copyBtn, 'LuckPerms grant copied');
              });
              updateLp();
            }, 0);
          }

          builderEl.appendChild(previewWrap);

          // Initial preview render
          updatePreview(cmd, vals);
        }

        function makeArgField(cmd, arg, vals) {
          const wrap = document.createElement('div');
          wrap.className = 'arg-field';

          const label = document.createElement('label');
          label.className = 'arg-label';
          const labelId = 'arg-' + cmd.id + '-' + arg.key;
          label.htmlFor = labelId;
          label.innerHTML = `
            <span>${escapeHtml(arg.label)}</span>
            ${arg.required ? '<span class="arg-required" title="Required">●</span>' : ''}
            <span class="arg-type">${escapeHtml(arg.type)}</span>
          `;
          wrap.appendChild(label);

          let input;
          const currentVal = vals[arg.key] ?? arg.default ?? '';

          if (arg.type === 'select') {
            input = document.createElement('select');
            input.className = 'arg-select';
            (arg.options || []).forEach((opt) => {
              const o = document.createElement('option');
              o.value = opt;
              o.textContent = opt === '' ? '— none —' : opt;
              if (opt === currentVal) o.selected = true;
              input.appendChild(o);
            });
          } else if (arg.type === 'longtext' || arg.type === 'json') {
            input = document.createElement('textarea');
            input.className = 'arg-textarea';
            input.rows = arg.type === 'json' ? 3 : 2;
            input.value = currentVal;
            if (arg.placeholder) input.placeholder = arg.placeholder;
          } else {
            input = document.createElement('input');
            input.className = 'arg-input';
            input.type = arg.type === 'number' ? 'number' : 'text';
            input.value = currentVal;
            if (arg.placeholder) input.placeholder = arg.placeholder;
            if (arg.min != null) input.min = String(arg.min);
            if (arg.max != null) input.max = String(arg.max);
            if (arg.step != null) input.step = String(arg.step);
            if (arg.type === 'block' || arg.type === 'item' || arg.type === 'entity' ||
                arg.type === 'effect' || arg.type === 'enchantment' || arg.type === 'gamerule' ||
                arg.type === 'target') {
              const listId = 'datalist-' + cmd.id + '-' + arg.key;
              input.setAttribute('list', listId);
              const list = document.createElement('datalist');
              list.id = listId;
              (SUGGESTION_LISTS[arg.type] || []).forEach((opt) => {
                const o = document.createElement('option');
                o.value = opt;
                list.appendChild(o);
              });
              wrap.appendChild(list);
              input.classList.add('arg-mono');
            }
          }
          input.id = labelId;
          input.addEventListener('input', () => {
            vals[arg.key] = input.value;
            updatePreview(cmd, vals);
          });
          input.addEventListener('change', () => {
            vals[arg.key] = input.value;
            updatePreview(cmd, vals);
          });
          wrap.appendChild(input);

          if (arg.hint) {
            const hint = document.createElement('div');
            hint.className = 'arg-hint';
            hint.textContent = arg.hint;
            wrap.appendChild(hint);
          }

          // store initial
          vals[arg.key] = currentVal;
          return wrap;
        }

        // ─── Build the command string from template + values ───
        function buildCommand(cmd, vals) {
          // Returns { plain, html, missingRequired }
          const tpl = cmd.template;
          const re = /\{(\w+)\}/g;
          let lastIndex = 0;
          let m;
          const segs = [];
          while ((m = re.exec(tpl)) !== null) {
            if (m.index > lastIndex) {
              segs.push({ type: 'static', text: tpl.slice(lastIndex, m.index) });
            }
            segs.push({ type: 'arg', key: m[1] });
            lastIndex = m.index + m[0].length;
          }
          if (lastIndex < tpl.length) {
            segs.push({ type: 'static', text: tpl.slice(lastIndex) });
          }

          // Find the index of the last *filled* arg. Anything before it is
          // positionally required even if marked optional, since Minecraft
          // commands are positional and skipping a middle arg is invalid.
          const argSegs = segs.filter((s) => s.type === 'arg');
          let lastFilledArgIdx = -1;
          argSegs.forEach((s, i) => {
            const v = (vals[s.key] ?? '').toString().trim();
            if (v !== '') lastFilledArgIdx = i;
          });
          let argIdx = -1;

          // Walk segments and produce output. For optional empty args we drop the
          // preceding whitespace separator so we don't get double spaces.
          let plain = '';
          let html = '';
          let missingRequired = false;
          let pendingSpace = ''; // whitespace from a static segment that may be skipped

          // Helper to escape HTML in segments
          const esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);

          // Identify first non-whitespace segment as command name for highlighting
          let cmdNameDone = false;

          segs.forEach((seg, i) => {
            if (seg.type === 'static') {
              const s = seg.text;
              // If the whole segment is whitespace, hold onto it; flush next time we emit.
              if (/^\s+$/.test(s)) {
                pendingSpace += s;
                return;
              }
              // It contains non-whitespace (e.g. the leading slash + command). Flush pending space first.
              if (pendingSpace) {
                plain += pendingSpace;
                html += esc(pendingSpace);
                pendingSpace = '';
              }
              if (!cmdNameDone) {
                // Find the command name (everything up to first whitespace) and color it.
                const wsIdx = s.search(/\s/);
                const name = wsIdx === -1 ? s : s.slice(0, wsIdx);
                const rest = wsIdx === -1 ? '' : s.slice(wsIdx);
                plain += s;
                html += `<span class="preview-cmd">${esc(name)}</span>${esc(rest)}`;
                cmdNameDone = true;
              } else {
                plain += s;
                html += esc(s);
              }
            } else {
              // arg segment
              argIdx++;
              const arg = cmd.args.find((a) => a.key === seg.key);
              const raw = (vals[seg.key] ?? '').toString();
              const val = raw.trim();
              const positionallyNeeded = argIdx < lastFilledArgIdx;
              if (val === '') {
                if ((arg && arg.required) || positionallyNeeded) {
                  // emit a placeholder
                  if (pendingSpace) {
                    plain += pendingSpace;
                    html += esc(pendingSpace);
                    pendingSpace = '';
                  }
                  plain += `<${arg.label}>`;
                  html += `<span class="preview-arg-required">&lt;${esc(arg.label)}&gt;</span>`;
                  missingRequired = true;
                } else {
                  // optional & blank with nothing later — drop pending space too
                  pendingSpace = '';
                }
              } else {
                if (pendingSpace) {
                  plain += pendingSpace;
                  html += esc(pendingSpace);
                  pendingSpace = '';
                }
                // if value contains spaces and command isn't /say/longtext-trailing,
                // keep as-is — Minecraft commands generally accept the trailing string verbatim.
                plain += val;
                html += `<span class="preview-arg-filled">${esc(val)}</span>`;
              }
            }
          });
          // Flush trailing pending space (only if something already emitted, otherwise drop)
          if (pendingSpace && plain.length > 0) {
            plain += pendingSpace.replace(/\s+$/, '');
            // don't render trailing whitespace in html either
          }

          // Collapse any accidental double spaces (from skipped optional args mid-stream)
          plain = plain.replace(/\s{2,}/g, ' ').trim();

          return { plain, html, missingRequired };
        }

        function updatePreview(cmd, vals) {
          const box = document.getElementById('preview-box');
          if (!box) return;
          const built = buildCommand(cmd, vals);

          box.innerHTML = `<span class="preview-content">${built.html || '<span class="preview-mute">(empty)</span>'}</span>`;
          const copy = document.createElement('button');
          copy.className = 'copy-btn';
          copy.type = 'button';
          copy.innerHTML = `
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>Copy</span>
          `;
          copy.addEventListener('click', () => {
            if (built.missingRequired) {
              flashCopyBtn(copy, 'Fill required fields', false);
              showToast('Fill required fields first', 'error');
              return;
            }
            copyToClipboard(built.plain, copy, 'Command copied');
          });
          box.appendChild(copy);
        }

        // ─── Presets ───
        function renderPresets() {
          presetsGridEl.innerHTML = '';
          UNLOCK_PRESETS.forEach((p) => {
            const card = document.createElement('div');
            card.className = 'preset-card';
            const cmdsText = p.commands.join('\n');
            const cmdsHtml = p.commands
              .map((c) => escapeHtml(c).replace(/\{USER\}/g, '<span class="preset-arg">{USER}</span>'))
              .join('<br>');
            card.innerHTML = `
              <h3>${escapeHtml(p.name)}</h3>
              <p>${escapeHtml(p.description)}</p>
              <div class="preset-cmds" data-template="${escapeAttr(cmdsText)}">${cmdsHtml}</div>
              <div class="copy-row">
                <button class="preset-copy" type="button">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Copy</span>
                </button>
              </div>
            `;
            const cmdsEl = card.querySelector('.preset-cmds');
            const updateCmds = () => {
              const u = (presetUserEl.value || 'YourUsername').trim() || 'YourUsername';
              cmdsEl.innerHTML = p.commands
                .map((c) => escapeHtml(c.replace(/\{USER\}/g, u)))
                .join('<br>');
              cmdsEl.dataset.template = p.commands.map((c) => c.replace(/\{USER\}/g, u)).join('\n');
            };
            const btn = card.querySelector('.preset-copy');
            btn.addEventListener('click', () => {
              copyToClipboard(cmdsEl.dataset.template, btn, 'Unlock commands copied');
            });
            // Re-render on global username change
            card._update = updateCmds;
            updateCmds();
            presetsGridEl.appendChild(card);
          });
        }

        // ─── Helpers ───
        function copyToClipboard(text, btn, successMsg) {
          const fallback = () => {
            try {
              const ta = document.createElement('textarea');
              ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
              document.body.appendChild(ta); ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
              flashCopyBtn(btn, 'Copied!', true);
              showToast(successMsg || 'Copied', 'success');
            } catch (e) {
              flashCopyBtn(btn, 'Copy failed', false);
              showToast('Copy failed — please copy manually', 'error');
            }
          };
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(
              () => {
                flashCopyBtn(btn, 'Copied!', true);
                showToast(successMsg || 'Copied', 'success');
              },
              fallback
            );
          } else {
            fallback();
          }
        }

        function flashCopyBtn(btn, message, ok) {
          const span = btn.querySelector('span');
          const originalText = span ? span.textContent : btn.textContent;
          if (span) span.textContent = message;
          else btn.textContent = message;
          btn.classList.toggle('success', !!ok);
          btn.classList.toggle('error', !ok);
          setTimeout(() => {
            if (span) span.textContent = originalText;
            else btn.textContent = originalText;
            btn.classList.remove('success', 'error');
          }, 1600);
        }

        function showToast(message, kind) {
          toastEl.className = 'toast show ' + (kind || '');
          const icon = kind === 'success'
            ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>'
            : kind === 'error'
              ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>'
              : '';
          toastEl.innerHTML = icon + '<span>' + escapeHtml(message) + '</span>';
          clearTimeout(showToast._t);
          showToast._t = setTimeout(() => toastEl.classList.remove('show'), 2200);
        }

        function escapeHtml(s) {
          return String(s).replace(/[&<>"']/g, (c) =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]
          );
        }
        function escapeAttr(s) { return escapeHtml(s); }

        // ─── Wire up ───
        searchEl.addEventListener('input', () => {
          state.search = searchEl.value;
          renderCommandList();
        });

        presetUserEl.addEventListener('input', () => {
          // Re-render every preset card
          presetsGridEl.querySelectorAll('.preset-card').forEach((card) => {
            if (card._update) card._update();
          });
        });

        // Initial render
        renderRail();
        renderCommandList();
        renderBuilder();
        renderPresets();
      })();
    </script>
  </body>
</html>
