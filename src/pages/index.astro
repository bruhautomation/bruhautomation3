---
// Custom landing page — standalone, outside Starlight's content collection.
import { getCollection } from 'astro:content';
import logoLight from '../assets/bruh-logo-light.svg';
import logoDark from '../assets/bruh-logo-dark.svg';

// Hero project counts, derived from the docs content so the numbers always match
// what the site actually shows. Drafts are counted only when this build shows
// drafts (Vercel Preview / local dev) — using the same signal as Starlight's own
// draft gate (`import.meta.env.MODE !== 'production'`) — so the live site
// reflects shipped projects and previews reflect the full in-development
// catalogue. Overview/index pages and app sub-pages aren't counted as projects.
const showDrafts = import.meta.env.MODE !== 'production';
const docs = await getCollection('docs', ({ data }) => showDrafts || !data.draft);
const slug = (e) => e.id.replace(/^\/+/, '').replace(/\/index$/, '');
const isOverview = (e) => slug(e).endsWith('/overview');
const countIn = (dir) =>
	docs.filter((e) => slug(e).startsWith(dir + '/') && !isOverview(e)).length;
const appCount = new Set(
	docs.map(slug).filter((s) => s.startsWith('bruh-')).map((s) => s.split('/')[0])
).size;
const stats = [
	{ number: countIn('smart-home-projects'), label: 'Smart Home<br />Projects' },
	{ number: countIn('home-projects'), label: 'Maker<br />Projects' },
	{ number: countIn('lab-projects'), label: 'Lab<br />Projects' },
	{ number: appCount, label: 'HA<br />Apps' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>BRUH Automation — Home Automation for Everyone</title>
		<meta
			name="description"
			content="DIY smart home, maker, and biotech lab projects by Ben. Open-source designs, 3D print files, ESPHome configs, and honest build guides."
		/>
		<link rel="canonical" href="https://bruhautomation.com/" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="BRUH Automation" />
		<meta property="og:title" content="BRUH Automation — Home Automation for Everyone" />
		<meta property="og:url" content="https://bruhautomation.com/" />
		<meta
			property="og:description"
			content="DIY smart home, maker, and biotech lab projects by Ben. Open-source designs, 3D print files, ESPHome configs, and honest build guides."
		/>
		<meta property="og:image" content="https://bruhautomation.com/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="BRUH Automation — smart home, maker, and lab projects" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="BRUH Automation — Home Automation for Everyone" />
		<meta
			name="twitter:description"
			content="DIY smart home, maker, and biotech lab projects by Ben. Open-source designs, 3D print files, ESPHome configs, and honest build guides."
		/>
		<meta name="twitter:image" content="https://bruhautomation.com/og-image.png" />
		<meta name="theme-color" content="#1e90ff" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

		{/* Block render until theme is set — prevents flash */}
		<script is:inline>
			(function () {
				var s = localStorage.getItem('starlight-theme');
				var t =
					s === 'light'
						? 'light'
						: s === 'dark'
							? 'dark'
							: matchMedia('(prefers-color-scheme: light)').matches
								? 'light'
								: 'dark';
				document.documentElement.dataset.theme = t;
			})();
		</script>

		<style>
			/* ── Reset ── */
			*,
			*::before,
			*::after {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			/* ── Tokens ── */
			:root {
				--bg: #0b0d14;
				--bg-card: rgba(255, 255, 255, 0.04);
				--bg-card-solid: #14161e;
				--border: rgba(255, 255, 255, 0.08);
				--text: #e4e4e7;
				--text-muted: #9b9ba8;
				--accent: #1e90ff;
				--accent-glow: rgba(30, 144, 255, 0.15);
				--radius: 14px;
				--font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
					'Helvetica Neue', Arial, sans-serif;
			}
			[data-theme='light'] {
				--bg: #fafafa;
				--bg-card: rgba(0, 0, 0, 0.03);
				--bg-card-solid: #f0f0f2;
				--border: rgba(0, 0, 0, 0.08);
				--text: #18181b;
				--text-muted: #71717a;
				/* Darker accent on the near-white background so link/button text
				   clears WCAG AA (4.5:1); the brand #1e90ff only passes on dark. */
				--accent: #0969da;
				--accent-glow: rgba(30, 144, 255, 0.08);
			}

			html {
				background: var(--bg);
				color: var(--text);
				font-family: var(--font);
				scroll-behavior: smooth;
			}
			body {
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			.skip-link {
				position: absolute;
				top: -100px;
				left: 1rem;
				z-index: 200;
				padding: 0.6rem 1rem;
				border-radius: 8px;
				background: var(--accent);
				color: #fff;
				font-size: 0.9rem;
				font-weight: 600;
				transition: top 0.15s;
			}
			.skip-link:focus {
				top: 1rem;
			}

			/* ── Nav ── */
			nav {
				position: sticky;
				top: 0;
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: flex-end;
				max-width: 1100px;
				width: 100%;
				margin: 0 auto;
				padding: 1rem 1.5rem;
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
			}
			.nav-right {
				display: flex;
				align-items: center;
				gap: 1.75rem;
			}
			.nav-link {
				font-size: 0.9rem;
				font-weight: 500;
				color: var(--text-muted);
				transition: color 0.2s;
			}
			.nav-link:hover {
				color: var(--text);
			}

			/* ── Theme toggle ── */
			.theme-toggle {
				position: relative;
				display: inline-flex;
				align-items: center;
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 9999px;
				padding: 3px;
			}
			.theme-toggle button {
				position: relative;
				z-index: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 30px;
				height: 30px;
				border: none;
				border-radius: 50%;
				background: transparent;
				color: var(--text-muted);
				cursor: pointer;
				transition: color 0.2s;
				font-family: var(--font);
			}
			.theme-toggle button:hover {
				color: var(--text);
			}
			.theme-toggle button[aria-pressed='true'] {
				color: #fff;
			}
			.auto-label {
				font-size: 14px;
				font-weight: 700;
				line-height: 1;
			}
			.toggle-pill {
				position: absolute;
				top: 3px;
				left: 3px;
				width: 30px;
				height: 30px;
				border-radius: 50%;
				background: var(--accent);
				transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			}
			.toggle-pill[data-pos='1'] {
				transform: translateX(30px);
			}
			.toggle-pill[data-pos='2'] {
				transform: translateX(60px);
			}

			/* ── Hero ── */
			.hero {
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 4rem 1.5rem 4rem;
				min-height: 85vh;
				justify-content: center;
				overflow: visible;
			}
			.hero::before {
				content: '';
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: min(800px, 120vw);
				height: 600px;
				background: radial-gradient(
					ellipse,
					var(--accent-glow),
					transparent 70%
				);
				pointer-events: none;
			}
			.hero-logo {
				position: relative;
				width: min(380px, 75vw);
				height: auto;
				margin-bottom: 2rem;
			}
			.hero h1 {
				position: relative;
				font-size: clamp(2.2rem, 5.5vw, 3.5rem);
				font-weight: 700;
				line-height: 1.2;
				letter-spacing: -0.03em;
				max-width: 16ch;
				padding-bottom: 0.1em;
				color: var(--text);
				background: linear-gradient(
					135deg,
					var(--text) 0%,
					var(--accent) 100%
				);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.hero-tagline {
				position: relative;
				margin-top: 1.25rem;
				font-size: clamp(1rem, 2vw, 1.15rem);
				line-height: 1.6;
				color: var(--text-muted);
				max-width: 48ch;
			}
			.hero-actions {
				position: relative;
				display: flex;
				gap: 0.75rem;
				margin-top: 2.5rem;
				flex-wrap: wrap;
				justify-content: center;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.75rem 1.5rem;
				border-radius: 9999px;
				font-size: 0.95rem;
				font-weight: 600;
				transition:
					background 0.2s,
					transform 0.15s;
			}
			.btn:hover {
				transform: translateY(-1px);
			}
			.btn-primary {
				background: var(--accent);
				color: #fff;
			}
			.btn-primary:hover {
				background: #3a9fff;
			}
			.btn-outline {
				background: transparent;
				color: var(--text);
				border: 1px solid var(--border);
			}
			.btn-outline:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* ── Stats ── */
			.stats {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1rem;
				max-width: 800px;
				width: 100%;
				margin: 0 auto;
				padding: 0 1.5rem 4rem;
			}
			.stat {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.5rem 1rem;
				text-align: center;
				transition:
					border-color 0.2s,
					box-shadow 0.2s;
			}
			.stat:hover {
				border-color: var(--accent);
				box-shadow: 0 0 24px var(--accent-glow);
			}
			.stat-number {
				font-size: 2rem;
				font-weight: 700;
				color: var(--accent);
				line-height: 1;
			}
			.stat-label {
				margin-top: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-muted);
				line-height: 1.3;
			}

			/* ── Categories ── */
			.categories {
				max-width: 1000px;
				width: 100%;
				margin: 0 auto;
				padding: 0 1.5rem 5rem;
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1.25rem;
			}
			.cat-card {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 2rem 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				transition:
					border-color 0.2s,
					box-shadow 0.2s,
					transform 0.2s;
			}
			.cat-card:hover {
				border-color: var(--accent);
				box-shadow: 0 4px 24px var(--accent-glow);
				transform: translateY(-2px);
			}
			.cat-icon {
				width: 40px;
				height: 40px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 10px;
				background: var(--accent-glow);
				color: var(--accent);
			}
			.cat-card h3 {
				font-size: 1.1rem;
				font-weight: 600;
			}
			.cat-card p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.cat-link {
				margin-top: auto;
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--accent);
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
			}
			.cat-link svg {
				transition: transform 0.15s;
			}
			.cat-card:hover .cat-link svg {
				transform: translateX(2px);
			}

			/* ── Footer ── */
			footer {
				margin-top: auto;
				padding: 2rem 1.5rem;
				text-align: center;
				font-size: 0.8rem;
				color: var(--text-muted);
				border-top: 1px solid var(--border);
			}
			footer a {
				color: var(--accent);
			}
			footer a:hover {
				text-decoration: underline;
			}

			/* ── Logo theme switching ── */
			.logo-for-dark {
				display: block;
			}
			.logo-for-light {
				display: none;
			}
			[data-theme='light'] .logo-for-dark {
				display: none;
			}
			[data-theme='light'] .logo-for-light {
				display: block;
			}

			/* ── Responsive ── */
			@media (max-width: 900px) {
				.categories {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 640px) {
				.stats {
					grid-template-columns: repeat(2, 1fr);
				}
				.categories {
					grid-template-columns: 1fr;
				}
				.hero {
					padding: 3rem 1.25rem 3rem;
					min-height: auto;
				}
			}
		</style>
	</head>

	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<!-- Nav — no logo here since the hero has it -->
		<nav>
			<div class="nav-right">
				<a href="/project-list/" class="nav-link">Docs</a>
				<a
					href="https://www.youtube.com/@BRUHAutomation"
					class="nav-link"
					target="_blank"
					rel="noopener">YouTube</a
				>
				<div class="theme-toggle" id="theme-toggle">
					<button
						data-value="light"
						aria-label="Light theme"
						title="Light"
					>
						<svg aria-hidden="true" focusable="false"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<circle cx="12" cy="12" r="5"></circle>
							<line x1="12" y1="1" x2="12" y2="3"></line>
							<line x1="12" y1="21" x2="12" y2="23"></line>
							<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
							></line>
							<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
							></line>
							<line x1="1" y1="12" x2="3" y2="12"></line>
							<line x1="21" y1="12" x2="23" y2="12"></line>
							<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
							></line>
							<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
							></line>
						</svg>
					</button>
					<button
						data-value="auto"
						aria-label="System theme"
						title="Auto"
					>
						<span class="auto-label">A</span>
					</button>
					<button
						data-value="dark"
						aria-label="Dark theme"
						title="Dark"
					>
						<svg aria-hidden="true" focusable="false"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path
								d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
							></path>
						</svg>
					</button>
					<div class="toggle-pill" id="toggle-pill"></div>
				</div>
			</div>
		</nav>

		<main id="main" tabindex="-1">
			<!-- Hero -->
			<section class="hero">
				<!-- Center content -->
				<img
					class="hero-logo logo-for-dark"
					src={logoLight.src}
					alt="BRUH Automation"
				/>
				<img
					class="hero-logo logo-for-light"
					src={logoDark.src}
					alt="BRUH Automation"
				/>
				<h1>Home Automation for Everyone</h1>
				<p class="hero-tagline">
					Open-source smart home projects, maker builds, and lab tools
					— with 3D print files you can download and start building
					today.
				</p>
				<div class="hero-actions">
					<a href="/project-list/" class="btn btn-primary">
						Browse Projects
						<svg aria-hidden="true" focusable="false"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
						>
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
					<a
						href="https://www.youtube.com/@BRUHAutomation"
						class="btn btn-outline"
						target="_blank"
						rel="noopener"
					>
						<svg aria-hidden="true" focusable="false"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path
								d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
							></path>
						</svg>
						YouTube
					</a>
				</div>
			</section>

			<!-- Stats -->
			<section class="stats">
				{
					stats.map((s) => (
						<div class="stat">
							<div class="stat-number">{s.number}</div>
							<div class="stat-label" set:html={s.label} />
						</div>
					))
				}
			</section>

			<!-- Categories -->
			<section class="categories">
				<a href="/smart-home-projects/smart-candlet/" class="cat-card">
					<div class="cat-icon"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5L12 3l9 7.5V21a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V10.5z"></path><path d="M9 16.5a4 4 0 0 1 6 0"></path><path d="M7.5 14a7 7 0 0 1 9 0"></path><circle cx="12" cy="19" r="0.5"></circle></svg></div>
					<h3>Smart Home</h3>
					<p>Connected devices powered by ESPHome and Home Assistant.</p>
					<span class="cat-link">Explore <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
				</a>
				<a href="/home-projects/beautiful-childproof-doorknob/" class="cat-card">
					<div class="cat-icon"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg></div>
					<h3>Maker</h3>
					<p>3D prints, mods, and practical builds for around the house.</p>
					<span class="cat-link">Explore <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
				</a>
				<a href="/lab-projects/3d-prints/bsc-bottle-holder/" class="cat-card">
					<div class="cat-icon"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6v6l3 9a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2l3-9V3z"></path><line x1="8" y1="3" x2="16" y2="3"></line><path d="M10 15h4"></path></svg></div>
					<h3>Lab</h3>
					<p>Biotech lab automation and 3D-printed accessories.</p>
					<span class="cat-link">Explore <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
				</a>
				<a href="/bruh-claude/" class="cat-card">
