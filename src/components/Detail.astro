---
/**
 * Level-gated content for the site-wide Detail control.
 *
 * The control (see DetailControl.astro) stamps `data-detail="1|2|3"` on
 * <html>; CSS in custom.css shows or hides these wrappers to match.
 * Everything is always in the DOM, so search indexing and no-JS readers see
 * the full page.
 *
 * Levels label the CONTENT, never the reader:
 *   1 — Overview        what it is, what it does, how to get it running
 *   2 — Details         configuration, how-it-works, tables, gotchas
 *   3 — Under the hood  architecture, internals, design rationale
 *
 * Usage (block — animates open/closed):
 *   <Detail min={2}> …extra depth from level 2 up… </Detail>
 *   <Detail max={1}> …the plain-language version this replaces… </Detail>
 *   <Detail only={3}> …deep-dive-only aside… </Detail>
 *
 * Usage (inline — for a clause inside a sentence or list item):
 *   <Detail inline min={2}> …(~150–300 MB per worker)… </Detail>
 *
 * Authoring rule: every page must read as a complete document at level 1.
 * scripts/check-detail-levels.mjs enforces this at build time.
 */
interface Props {
	min?: 1 | 2 | 3;
	max?: 1 | 2 | 3;
	only?: 1 | 2 | 3;
	inline?: boolean;
}

const { min, max, only, inline = false } = Astro.props;
const lo = only ?? min ?? 1;
const hi = only ?? max ?? 3;

if (lo > hi) {
	throw new Error(`<Detail>: min (${lo}) must be ≤ max (${hi})`);
}
if (lo === 1 && hi === 3) {
	throw new Error('<Detail> without min/max/only gates nothing — remove the wrapper.');
}
---

{
	inline ? (
		<span class="detail-inline" data-dmin={lo} data-dmax={hi}><slot /></span>
	) : (
		<div class="detail-block" data-dmin={lo} data-dmax={hi}>
			<div class="detail-block-inner"><slot /></div>
		</div>
	)
}
