---
/**
 * The site-wide Detail control: three labeled buttons — Overview · Details ·
 * Under the hood — that set how much depth the current page shows. Docked at
 * the top of the page content (see MarkdownContent.astro) so it's equally
 * visible on desktop and mobile; the words themselves say what it does.
 *
 * Positions label the content, not the reader.
 *
 * State lives in localStorage('bruh-detail') and is stamped on
 * <html data-detail> by a blocking head script (astro.config.mjs) before
 * first paint, so there is no flash and no animation on page load. The
 * control only renders visibly on pages that contain level-tagged content
 * (Detail.astro wrappers). Styles live in custom.css.
 */
---

<bruh-detail-control class="detail-control" hidden>
	<span class="detail-control__label" aria-hidden="true">Detail</span>
	<div class="detail-control__track" role="group" aria-label="Detail level">
		<button type="button" data-level="1" aria-pressed="false">Overview</button>
		<button type="button" data-level="2" aria-pressed="false">Details</button>
		<button type="button" data-level="3" aria-pressed="false">Under the hood</button>
	</div>
</bruh-detail-control>

<script>
	const KEY = 'bruh-detail';
	const NAMES = ['Overview', 'Details', 'Under the hood'];
	const root = document.documentElement;

	const current = (): number => {
		const v = parseInt(root.dataset.detail || '1', 10);
		return v >= 1 && v <= 3 ? v : 1;
	};

	/** The levels (1–3) at which an element is visible, given every
	 *  <Detail> wrapper it sits inside. Empty array = never visible. */
	function visibleLevels(el: Element): number[] {
		let lo = 1;
		let hi = 3;
		let node: Element | null = el.closest('[data-dmin]');
		while (node) {
			lo = Math.max(lo, parseInt(node.getAttribute('data-dmin') || '1', 10));
			hi = Math.min(hi, parseInt(node.getAttribute('data-dmax') || '3', 10));
			node = node.parentElement ? node.parentElement.closest('[data-dmin]') : null;
		}
		const out: number[] = [];
		for (let l = lo; l <= hi; l++) out.push(l);
		return out;
	}

	/** Starlight builds the ToC from headings at build time; keep it honest
	 *  by hiding entries whose headings are hidden at the current level. */
	function updateToc(level: number) {
		const links = document.querySelectorAll(
			'starlight-toc a[href^="#"], mobile-starlight-toc a[href^="#"]',
		);
		links.forEach((a) => {
			const id = decodeURIComponent((a.getAttribute('href') || '').slice(1));
			const heading = id && document.getElementById(id);
			if (!heading) return;
			const item = a.closest('li');
			if (item) item.hidden = !visibleLevels(heading).includes(level);
		});
	}

	function setLevel(level: number, persist = true) {
		root.dataset.detail = String(level);
		if (persist) {
			try {
				localStorage.setItem(KEY, String(level));
			} catch {
				/* private browsing */
			}
		}
		updateToc(level);
		window.dispatchEvent(new CustomEvent('bruh-detail-change', { detail: level }));
	}

	let toastEl: HTMLElement | null = null;
	function toast(message: string) {
		if (toastEl) toastEl.remove();
		const el = document.createElement('div');
		el.className = 'detail-toast';
		el.setAttribute('role', 'status');
		el.textContent = message;
		document.body.appendChild(el);
		toastEl = el;
		setTimeout(() => {
			el.classList.add('is-leaving');
			setTimeout(() => el.remove(), 450);
		}, 3200);
	}

	/** Search results and shared #links can point inside hidden content —
	 *  never dead-end: bump the level (without persisting) to reveal it. */
	function revealHashTarget() {
		const id = decodeURIComponent(location.hash.slice(1));
		const el = id ? document.getElementById(id) : null;
		if (!el) return;
		const levels = visibleLevels(el);
		if (!levels.length || levels.includes(current())) return;
		const target = levels.find((l) => l > current()) ?? levels[levels.length - 1];
		setLevel(target, false);
		toast(`Showing “${NAMES[target - 1]}” to reveal this section`);
		setTimeout(() => el.scrollIntoView({ block: 'start' }), 500);
	}

	class BruhDetailControl extends HTMLElement {
		#buttons: HTMLButtonElement[] = [];

		connectedCallback() {
			// Only appear on pages that actually have level-tagged content.
			if (!document.querySelector('[data-dmin]')) return;
			this.#buttons = Array.from(this.querySelectorAll('button'));
			if (!this.#buttons.length) return;
			this.hidden = false;

			this.#sync(current());
			this.#buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					setLevel(parseInt(btn.dataset.level || '1', 10));
				});
			});
			window.addEventListener('bruh-detail-change', ((e: CustomEvent) =>
				this.#sync(e.detail as number)) as EventListener);
		}

		#sync(level: number) {
			this.#buttons.forEach((btn) => {
				btn.setAttribute(
					'aria-pressed',
					btn.dataset.level === String(level) ? 'true' : 'false',
				);
			});
		}
	}

	if (!customElements.get('bruh-detail-control')) {
		customElements.define('bruh-detail-control', BruhDetailControl);
	}

	// Initial pass: the head script has already stamped data-detail.
	updateToc(current());
	revealHashTarget();
	window.addEventListener('hashchange', revealHashTarget);
</script>
