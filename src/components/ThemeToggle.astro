---
// Replaces Starlight's default ThemeSelect dropdown with a simple sun/moon toggle.
// Cycles: dark → light → dark (no "auto" — respects system preference on first load).
---

<starlight-theme-toggle>
	<button aria-label="Toggle theme">
		<svg class="sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="5"/>
			<line x1="12" y1="1" x2="12" y2="3"/>
			<line x1="12" y1="21" x2="12" y2="23"/>
			<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
			<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
			<line x1="1" y1="12" x2="3" y2="12"/>
			<line x1="21" y1="12" x2="23" y2="12"/>
			<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
			<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
		</svg>
		<svg class="moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
		</svg>
	</button>
</starlight-theme-toggle>

<style>
	button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition: color 0.2s ease;
	}
	button:hover {
		color: var(--sl-color-accent);
	}
	/* In dark mode: show sun (click to go light). In light mode: show moon (click to go dark). */
	:global([data-theme='dark']) .sun { display: block; }
	:global([data-theme='dark']) .moon { display: none; }
	:global([data-theme='light']) .sun { display: none; }
	:global([data-theme='light']) .moon { display: block; }
	/* Fallback for auto/initial: show sun */
	.sun { display: block; }
	.moon { display: none; }
</style>

<script>
	class StarlightThemeToggle extends HTMLElement {
		constructor() {
			super();

			const btn = this.querySelector('button');
			if (!btn) return;

			// Determine initial theme
			const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('starlight-theme') : null;
			const current = stored === 'light' || stored === 'dark'
				? stored
				: (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

			this.setTheme(current);

			btn.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				this.setTheme(next);
			});
		}

		setTheme(theme: string) {
			document.documentElement.dataset.theme = theme;
			if (typeof localStorage !== 'undefined') {
				localStorage.setItem('starlight-theme', theme);
			}
			// Sync Starlight's built-in pickers if they exist
			if (typeof StarlightThemeProvider !== 'undefined') {
				StarlightThemeProvider.updatePickers(theme);
			}
		}
	}

	customElements.define('starlight-theme-toggle', StarlightThemeToggle);
</script>
