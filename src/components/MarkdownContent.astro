---
/**
 * Starlight `MarkdownContent` override: docks the Detail control at the top
 * of every page's content — under the page title on docs pages, under the
 * hero on splash pages — so it's equally visible on desktop and mobile.
 * The control hides itself on pages with no level-tagged content.
 */
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import DetailControl from './DetailControl.astro';
---

<DetailControl />
<Default><slot /></Default>
