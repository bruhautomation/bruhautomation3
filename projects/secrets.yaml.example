# secrets.yaml — replace these with your actual values

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
wifi_ssid_iot: "YOUR_IOT_WIFI_SSID"
wifi_password_iot: "YOUR_IOT_WIFI_PASSWORD"
ota_password: "YOUR_OTA_PASSWORD"
api_key: "YOUR_API_ENCRYPTION_KEY"

# Legacy plaintext API password — only bruh_blinds.yaml still uses this form.
# Current ESPHome removed `api: password:`; see that project's page for the
# one-line migration to `api: encryption: key:`.
api_password: "YOUR_API_PASSWORD"

# The password for the fallback access point a device puts up when it can't
# reach your WiFi. You only ever type it while recovering a device, so it can be
# anything — but it should be yours, not one copied out of someone's repo.
ap_password: "YOUR_FALLBACK_AP_PASSWORD"
