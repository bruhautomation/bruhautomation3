---
/**
 * Everything a reader needs to actually build the project: the printable parts
 * in a viewer they can spin, the firmware config in full, and one link to the
 * folder holding the rest.
 *
 * It reads the project folder at build time rather than being told what's
 * there, so a part added to `projects/<slug>/models/` shows up in the preview
 * and a config edited on GitHub shows up in the code block — the site rebuilds
 * on every push, so the page can never quote a file that no longer exists. A
 * client-side fetch of raw.githubusercontent.com would be no fresher between
 * pushes (a push is what changes the file), and would cost the syntax
 * highlighting, a round trip, and eventually a rate limit. The "View on
 * GitHub" link next to each file is there for anyone who wants the byte-exact
 * current version anyway.
 */
import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { Code } from 'astro-expressive-code/components';
import StlViewer from './StlViewer.astro';

interface Props {
	/** The project folder name, e.g. "tablet-wall-mount". */
	slug: string;
}

const { slug } = Astro.props;

const REPO = 'https://github.com/bruhautomation/bruhautomation3';
const projectDir = join(process.cwd(), 'projects', slug);

if (!existsSync(projectDir)) {
	throw new Error(
		`<ProjectFiles slug="${slug}"> — there is no projects/${slug}/ folder. ` +
			`The slug must match the folder name.`
	);
}

const folderUrl = `${REPO}/tree/main/projects/${slug}`;
const blobUrl = (path: string) => `${REPO}/blob/main/projects/${slug}/${path}`;
const rawUrl = (path: string) => `${REPO}/raw/main/projects/${slug}/${path}`;

type Entry = { name: string; path: string; size: number };

function filesIn(sub: string, extensions: string[]): Entry[] {
	const dir = join(projectDir, sub);
	if (!existsSync(dir)) return [];
	return readdirSync(dir)
		.filter((name) => extensions.some((ext) => name.toLowerCase().endsWith(ext)))
		// Sort on the stem, so `part.stl` and `part_insert.stl` land in that
		// order rather than however the locale ranks `.` against `_`.
		.sort((a, b) =>
			a.replace(/\.[^.]+$/, '').localeCompare(b.replace(/\.[^.]+$/, ''), undefined, { numeric: true })
		)
		.map((name) => ({ name, path: `${sub}/${name}`, size: statSync(join(dir, name)).size }));
}

/**
 * How many matching files a folder holds, including nested ones — an Arduino
 * sketch lives in a directory of its own, so `firmware/` is usually a folder of
 * folders and a flat read of it finds nothing.
 */
function countFiles(sub: string, extensions: string[]): number {
	const dir = join(projectDir, sub);
	if (!existsSync(dir)) return 0;
	let count = 0;
	const walk = (current: string) => {
		for (const entry of readdirSync(current, { withFileTypes: true })) {
			if (entry.isDirectory()) walk(join(current, entry.name));
			else if (extensions.some((ext) => entry.name.toLowerCase().endsWith(ext))) count++;
		}
	};
	walk(dir);
	return count;
}

/**
 * Like `filesIn`, but walks nested folders and keeps the path relative to
 * `sub` — an Arduino sketch lives in a directory named after itself, so a flat
 * read of `firmware/` finds nothing to link.
 */
function filesInDeep(sub: string, extensions: string[]): Entry[] {
	const dir = join(projectDir, sub);
	if (!existsSync(dir)) return [];
	const found: Entry[] = [];
	const walk = (current: string, prefix: string) => {
		for (const entry of readdirSync(current, { withFileTypes: true }).sort((a, b) =>
			a.name.localeCompare(b.name, undefined, { numeric: true })
		)) {
			const path = prefix ? `${prefix}/${entry.name}` : entry.name;
			if (entry.isDirectory()) walk(join(current, entry.name), path);
			else if (extensions.some((ext) => entry.name.toLowerCase().endsWith(ext)))
				found.push({
					name: path,
					path: `${sub}/${path}`,
					size: statSync(join(current, entry.name)).size,
				});
		}
	};
	walk(dir, '');
	return found;
}

function formatSize(bytes: number) {
	return bytes >= 1024 * 1024
		? `${(bytes / 1024 / 1024).toFixed(1)} MB`
		: `${Math.max(1, Math.round(bytes / 1024))} KB`;
}

const models = filesIn('models', ['.stl']);

// Tessellated from the CAD by site/scripts/build-cad-previews.py, for parts
// that were never exported to STL by hand. They go in the viewer so a project
// that only ships CAD can still be looked at, but they are never offered as a
// download: the tessellation is approximate where the STEP is exact, and
// handing someone a mesh labelled like an export is how a bad print happens.
// A preview whose stem also exists in models/ is skipped — the script promotes
// a printable-tolerance preview into models/, and listing both put the same
// mesh in the picker twice, once mislabelled *from CAD*.
const modelNames = new Set(models.map((model) => model.name));
const previews = filesIn('preview', ['.stl']).filter((preview) => !modelNames.has(preview.name));

const configs = filesIn('esphome', ['.yaml', '.yml']).map((entry) => {
	const code = readFileSync(join(projectDir, entry.path), 'utf8').replace(/\s+$/, '');
	return { ...entry, code, lines: code.split('\n').length };
});

// CAD gets named rows rather than a count: a STEP opens in anything and is the
// exact model, which makes it the most useful file in the folder for anyone
// who wants to change the design rather than print it as-is.
const CAD_KINDS = {
	'.step': 'STEP — opens in Fusion 360, FreeCAD, Onshape, SolidWorks',
	'.stp': 'STEP — opens in Fusion 360, FreeCAD, Onshape, SolidWorks',
	'.f3d': 'Fusion 360 archive — the editable design, with its history',
};
const cad = filesIn('cad', Object.keys(CAD_KINDS)).map((entry) => ({
	...entry,
	kind: CAD_KINDS[entry.name.slice(entry.name.lastIndexOf('.')).toLowerCase()] ?? 'CAD file',
}));

// Custom components a config `#include`s. They sit in `esphome/` beside the
// YAML that needs them, and a config quoted in full while the header it depends
// on goes unmentioned is a config nobody can actually compile.
const headers = filesIn('esphome', ['.h', '.cpp']);

// Cut files and firmware get named, downloadable rows rather than a count. For
// a project whose whole output is a stack of DXFs, a line reading "laser-cut/ —
// 11 files" is the page failing to deliver the project.
const laserCut = filesInDeep('laser-cut', ['.dxf', '.svg']);
const firmware = filesInDeep('firmware', ['.ino', '.h', '.cpp']);

// The rest of the folder, counted rather than listed.
const otherFolders = [
	{ dir: 'arduino-legacy', label: 'legacy Arduino sketches', exts: ['.ino', '.h'] },
	{ dir: 'fritzing', label: 'wiring diagrams', exts: ['.fzz'] },
	{ dir: 'nextion-hmi', label: 'Nextion display projects', exts: ['.hmi'] },
	{ dir: 'nextion-assets', label: 'Nextion UI artwork', exts: ['.png', '.jpg'] },
]
	.map((group) => ({ ...group, count: countFiles(group.dir, group.exts) }))
	.filter((group) => group.count > 0);

// Everything the viewer can show, authored exports first. A preview carries the
// label into the picker so you always know which one you are looking at.
const viewable = [
	...models.map((model) => ({ name: model.name.replace(/\.stl$/i, ''), src: `/models/${slug}/${model.name}` })),
	...previews.map((model) => ({
		name: `${model.name.replace(/\.stl$/i, '')} (from CAD)`,
		src: `/models/${slug}/preview/${model.name}`,
	})),
];

// Long lists fold rather than truncate. Sending someone to GitHub for the other
// 50 parts is sending them away from the download links: the bioreactor ships 62
// STLs and only 12 of them were reachable from the page that documents it.
const MODEL_ROWS = 24;
const shownModels = models.slice(0, MODEL_ROWS);
const restModels = models.slice(MODEL_ROWS);

// A config short enough to take in at a glance is open; anything longer starts
// folded, because a 400-line YAML between two paragraphs is a page break.
const OPEN_UNDER_LINES = 60;
const configsToRender = configs.map((config) => ({ ...config, open: config.lines < OPEN_UNDER_LINES }));
---

<div class="project-files" data-project={slug}>
	{
		viewable.length > 0 && (
			<>
				<h3 id="the-parts">{models.length > 0 ? 'Printable parts' : 'The parts'}</h3>
				<StlViewer models={viewable} />
				{models.length > 0 && (
					<ul class="file-list">
						{shownModels.map((model) => (
							<li>
								<a href={`/models/${slug}/${model.name}`} download>
									{model.name}
								</a>
								<span class="file-meta">{formatSize(model.size)}</span>
							</li>
						))}
					</ul>
				)}
				{restModels.length > 0 && (
					<details class="more-parts">
						<summary>
							{restModels.length} more {restModels.length === 1 ? 'part' : 'parts'}
						</summary>
						<ul class="file-list">
							{restModels.map((model) => (
								<li>
									<a href={`/models/${slug}/${model.name}`} download>
										{model.name}
									</a>
									<span class="file-meta">{formatSize(model.size)}</span>
								</li>
							))}
						</ul>
					</details>
				)}
				{previews.length > 0 && (
					<p class="file-meta">
						{models.length > 0 ? (
							<>
								Parts marked <em>from CAD</em> are tessellated
							</>
						) : (
							'These are tessellated'
						)}
						{' from the STEP files below, for previewing only — approximate where the STEP is '}
						exact. Download the STEP for the real model.
					</p>
				)}
			</>
		)
	}

	{
		configs.length > 0 && (
			<>
				<h3 id="esphome-configuration">
					ESPHome configuration
					{configs.length > 1 ? `s (${configs.length})` : ''}
				</h3>
				<p>
					Copy this into your ESPHome directory and adjust the substitutions at the top.
					Secrets are referenced by name — see{' '}
					<a href={`${REPO}/blob/main/projects/secrets.yaml.example`}>
						<code>secrets.yaml.example</code>
					</a>
					.
				</p>
				{configsToRender.map((config) => (
					<details class="config" open={config.open}>
						<summary>
							<code>{config.name}</code>
							<span class="file-meta">{config.lines} lines</span>
						</summary>
						<Code code={config.code} lang="yaml" meta={`title="${config.name}"`} />
						<p class="file-more">
							<a href={blobUrl(config.path)}>View on GitHub</a> ·{' '}
							<a href={rawUrl(config.path)}>Download raw</a>
						</p>
					</details>
				))}
				{headers.length > 0 && (
					<>
						<p>
							{headers.length === 1 ? 'This config ' : 'These configs '}
							<code>includes</code> a custom component. Save it in the same folder as the
							YAML above, or the compile fails on a missing header.
						</p>
						<ul class="file-list">
							{headers.map((file) => (
								<li>
									<a href={rawUrl(file.path)}>{file.name}</a>
									<span class="file-meta">{formatSize(file.size)}</span>
								</li>
							))}
						</ul>
					</>
				)}
			</>
		)
	}

	{
		laserCut.length > 0 && (
			<>
				<h3 id="laser-cut-files">Laser-cut files</h3>
				<p>
					Vector cut paths. Check the scale against the drawing before you cut — some
					laser software re-scales an imported DXF on open.
				</p>
				<ul class="file-list">
					{laserCut.map((file) => (
						<li>
							<a href={rawUrl(file.path)}>{file.name}</a>
							<span class="file-meta">{formatSize(file.size)}</span>
						</li>
					))}
				</ul>
			</>
		)
	}

	{
		firmware.length > 0 && (
			<>
				<h3 id="firmware">Firmware</h3>
				<p>
					The sketch that runs on the microcontroller. Open the <code>.ino</code> in the
					Arduino IDE — keep it in a folder of the same name, which is how the IDE expects
					to find a sketch.
				</p>
				<ul class="file-list">
					{firmware.map((file) => (
						<li>
							<a href={rawUrl(file.path)}>{file.name}</a>
							<span class="file-meta">{formatSize(file.size)}</span>
						</li>
					))}
				</ul>
			</>
		)
	}

	{
		cad.length > 0 && (
			<>
				<h3 id="cad-source">CAD source</h3>
				<p>
					The design itself, if you want to change it rather than print it. A STEP file is
					exact geometry and opens in almost anything; a Fusion 360 archive keeps the
					modelling history, so you can go back and edit the sketch that made the part.
				</p>
				<ul class="cad-list">
					{cad.map((file) => (
						<li>
							<a href={rawUrl(file.path)}>{file.name}</a>
							<span class="file-meta">{formatSize(file.size)}</span>
							<span class="cad-kind">{file.kind}</span>
						</li>
					))}
				</ul>
			</>
		)
	}

	{
		models.length === 0 && previews.length === 0 && configs.length === 0 && cad.length === 0 && laserCut.length === 0 && firmware.length === 0 && otherFolders.length === 0 && (
			<p class="file-empty">
				The source files for this project aren't in the repo yet — there's nothing to download
				beyond the notes. They land in <code>projects/{slug}/</code> when they do, and this
				section fills itself in.
			</p>
		)
	}

	<p class="project-folder">
		<a href={folderUrl}>
			<strong>Every file for this project on GitHub →</strong>
		</a>
		{otherFolders.length > 0 && (
			<span class="file-meta">
				{'Also in the folder: '}
				{otherFolders.map((group, i) => (
					<>
						<code>{group.dir}/</code>
						{` — ${group.label}, ${group.count} ${group.count === 1 ? 'file' : 'files'}` +
							(i < otherFolders.length - 1 ? '; ' : '.')}
					</>
				))}
			</span>
		)}
	</p>
</div>

<style>
	.project-files {
		margin-top: 1rem;
	}
	.project-files :global(h3) {
		margin-top: 1.5rem;
	}

	.file-list {
		list-style: none;
		padding: 0;
		margin: 0.75rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.file-list li {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 6px;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-xs);
	}
	.file-list a {
		font-family: var(--sl-font-system-mono, monospace);
	}

	.file-meta {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	.cad-list {
		list-style: none;
		padding: 0;
		margin: 0.75rem 0 0;
	}
	.cad-list li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0 0 0.4rem;
		padding: 0.5rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 6px;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
	}
	.cad-list a {
		font-family: var(--sl-font-system-mono, monospace);
	}
	.cad-kind {
		flex-basis: 100%;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.more-parts {
		margin-top: 0.6rem;
	}
	.more-parts summary {
		cursor: pointer;
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-sm);
	}

	.file-empty {
		margin-top: 0.75rem;
		color: var(--sl-color-gray-2);
	}
	.file-more {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
	}

	.config {
		margin-top: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		padding: 0.5rem 0.75rem;
	}
	.config > summary {
		cursor: pointer;
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		/* 44px of target: this is the control that opens a 400-line file. */
		min-height: 44px;
		align-content: center;
		flex-wrap: wrap;
	}
	.config[open] > summary {
		margin-bottom: 0.5rem;
	}

	.project-folder {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-gray-5);
	}
</style>
