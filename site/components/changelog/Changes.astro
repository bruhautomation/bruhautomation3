---
/**
 * A category group inside a <Release> — a coloured Keep a Changelog badge
 * (Added / Changed / Fixed / Removed / Deprecated / Security) followed by the
 * list of changes written as Markdown in the slot.
 *
 * Usage (inside an .mdx <Release>):
 *
 *   <Changes type="added">
 *
 *   - **Lead-in.** Description of the change.
 *
 *   </Changes>
 */
interface Props {
	type?: 'added' | 'changed' | 'fixed' | 'removed' | 'deprecated' | 'security';
}

const ICONS = {
	// lucide icons, stroked with currentColor
	added: '<path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-10"/><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4 2.3-.4 4.2-.1 5.5.6Z"/><path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2Z"/>',
	changed:
		'<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
	fixed: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
	removed: '<circle cx="12" cy="12" r="10"/><path d="M8 12h8"/>',
	deprecated:
		'<rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/>',
	security:
		'<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
};

const LABELS = {
	added: 'Added',
	changed: 'Changed',
	fixed: 'Fixed',
	removed: 'Removed',
	deprecated: 'Deprecated',
	security: 'Security',
};

const { type = 'changed' } = Astro.props;
const icon = ICONS[type] ?? ICONS.changed;
const label = LABELS[type] ?? type;
---

<div class="changelog-changes">
	<span class={`changelog-badge changelog-badge--${type}`}>
		<svg
			class="changelog-badge-icon"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			set:html={icon}
		/>
		{label}
	</span>
	<div class="changelog-change-list">
		<slot />
	</div>
</div>
