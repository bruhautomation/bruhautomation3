---
/**
 * "Pending write-ups" — the header switch that reveals the projects whose files
 * are published ahead of their prose.
 *
 * Those pages are real and reachable by URL, by search and from the project
 * list; what this controls is only whether they clutter the sidebar. Fifty-six
 * of sixty-four projects are pending, so showing them by default buries the
 * eight finished guides in a list four times longer than the site people came
 * for. Off by default, remembered once set.
 *
 * The confirmation is shown the first time it is switched on and never again —
 * it exists to set the expectation before someone opens a thin page and decides
 * the project is thin, which a checkbox label has no room to do. Turning it back
 * off is silent; nobody needs a dialog to hide something.
 *
 * Everything is a class on <html>, so the stylesheet does the showing and there
 * is no per-page state to keep in step. The initial read is inline in
 * `head` (see astro.config.mjs) so a reader who has opted in never watches the
 * rows appear after paint.
 */
---

<div class="pending-toggle">
	<label class="pending-toggle__label">
		<input type="checkbox" id="pending-switch" />
		<span class="pending-toggle__text">Pending write-ups</span>
	</label>
</div>

<dialog id="pending-dialog" class="pending-dialog" aria-labelledby="pending-dialog-title">
	<h2 id="pending-dialog-title">Show projects that aren't written up yet?</h2>
	<p>
		Most of these projects have their files ready — print files, CAD sources and
		configs — but the written guide hasn't been finished yet. I'm backfilling the
		documentation for all of them as fast as I can.
	</p>
	<p>
		Turning this on adds them to the sidebar, marked with a small dot. Expect a
		short page and a full set of files.
	</p>
	<form method="dialog" class="pending-dialog__actions">
		<button value="cancel">Not now</button>
		<button value="confirm" class="pending-dialog__confirm" autofocus>Show them</button>
	</form>
</dialog>

<script is:inline>
	(function () {
		var KEY = 'bruh:show-pending';
		var ASKED = 'bruh:show-pending-asked';
		var root = document.documentElement;

		function store(key, value) {
			// An iframe or a locked-down browser can refuse localStorage, and a
			// throw here would take out the listeners below it.
			try {
				value === null ? localStorage.removeItem(key) : localStorage.setItem(key, value);
			} catch (e) {}
		}
		function read(key) {
			try {
				return localStorage.getItem(key);
			} catch (e) {
				return null;
			}
		}

		function apply(on) {
			root.classList.toggle('show-pending', on);
			var box = document.getElementById('pending-switch');
			if (box) box.checked = on;
		}

		function wire() {
			var box = document.getElementById('pending-switch');
			var dialog = document.getElementById('pending-dialog');
			if (!box) return;

			apply(read(KEY) === 'true');

			box.addEventListener('change', function () {
				if (!box.checked) {
					store(KEY, 'false');
					apply(false);
					return;
				}

				// Explain once, the first time. After that the switch is just a switch.
				if (read(ASKED) === 'true' || !dialog || !dialog.showModal) {
					store(KEY, 'true');
					store(ASKED, 'true');
					apply(true);
					return;
				}

				box.checked = false;
				dialog.showModal();
				dialog.addEventListener(
					'close',
					function () {
						var yes = dialog.returnValue === 'confirm';
						store(ASKED, 'true');
						store(KEY, yes ? 'true' : 'false');
						apply(yes);
					},
					{ once: true }
				);
			});
		}

		wire();
		// Starlight swaps the document on navigation; the header is re-rendered
		// with a fresh, unwired checkbox each time.
		document.addEventListener('astro:page-load', wire);
	})();
</script>

<style>
	.pending-toggle {
		display: inline-flex;
		align-items: center;
	}
	.pending-toggle__label {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding-inline: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		cursor: pointer;
		white-space: nowrap;
		user-select: none;
	}
	.pending-toggle__label:hover {
		color: var(--sl-color-white);
	}
	.pending-toggle input {
		accent-color: var(--sl-color-accent);
		cursor: pointer;
		/* A checkbox is a small target; the label carries the rest of it. */
		margin: 0;
	}
	@media (pointer: coarse) {
		.pending-toggle__label {
			min-height: 44px;
		}
	}
	/* The header is tight on a phone — search, theme and two social icons are
	   already competing. The words go and the box stays, with the label moved
	   onto the control itself. */
	@media (max-width: 72rem) {
		.pending-toggle__text {
			display: none;
		}
	}

	.pending-dialog {
		max-width: 32rem;
		margin: auto;
		padding: 1.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-2);
	}
	.pending-dialog::backdrop {
		background: rgb(0 0 0 / 0.6);
	}
	.pending-dialog h2 {
		margin: 0 0 0.75rem;
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		line-height: 1.3;
	}
	.pending-dialog p {
		margin: 0 0 0.75rem;
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}
	.pending-dialog__actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.6rem;
		margin-block-start: 1.25rem;
	}
	.pending-dialog__actions button {
		min-height: 44px;
		padding-inline: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		background: transparent;
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.pending-dialog__actions button:hover {
		background: var(--sl-color-gray-6);
	}
	.pending-dialog__confirm {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
	}
</style>
