---
/**
 * A visible placeholder for an image that still needs to be added. Renders a
 * dashed box describing what to capture and the exact alt text the real image
 * should use — so dropping in the final asset is a copy-paste.
 *
 * Usage (from a project page, `projects/<slug>/index.mdx`):
 *   import ImagePlaceholder from '../../site/components/ImagePlaceholder.astro';
 *
 * From `apps/<app>/` it is the same path; from `apps/<app>/<section>/` add one
 * more `../`. The path this docstring carried before resolved from nowhere in
 * the repo, which is a good way to make a component look broken.
 *
 *   <ImagePlaceholder alt="The BRUH Minecraft panel dashboard showing live TPS and players">
 *     Screenshot of the **Dashboard** tab — status, uptime, memory, TPS, online players.
 *   </ImagePlaceholder>
 *
 * When you have the asset, replace the whole tag with:
 *   ![The BRUH Minecraft panel dashboard showing live TPS and players](/images/.../dashboard.png)
 */
interface Props {
	/** Alt text the final image should use (shown so it's ready to copy). */
	alt: string;
	/** Short heading. Defaults to "Image needed". */
	label?: string;
}

const { alt, label = 'Image needed' } = Astro.props;
const hasNote = Astro.slots.has('default');

// A dashed "Image needed" box is a note to whoever is writing the page, not
// something a reader came for — on the live site it just says the guide isn't
// finished. It renders on dev and Vercel Preview, where the author sees it, and
// on production the page simply reads without the picture. The shot list in
// docs/IMAGES-NEEDED.md is the record either way, so nothing gets lost by the
// box being invisible where it would only be noise.
const showPlaceholders = import.meta.env.MODE !== 'production';
---

{showPlaceholders && (

<figure class="img-placeholder" role="img" aria-label={`Placeholder — image needed: ${alt}`}>
	<div class="img-placeholder__inner">
		<svg
			class="img-placeholder__icon"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<rect width="18" height="18" x="3" y="3" rx="2" />
			<circle cx="9" cy="9" r="2" />
			<path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
		</svg>
		<p class="img-placeholder__label">{label}</p>
		{hasNote && <p class="img-placeholder__note"><slot /></p>}
		<p class="img-placeholder__alt"><span>alt text</span> <code>{alt}</code></p>
	</div>
</figure>
)}
