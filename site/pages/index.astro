					class="hero-logo logo-for-light"
					src={logoDark.src}
					alt="BRUH Automation"
				/>
				<h1>Home Automation for Everyone</h1>
				<p class="hero-tagline">
					Smart home gear, 3D prints, workshop fixes, and lab tools —
					everything I build, with the files to build it yourself.
				</p>
				<div class="hero-actions">
					<a href="/project-list/" class="btn btn-primary">
						Browse Projects
						<svg aria-hidden="true" focusable="false"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
						>
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
					<a href="/apps/" class="btn btn-outline">Explore the Apps</a>
					<a
						href="https://www.youtube.com/@BRUHAutomation1"
						class="btn btn-outline"
						target="_blank"
						rel="noopener"
					>
						<svg aria-hidden="true" focusable="false"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path
								d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
							></path>
						</svg>
						YouTube
					</a>
				</div>
			</section>

			<!-- Stats -->
			<section class="stats">
				{
					stats.map((s) => (
						<div class="stat">
							<div class="stat-number">{s.number}</div>
							<div class="stat-label" set:html={s.label} />
						</div>
					))
				}
			</section>

			<!-- Apps -->
			<section class="apps" aria-labelledby="apps-heading">
				<div class="section-head">
					<p class="eyebrow">Home Assistant Apps</p>
					<h2 id="apps-heading">Software for the house, too</h2>
					<p class="section-sub">
						{APP_LIST.length} open-source apps for Home Assistant, from one repository. brAIn is
						the mind; the rest give it hands.
					</p>
				</div>
				<a href={featuredApp.href} class="app-featured">
					<div class="app-featured-text">
						<div class="app-title-row">
							<img src={featuredApp.icon} alt="" width="56" height="56" loading="lazy" />
							<div>
								<h3>{featuredApp.name}</h3>
								<p class="app-tagline">{featuredApp.tagline}</p>
							</div>
						</div>
						<p>{featuredApp.blurb}</p>
						<ul class="app-tags">{featuredApp.tags.map((t) => <li>{t}</li>)}</ul>
						<span class="cat-link">
							Meet brAIn <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
						</span>
					</div>
					<div class="app-featured-shot">
						<img
							src={brainHero.src}
							width={brainHero.width}
							height={brainHero.height}
							alt="brAIn's Home tab: the Morph dashboard with a plain-language summary of the house, a Coming up timeline, scenes and rooms of live controls"
							loading="lazy"
						/>
					</div>
				</a>
				<div class="app-grid">
					{
						otherApps.map((app) => (
							<a href={app.href} class="app-tile">
								<div class="app-title-row">
									<img src={app.icon} alt="" width="44" height="44" loading="lazy" />
									<div>
										<h3>
											{app.name}
											{app.experimental && <span class="app-badge">Experimental</span>}
										</h3>
										<p class="app-tagline">{app.tagline}</p>
									</div>
								</div>
								<p>{app.blurb}</p>
							</a>
						))
					}
				</div>
				<p class="apps-more">
					<a href="/apps/">Compare every app, what each needs and how they work together →</a>
				</p>
			</section>

			<!-- Categories -->
			<section class="categories">
				{
					cards.map((card) => (
						<a href={card.href} class="cat-card">
							<div class="cat-icon">
								<svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
							</div>
							<h3>{card.title}</h3>
							<p>{card.blurb}</p>
							<span class="cat-link">
								Explore <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
							</span>
						</a>
					))
				}
			</section>

			{/* Most projects have their files up and their write-up still to come.
			    Saying so on the front page is better than letting someone find it
			    one project at a time. */}
			<section class="catchup">
				<p>
					I'm catching up on the documentation for all of these, so expect a lot
					more soon. If there's one you want sooner, head over to
					<a
						href="https://github.com/bruhautomation/bruhautomation3/discussions"
						>GitHub Discussions</a
					> and let me know — I'll bump it up the list.
				</p>
			</section>
		</main>

		<footer>
			&copy; 2015–2026 BRUH Automation &middot; Open Source &middot;
			<a
				href="https://github.com/bruhautomation"
				target="_blank"
				rel="noopener">GitHub</a
			>
		</footer>

		<script is:inline>
			// Theme toggle logic for the landing page
			(function () {
				var toggle = document.getElementById('theme-toggle');
				var pill = document.getElementById('toggle-pill');
				if (!toggle || !pill) return;

				var stored = localStorage.getItem('starlight-theme');
				var current =
					stored === 'light' || stored === 'dark' ? stored : 'auto';
				setUI(current);

				toggle.addEventListener('click', function (e) {
					var btn = e.target.closest('button[data-value]');
					if (!btn) return;
					var val = btn.getAttribute('data-value');
					apply(val);
				});

				function setUI(theme) {
					var posMap = { light: '0', auto: '1', dark: '2' };
					pill.setAttribute('data-pos', posMap[theme] || '1');
					var btns = toggle.querySelectorAll('button');
					btns.forEach(function (b) {
						b.setAttribute(
							'aria-pressed',
							b.getAttribute('data-value') === theme
								? 'true'
								: 'false',
						);
					});
				}

				function apply(theme) {
					setUI(theme);
					var resolved = theme;
					if (theme === 'auto') {
						resolved = matchMedia(
							'(prefers-color-scheme: light)',
						).matches
							? 'light'
							: 'dark';
					}
					document.documentElement.dataset.theme = resolved;
					localStorage.setItem('starlight-theme', theme);
				}
			})();
		</script>
	</body>
</html>
