---
// Custom landing page — standalone, outside Starlight's content collection.
import logoLight from '../assets/bruh-logo-light.svg';
import logoDark from '../assets/bruh-logo-dark.svg';
import { APPS, APP_LIST, groupByCategory, readProjects } from '../catalog.mjs';
import brainHero from '../assets/images/apps/brain-hero.webp';

// Counts come from the project folders, so the numbers on the front page are
// the repo — not a figure anyone has to remember to bump. A project counts as
// having a guide only when that guide is actually built: drafts are pages on
// Vercel Preview and local dev, and nothing on the live site, which is the same
// signal Starlight uses for its own draft gate.
const showDrafts = import.meta.env.MODE !== 'production';
const projects = readProjects().map((p) => ({
	...p,
	guide: p.guide && (showDrafts || !p.draft),
}));
const groups = groupByCategory(projects);
const stats = [
	{ number: projects.length, label: 'Open Source<br />Projects' },
	// Guides that are actually written. A project whose write-up is pending is
	// published and usable, but counting it here would make the number a count
	// of folders and the label a claim the site does not meet.
	{ number: projects.filter((p) => p.guide && !p.pending).length, label: 'Build<br />Guides' },
	{ number: projects.filter((p) => p.tags.includes('esphome')).length, label: 'ESPHome<br />Devices' },
	{ number: APP_LIST.length, label: 'HA<br />Apps' },
];

// One card per category, in catalog order, each landing on its own section of
// the project list. The glyphs come from the catalog, which is also where the
// sidebar gets them — one icon per category, defined once.
// brAIn gets the wide card with a picture; every other app is a tile.
const [featuredApp, ...otherApps] = APP_LIST;

const cards = [...groups, APPS].map((group) => ({
	// The apps have a hub of their own; the categories land on their section
	// of the project list.
	href: group.id === APPS.id ? '/apps/' : `/project-list/#${group.id}`,
	title: group.label,
	blurb: group.blurb,
	icon: group.icon,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>BRUH Automation — Home Automation for Everyone</title>
		<meta
			name="description"
			content="Smart home gear, 3D prints, workshop fixes, and lab tools — everything I build, with the files to build it yourself. Print files, CAD sources, ESPHome configs, and honest build guides."
		/>
		<link rel="canonical" href="https://bruhautomation.com/" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="BRUH Automation" />
		<meta property="og:title" content="BRUH Automation — Home Automation for Everyone" />
		<meta property="og:url" content="https://bruhautomation.com/" />
		<meta
			property="og:description"
			content="Smart home gear, 3D prints, workshop fixes, and lab tools — everything I build, with the files to build it yourself. Print files, CAD sources, ESPHome configs, and honest build guides."
		/>
		<meta property="og:image" content="https://bruhautomation.com/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="BRUH Automation — smart home, 3D printing, and lab projects" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="BRUH Automation — Home Automation for Everyone" />
		<meta
			name="twitter:description"
			content="Smart home gear, 3D prints, workshop fixes, and lab tools — everything I build, with the files to build it yourself. Print files, CAD sources, ESPHome configs, and honest build guides."
		/>
		<meta name="twitter:image" content="https://bruhautomation.com/og-image.png" />
		<meta name="theme-color" content="#1e90ff" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		{/* Fallback for anything that won't take an SVG icon, and for the bare
		    /favicon.ico request a browser makes whether we ask for it or not. */}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		{/* iOS composites a home-screen icon onto an opaque tile of its own
		    choosing, so it gets a deliberate one rather than a guess — drawn
		    square, because iOS rounds it again on the way in. */}
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		{/* Vercel Web Analytics. This page is outside Starlight's layout, so the
		    copy in astro.config.mjs's `head` never reaches it — a landing page
		    missing from the numbers is the one page you would notice. */}
		<script src="/_vercel/insights/script.js" defer></script>

		{/* Block render until theme is set — prevents flash */}
		<script is:inline>
			(function () {
				var s = localStorage.getItem('starlight-theme');
				var t =
					s === 'light'
						? 'light'
						: s === 'dark'
							? 'dark'
							: matchMedia('(prefers-color-scheme: light)').matches
								? 'light'
								: 'dark';
				document.documentElement.dataset.theme = t;
			})();
		</script>

		<style>
			/* ── Reset ── */
			*,
			*::before,
			*::after {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			/* ── Tokens ── */
			:root {
				--bg: #0b0d14;
				--bg-card: rgba(255, 255, 255, 0.04);
				--bg-card-solid: #14161e;
				--border: rgba(255, 255, 255, 0.08);
				--text: #e4e4e7;
				--text-muted: #9b9ba8;
				--accent: #1e90ff;
				--accent-glow: rgba(30, 144, 255, 0.15);
				--radius: 14px;
				--font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
					'Helvetica Neue', Arial, sans-serif;
			}
			[data-theme='light'] {
				--bg: #fafafa;
				--bg-card: rgba(0, 0, 0, 0.03);
				--bg-card-solid: #f0f0f2;
				--border: rgba(0, 0, 0, 0.08);
				--text: #18181b;
				--text-muted: #71717a;
				/* Darker accent on the near-white background so link/button text
				   clears WCAG AA (4.5:1); the brand #1e90ff only passes on dark. */
				--accent: #0969da;
				--accent-glow: rgba(30, 144, 255, 0.08);
			}

			html {
				background: var(--bg);
				color: var(--text);
				font-family: var(--font);
				scroll-behavior: smooth;
			}
			body {
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			.skip-link {
				position: absolute;
				top: -100px;
				left: 1rem;
				z-index: 200;
				padding: 0.6rem 1rem;
				border-radius: 8px;
				background: var(--accent);
				color: #fff;
				font-size: 0.9rem;
				font-weight: 600;
				transition: top 0.15s;
			}
			.skip-link:focus {
				top: 1rem;
			}

			/* ── Nav ── */
			nav {
				position: sticky;
				top: 0;
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: flex-end;
				max-width: 1100px;
				width: 100%;
				margin: 0 auto;
				padding: 1rem 1.5rem;
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
			}
			.nav-right {
				display: flex;
				align-items: center;
				gap: 1.75rem;
			}
			.nav-link {
				font-size: 0.9rem;
				font-weight: 500;
				color: var(--text-muted);
				transition: color 0.2s;
			}
			.nav-link:hover {
				color: var(--text);
			}

			/* ── Theme toggle ── */
			.theme-toggle {
				position: relative;
				display: inline-flex;
				align-items: center;
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 9999px;
				padding: 3px;
			}
			.theme-toggle button {
				position: relative;
				z-index: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 30px;
				height: 30px;
				border: none;
				border-radius: 50%;
				background: transparent;
				color: var(--text-muted);
				cursor: pointer;
				transition: color 0.2s;
				font-family: var(--font);
			}
			.theme-toggle button:hover {
				color: var(--text);
			}
			.theme-toggle button[aria-pressed='true'] {
				color: #fff;
			}
			.auto-label {
				font-size: 14px;
				font-weight: 700;
				line-height: 1;
			}
			.toggle-pill {
				position: absolute;
				top: 3px;
				left: 3px;
				width: 30px;
				height: 30px;
				border-radius: 50%;
				background: var(--accent);
				transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			}
			.toggle-pill[data-pos='1'] {
				transform: translateX(30px);
			}
			.toggle-pill[data-pos='2'] {
				transform: translateX(60px);
			}

			/* ── Hero ── */
			.hero {
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 4rem 1.5rem 4rem;
				min-height: 85vh;
				justify-content: center;
				overflow: visible;
			}
			.hero::before {
				content: '';
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: min(800px, 120vw);
				height: 600px;
				background: radial-gradient(
					ellipse,
					var(--accent-glow),
					transparent 70%
				);
				pointer-events: none;
			}
			.hero-logo {
				position: relative;
				width: min(380px, 75vw);
				height: auto;
				margin-bottom: 2rem;
			}
			.hero h1 {
				position: relative;
				font-size: clamp(2.2rem, 5.5vw, 3.5rem);
				font-weight: 700;
				line-height: 1.2;
				letter-spacing: -0.03em;
				max-width: 16ch;
				padding-bottom: 0.1em;
				color: var(--text);
				background: linear-gradient(
					135deg,
					var(--text) 0%,
					var(--accent) 100%
				);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.hero-tagline {
				position: relative;
				margin-top: 1.25rem;
				font-size: clamp(1rem, 2vw, 1.15rem);
				line-height: 1.6;
				color: var(--text-muted);
				max-width: 48ch;
			}
			.hero-actions {
				position: relative;
				display: flex;
				gap: 0.75rem;
				margin-top: 2.5rem;
				flex-wrap: wrap;
				justify-content: center;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.75rem 1.5rem;
				border-radius: 9999px;
				font-size: 0.95rem;
				font-weight: 600;
				transition:
					background 0.2s,
					transform 0.15s;
			}
			.btn:hover {
				transform: translateY(-1px);
			}
			.btn-primary {
				background: var(--accent);
				color: #fff;
			}
			.btn-primary:hover {
				background: #3a9fff;
			}
			.btn-outline {
				background: transparent;
				color: var(--text);
				border: 1px solid var(--border);
			}
			.btn-outline:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* ── Stats ── */
			.stats {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1rem;
				max-width: 800px;
				width: 100%;
				margin: 0 auto;
				padding: 0 1.5rem 4rem;
			}
			.stat {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.5rem 1rem;
				text-align: center;
				transition:
					border-color 0.2s,
					box-shadow 0.2s;
			}
			.stat:hover {
				border-color: var(--accent);
				box-shadow: 0 0 24px var(--accent-glow);
			}
			.stat-number {
				font-size: 2rem;
				font-weight: 700;
				color: var(--accent);
				line-height: 1;
			}
			.stat-label {
				margin-top: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-muted);
				line-height: 1.3;
			}

			/* ── Categories ── */
			.catchup {
				max-width: 1000px;
				width: 100%;
				margin: 0 auto;
				padding: 0 1.5rem 5rem;
			}
			.catchup p {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.1rem 1.35rem;
				color: var(--text-muted);
				font-size: 0.95rem;
				line-height: 1.65;
				text-align: center;
			}
			.catchup a {
				color: var(--accent);
				font-weight: 600;
			}
			.catchup a:hover {
				text-decoration: underline;
			}

			.categories {
				max-width: 1000px;
				width: 100%;
				margin: 0 auto;
				/* The catch-up note carries the bottom padding now, so the cards
				   stop short of it rather than leaving a gap twice over. */
				padding: 0 1.5rem 2rem;
				display: grid;
				/* Six cards — five categories and the apps — so three across
				   fills two even rows rather than leaving a short one. */
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
			}
			.cat-card {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 2rem 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				transition:
					border-color 0.2s,
					box-shadow 0.2s,
					transform 0.2s;
			}
			.cat-card:hover {
				border-color: var(--accent);
				box-shadow: 0 4px 24px var(--accent-glow);
				transform: translateY(-2px);
			}
			.cat-icon {
				width: 40px;
				height: 40px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 10px;
				background: var(--accent-glow);
				color: var(--accent);
			}
			.cat-card h3 {
				font-size: 1.1rem;
				font-weight: 600;
			}
			.cat-card p {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.cat-link {
				margin-top: auto;
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--accent);
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
			}
			.cat-link svg {
				transition: transform 0.15s;
			}
			.cat-card:hover .cat-link svg {
				transform: translateX(2px);
			}

			/* ── Footer ── */
			footer {
				margin-top: auto;
				padding: 2rem 1.5rem;
				text-align: center;
				font-size: 0.8rem;
				color: var(--text-muted);
				border-top: 1px solid var(--border);
			}
			footer a {
				color: var(--accent);
			}
			footer a:hover {
				text-decoration: underline;
			}

			/* ── Logo theme switching ── */
			.logo-for-dark {
				display: block;
			}
			.logo-for-light {
				display: none;
			}
			[data-theme='light'] .logo-for-dark {
				display: none;
			}
			[data-theme='light'] .logo-for-light {
				display: block;
			}

			/* ── Apps ── */
			.apps {
				max-width: 1100px;
				width: 100%;
				margin: 0 auto;
				padding: 1rem 1.5rem 3.5rem;
			}
			.section-head {
				text-align: center;
				margin-bottom: 2rem;
			}
			.eyebrow {
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.5rem;
			}
			.section-head h2 {
				font-size: clamp(1.6rem, 3.5vw, 2.25rem);
				font-weight: 700;
				letter-spacing: -0.02em;
			}
			.section-sub {
				margin: 0.75rem auto 0;
				max-width: 38rem;
				color: var(--text-muted);
				line-height: 1.6;
			}
			.app-featured {
				display: grid;
				grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
				gap: 2rem;
				align-items: center;
				background: linear-gradient(135deg, var(--accent-glow), transparent 60%), var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 2rem;
				margin-bottom: 1.25rem;
				transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
			}
			.app-featured:hover,
			.app-tile:hover {
				border-color: var(--accent);
				box-shadow: 0 4px 24px var(--accent-glow);
				transform: translateY(-2px);
			}
			.app-featured-text {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.app-featured-text > p {
				color: var(--text-muted);
				line-height: 1.6;
			}
			.app-featured h3 {
				font-size: 1.6rem;
				font-weight: 700;
			}
			.app-featured-shot img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 10px;
				border: 1px solid var(--border);
				box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
			}
			.app-title-row {
				display: flex;
				align-items: center;
				gap: 0.85rem;
			}
			.app-title-row img {
				border-radius: 12px;
				flex-shrink: 0;
			}
			.app-tagline {
				font-size: 0.9rem;
				color: var(--accent);
				font-weight: 600;
				margin-top: 0.15rem;
			}
			.app-tags {
				list-style: none;
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.app-tags li {
				font-size: 0.75rem;
				font-weight: 600;
				padding: 0.2rem 0.6rem;
				border-radius: 999px;
				border: 1px solid var(--border);
				color: var(--text-muted);
			}
			.app-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1.25rem;
			}
			.app-tile {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 1.35rem;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
			}
			.app-tile h3 {
				font-size: 1.02rem;
				font-weight: 650;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.4rem;
			}
			.app-tile > p {
				font-size: 0.88rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.app-badge {
				font-size: 0.65rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				padding: 0.1rem 0.45rem;
				border-radius: 999px;
				background: rgba(245, 158, 11, 0.15);
				color: #d97706;
			}
			.apps-more {
				text-align: center;
				margin-top: 1.5rem;
				font-size: 0.95rem;
			}
			.apps-more a {
				color: var(--accent);
				font-weight: 600;
			}
			.apps-more a:hover {
				text-decoration: underline;
			}

			/* ── Responsive ── */
			@media (max-width: 900px) {
				.app-featured {
					grid-template-columns: 1fr;
				}
				.app-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.categories {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 640px) {
				.stats {
					grid-template-columns: repeat(2, 1fr);
				}
				.categories {
					grid-template-columns: 1fr;
				}
				.app-grid {
					grid-template-columns: 1fr;
				}
				.app-featured {
					padding: 1.35rem;
				}
				.hero {
					padding: 3rem 1.25rem 3rem;
					min-height: auto;
				}
			}
		</style>
	</head>

	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<!-- Nav — no logo here since the hero has it -->
		<nav>
			<div class="nav-right">
				<a href="/apps/" class="nav-link">Apps</a>
					<a href="/project-list/" class="nav-link">Projects</a>
				<a
					href="https://www.youtube.com/@BRUHAutomation1"
					class="nav-link"
					target="_blank"
					rel="noopener">YouTube</a
				>
				<div class="theme-toggle" id="theme-toggle">
					<button
						data-value="light"
						aria-label="Light theme"
						title="Light"
					>
						<svg aria-hidden="true" focusable="false"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<circle cx="12" cy="12" r="5"></circle>
							<line x1="12" y1="1" x2="12" y2="3"></line>
							<line x1="12" y1="21" x2="12" y2="23"></line>
							<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
							></line>
							<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
							></line>
							<line x1="1" y1="12" x2="3" y2="12"></line>
							<line x1="21" y1="12" x2="23" y2="12"></line>
							<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
							></line>
							<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
							></line>
						</svg>
					</button>
					<button
						data-value="auto"
						aria-label="System theme"
						title="Auto"
					>
						<span class="auto-label">A</span>
					</button>
					<button
						data-value="dark"
						aria-label="Dark theme"
						title="Dark"
					>
						<svg aria-hidden="true" focusable="false"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path
								d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
							></path>
						</svg>
					</button>
					<div class="toggle-pill" id="toggle-pill"></div>
				</div>
			</div>
		</nav>

		<main id="main" tabindex="-1">
			<!-- Hero -->
			<section class="hero">
				<!-- Center content -->
				<img
					class="hero-logo logo-for-dark"
					src={logoLight.src}
